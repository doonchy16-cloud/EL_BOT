#el-admin-entry{cursor:inherit!important;display:inline!important;outline:none!important;background:none!important;box-shadow:none!important;border:0!important;color:inherit!important;text-decoration:none!important;user-select:none!important}
#el-admin-entry:hover,#el-admin-entry:active,#el-admin-entry:focus{cursor:inherit!important;background:none!important;box-shadow:none!important;outline:none!important;color:inherit!important;transform:none!important}
.el-admin-backdrop{position:fixed;inset:0;z-index:2147483000;background:#02050bd9;backdrop-filter:blur(10px);display:grid;place-items:center;padding:20px;font-family:Segoe UI,Arial,sans-serif;color:#f6f8ff}
.el-admin-auth{width:min(480px,95vw);background:#0c1322;border:1px solid #33476e;border-radius:22px;box-shadow:0 28px 90px #000c;padding:24px;display:grid;gap:15px}
.el-admin-auth h2{margin:0;font-size:25px}.el-admin-auth p{margin:0;color:#aebbd1;line-height:1.45}.el-admin-auth input{width:100%;border:1px solid #34486d;background:#070b13;color:#fff;border-radius:12px;padding:12px 14px;font-size:16px;outline:none}.el-admin-auth input:focus{border-color:#6f91d3;box-shadow:0 0 0 3px #6f91d322}.el-admin-auth-actions{display:flex;justify-content:flex-end;gap:10px}.el-admin-btn{border:1px solid #3a517c;background:#172844;color:#fff;border-radius:12px;padding:10px 14px;font-weight:700;cursor:pointer}.el-admin-btn:hover{background:#21385f}.el-admin-btn.danger{border-color:#8b3947;background:#3a1720}.el-admin-error{min-height:1.3em;color:#ff8995;font-size:14px}
.el-admin-console{position:fixed;inset:12px;z-index:2147483001;background:#070b13;border:1px solid #33476e;border-radius:24px;box-shadow:0 28px 100px #000e;display:grid;grid-template-rows:auto auto minmax(0,1fr);overflow:hidden;font-family:Segoe UI,Arial,sans-serif;color:#f6f8ff}
.el-admin-top{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 20px;border-bottom:1px solid #273753;background:#0d1525}.el-admin-title{font-size:22px;font-weight:850;letter-spacing:.3px}.el-admin-sub{color:#96a6c0;font-size:13px}.el-admin-nav{display:flex;gap:10px;padding:12px 18px;border-bottom:1px solid #273753;background:#0a101d}.el-admin-nav button{border:1px solid #34486d;background:#111d32;color:#fff;border-radius:12px;padding:10px 15px;font-size:15px;font-weight:750;cursor:pointer}.el-admin-nav button.on{border-color:#61e294;background:#15342d;box-shadow:0 0 18px #61e29422}.el-admin-page{display:none;overflow:auto;padding:18px}.el-admin-page.on{display:block}.el-admin-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}.el-admin-card{background:#0d1524;border:1px solid #263752;border-radius:16px;padding:14px;min-height:110px}.el-admin-card.wide{grid-column:1/-1}.el-admin-card h3{margin:0 0 10px;font-size:15px;color:#b8c7dd}.el-admin-kv{display:grid;grid-template-columns:minmax(130px,.8fr) minmax(0,1.2fr);gap:7px 12px;font-size:14px}.el-admin-kv b{color:#92a4c0;font-weight:650}.el-admin-kv span{overflow-wrap:anywhere}.el-admin-good{color:#70eba2}.el-admin-warn{color:#ffd166}.el-admin-bad{color:#ff7d8c}.el-admin-muted{color:#8b99b0}.el-admin-mono{font-family:Consolas,ui-monospace,monospace;font-size:12px}.el-admin-pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:320px;overflow:auto;background:#060a11;border:1px solid #22304a;border-radius:12px;padding:10px;margin:0;font:12px/1.45 Consolas,monospace;color:#c9d6e8}.el-admin-generation{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;padding:8px 0;border-top:1px solid #1f2b40}.el-admin-generation:first-child{border-top:0}.el-admin-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.el-admin-pulse{width:9px;height:9px;border-radius:50%;background:#61e294;box-shadow:0 0 12px #61e294}.el-admin-close{border:0;background:transparent;color:#b9c5d8;font-size:22px;cursor:pointer;padding:5px 8px;border-radius:9px}.el-admin-close:hover{background:#25324a;color:#fff}
@media(max-width:700px){.el-admin-console{inset:4px;border-radius:16px}.el-admin-top{padding:12px}.el-admin-nav{padding:8px}.el-admin-nav button{flex:1;padding:9px 6px}.el-admin-page{padding:10px}.el-admin-grid{grid-template-columns:1fr}.el-admin-kv{grid-template-columns:1fr}}
