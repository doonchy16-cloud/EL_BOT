<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data: blob:;">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🤖😀</title>
<style>
:root{color-scheme:dark;font-family:Segoe UI,Arial,sans-serif}
*{box-sizing:border-box;min-width:0}
html,body{width:100%;height:100%;margin:0}
body{min-height:100vh;background:radial-gradient(circle at 15% 10%,#12203a 0,#080b12 36%,#05070c 100%);color:#f6f8ff;display:flex;align-items:stretch}
main{width:100%;min-height:100vh;padding:clamp(12px,1.6vw,24px);display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:clamp(10px,1.2vw,18px)}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;background:#0d1320cc;border:1px solid #26334f;border-radius:20px;padding:16px 20px;box-shadow:0 12px 40px #0008}
.brand{font-size:30px;letter-spacing:8px}.lights{display:flex;gap:8px}.dot{width:12px;height:12px;border-radius:50%;background:#38435c}.dot.on{background:#61e294;box-shadow:0 0 14px #61e294}
section{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(10px,1.2vw,18px);min-height:0;width:100%}
.panel{background:#0d1320e8;border:1px solid #26334f;border-radius:20px;padding:14px;display:grid;grid-template-rows:auto auto minmax(0,1fr);gap:10px;box-shadow:0 12px 40px #0008;min-height:0;min-width:0;overflow:hidden}
.toolbar,.modes{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
button{border:1px solid #34486d;background:#16233a;color:#fff;border-radius:14px;padding:10px 15px;font-size:21px;cursor:pointer;transition:.16s transform,.16s background,.16s box-shadow,.16s border-color}
button:hover{transform:translateY(-1px);background:#1d3154;box-shadow:0 0 22px #3a6aa044}
button:active{transform:translateY(1px)}
button.mode{font-size:19px;opacity:.72}button.mode.on{opacity:1;border-color:#61e294;background:#17352e;box-shadow:0 0 18px #61e29433}
textarea,pre{width:100%;height:100%;min-height:0;margin:0;border:1px solid #283653;background:#070b13;color:#f7f9ff;border-radius:15px;padding:15px;font:clamp(17px,1.25vw,21px)/1.5 "Segoe UI Emoji","Noto Color Emoji","Segoe UI",sans-serif;outline:none;resize:none;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;word-break:normal}
textarea:focus{border-color:#5f80bd;box-shadow:0 0 0 3px #5f80bd22}
.inputStack{display:grid;grid-template-rows:minmax(0,1fr) auto;gap:10px;min-height:0;min-width:0}
.preview{display:none;position:relative;border:1px solid #34486d;border-radius:15px;background:#070b13;padding:10px;min-height:110px;max-height:250px;overflow:hidden}
.preview.on{display:block}.preview img{display:block;max-width:100%;max-height:225px;margin:auto;border-radius:10px;object-fit:contain}.previewBadge{position:absolute;top:12px;left:12px;background:#0d1320dd;border:1px solid #34486d;border-radius:10px;padding:5px 8px;font-size:18px}
.outputStack{display:grid;grid-template-rows:minmax(0,1fr) auto;gap:10px;min-height:0;min-width:0}
.altToggle{display:none}.altToggle.on{display:inline-flex}
.alternatives{display:none;gap:8px;max-height:38vh;overflow:auto;padding:2px}.alternatives.on{display:grid}
.alt{width:100%;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:start;gap:10px;text-align:left;padding:10px 12px;font-size:17px;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere}
.altRank{white-space:nowrap}.altValue{min-width:0}.altChosen{white-space:nowrap}.alt.current{border-color:#61e294;background:#17352e}
.drop{outline:3px solid #5f80bd88;box-shadow:0 0 30px #5f80bd44}
footer{background:#0d1320cc;border:1px solid #26334f;border-radius:18px;padding:12px 18px;display:flex;justify-content:space-between;align-items:center;font-size:20px;box-shadow:0 12px 40px #0008}
@media(max-width:820px){section{grid-template-columns:1fr;overflow:auto}.panel{min-height:380px}main{height:auto}.alternatives{max-height:300px}}
</style>
</head>
<body>
<main>
<header>
  <div class="brand">🤖 😀 ↔️ ⚡ 🖥️ 📸</div>
  <div class="lights"><span class="dot on"></span><span class="dot"></span><span class="dot"></span></div>
</header>
<section>
  <div class="panel" id="leftPanel">
    <div class="modes">
      <button class="mode" id="mode1">1️⃣ 😀➡️🔤</button>
      <button class="mode on" id="mode2">2️⃣ 🔤➡️😀</button>
    </div>
    <div class="toolbar">
      <button id="run">▶️</button>
      <button id="image">📸</button>
      <button id="clear">🧹</button>
      <button id="diag">🧪</button>
      <button id="ollama">🦙🔍</button>
      <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden>
    </div>
    <div class="inputStack">
      <textarea id="input" spellcheck="false"></textarea>
      <div class="preview" id="preview"><span class="previewBadge">📸</span><img id="previewImage" alt=""></div>
    </div>
  </div>
  <div class="panel">
    <div class="modes"><span id="direction">2️⃣ 🔤➡️😀</span></div>
    <div class="toolbar"><span>📤 🤖</span><button id="altToggle" class="altToggle">🔀0</button></div>
    <div class="outputStack">
      <pre id="output">⚪</pre>
      <div id="alternatives" class="alternatives"></div>
    </div>
  </div>
</section>
<footer><span id="state">⚪</span><span id="footerMode">2️⃣ 🔤➡️😀</span><span>🔒📚501</span></footer>
</main>
<script>
const $ = (id) => document.getElementById(id);
const input = $('input');
const output = $('output');
const state = $('state');
const file = $('file');
const preview = $('preview');
const previewImage = $('previewImage');
const leftPanel = $('leftPanel');
const alternatives = $('alternatives');
const altToggle = $('altToggle');
const lights = [...document.querySelectorAll('.dot')];
let imageDataUrl = '';
let mode = 2;
let lastSource = '';
let rankedCandidates = [];
let chosenValue = '';

const ranks = ['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣'];

function status(symbol){
  state.textContent = symbol;
  lights.forEach((node,index)=>node.classList.toggle('on', index === (symbol === '✅' ? 2 : symbol === '🔵' ? 1 : 0)));
}

function clearAlternatives(){
  rankedCandidates = [];
  chosenValue = '';
  alternatives.replaceChildren();
  alternatives.classList.remove('on');
  altToggle.classList.remove('on');
  altToggle.textContent = '🔀0';
}

function setMode(next){
  mode = next === 1 ? 1 : 2;
  $('mode1').classList.toggle('on', mode === 1);
  $('mode2').classList.toggle('on', mode === 2);
  const marker = mode === 1 ? '1️⃣ 😀➡️🔤' : '2️⃣ 🔤➡️😀';
  $('direction').textContent = marker;
  $('footerMode').textContent = marker;
  output.textContent = '⚪';
  clearAlternatives();
  status('⚪');
  input.focus();
}

function showImage(dataUrl){
  imageDataUrl = dataUrl;
  previewImage.src = dataUrl;
  preview.classList.add('on');
  input.value = '📸';
  clearAlternatives();
  status('🔵');
}

function compressImage(dataUrl){
  return new Promise((resolve)=>{
    const image = new Image();
    image.onload = ()=>{
      const maxSide = 1024;
      const scale = Math.min(1, maxSide / Math.max(image.naturalWidth || 1, image.naturalHeight || 1));
      const width = Math.max(1, Math.round(image.naturalWidth * scale));
      const height = Math.max(1, Math.round(image.naturalHeight * scale));
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext('2d', {alpha:false});
      context.fillStyle = '#ffffff';
      context.fillRect(0,0,width,height);
      context.drawImage(image,0,0,width,height);
      resolve(canvas.toDataURL('image/jpeg',0.86));
    };
    image.onerror = ()=>resolve(dataUrl);
    image.src = dataUrl;
  });
}

function readImage(blob){
  if (!blob || !String(blob.type || '').startsWith('image/')) return;
  const reader = new FileReader();
  reader.onload = async ()=>showImage(await compressImage(String(reader.result || '')));
  reader.onerror = () => {output.textContent='❌📸';status('❌');};
  reader.readAsDataURL(blob);
}

function applyResult(result, fallback='⚪'){
  clearAlternatives();
  const value = String(result || fallback);
  output.textContent = value;
  status(value.startsWith('❌') ? '❌' : value.startsWith('🟡') ? '🟡' : '✅');
}

function renderAlternatives(){
  alternatives.replaceChildren();
  rankedCandidates.forEach((item,index)=>{
    const value = String(item && item.value || '');
    if (!value) return;
    const button = document.createElement('button');
    button.className = 'alt' + (value === chosenValue ? ' current' : '');
    const rank = document.createElement('span');
    rank.className = 'altRank';
    rank.textContent = ranks[index] || String(index + 1);
    const text = document.createElement('span');
    text.className = 'altValue';
    text.textContent = value;
    const chosen = document.createElement('span');
    chosen.className = 'altChosen';
    chosen.textContent = value === chosenValue ? '🏆' : '';
    button.append(rank,text,chosen);
    button.addEventListener('click',()=>chooseAlternative(value));
    alternatives.appendChild(button);
  });
}

async function chooseAlternative(value){
  if (!value) return;
  chosenValue = value;
  output.textContent = value;
  renderAlternatives();
  status('✅');
  if (window['😀'] && window['😀']['🏆'] && lastSource) {
    try { await window['😀']['🏆'](mode,lastSource,value); }
    catch (_) {}
  }
}

function applyRanked(result, source){
  clearAlternatives();
  if (!result || typeof result !== 'object') { applyResult(result,'🟡❓'); return; }
  const winner = String(result.winner || '🟡❓');
  lastSource = source;
  chosenValue = winner;
  rankedCandidates = Array.isArray(result.candidates) ? result.candidates.filter(item=>item && typeof item.value === 'string' && item.value) : [];
  if (!rankedCandidates.some(item=>item.value === winner)) rankedCandidates.unshift({value:winner});
  output.textContent = winner;
  status(winner.startsWith('❌') ? '❌' : winner.startsWith('🟡') ? '🟡' : '✅');
  if (rankedCandidates.length > 1) {
    altToggle.textContent = '🔀' + rankedCandidates.length;
    altToggle.classList.add('on');
    renderAlternatives();
  }
}

async function runBot(source){
  if (!window['😀'] || !window['😀']['▶️']) { output.textContent='❌🔌';status('❌');return; }
  clearAlternatives();status('🔵');output.textContent='⏳';
  try { applyResult(await window['😀']['▶️'](source)); }
  catch (_) { output.textContent='❌🧯';status('❌'); }
}

async function runTranslation(){
  if (!window['😀'] || !window['😀']['↔️']) { output.textContent='❌↔️🔌';status('❌');return; }
  const source = input.value.trim();
  if (!source) { output.textContent='🟡❓';status('🟡');return; }
  clearAlternatives();status('🔵');output.textContent=mode===1?'😀➡️🔤⏳':'🔤➡️😀⏳';
  try { applyRanked(await window['😀']['↔️'](mode,source),source); }
  catch (_) { output.textContent='❌↔️🧯';status('❌'); }
}

async function runImage(){
  if (!imageDataUrl) { file.click(); return; }
  if (!window['😀'] || !window['😀']['📸']) { output.textContent='❌📸🔌';status('❌');return; }
  clearAlternatives();status('🔵');output.textContent=mode===1?'📸➡️🔤⏳':'📸➡️😀⏳';
  try { applyResult(await window['😀']['📸'](mode,imageDataUrl),'🟡📸❓'); }
  catch (_) { output.textContent='❌📸🧯';status('❌'); }
}

function clearAll(){
  input.value='';output.textContent='⚪';imageDataUrl='';lastSource='';
  previewImage.removeAttribute('src');preview.classList.remove('on');file.value='';clearAlternatives();status('⚪');input.focus();
}

function runCurrent(){ imageDataUrl ? runImage() : runTranslation(); }

$('mode1').addEventListener('click',()=>setMode(1));
$('mode2').addEventListener('click',()=>setMode(2));
$('run').addEventListener('click',runCurrent);
$('image').addEventListener('click',()=>file.click());
$('clear').addEventListener('click',clearAll);
$('diag').addEventListener('click',()=>runBot('🧪'));
$('ollama').addEventListener('click',()=>runBot('🦙🔍'));
altToggle.addEventListener('click',()=>alternatives.classList.toggle('on'));
file.addEventListener('change',()=>readImage(file.files && file.files[0]));
input.addEventListener('input',()=>{
  clearAlternatives();
  if(imageDataUrl && input.value !== '📸'){imageDataUrl='';previewImage.removeAttribute('src');preview.classList.remove('on');file.value='';}
});
input.addEventListener('keydown',(event)=>{
  if(event.key==='Enter' && !event.shiftKey && !event.isComposing){event.preventDefault();runCurrent();}
});

['dragenter','dragover'].forEach(name=>leftPanel.addEventListener(name,(event)=>{event.preventDefault();leftPanel.classList.add('drop');}));
['dragleave','drop'].forEach(name=>leftPanel.addEventListener(name,(event)=>{event.preventDefault();leftPanel.classList.remove('drop');}));
leftPanel.addEventListener('drop',(event)=>{const files=event.dataTransfer&&event.dataTransfer.files;if(files&&files[0])readImage(files[0]);});
window.addEventListener('paste',(event)=>{
  const items=[...(event.clipboardData?event.clipboardData.items:[])];
  const item=items.find(entry=>String(entry.type||'').startsWith('image/'));
  if(item){event.preventDefault();readImage(item.getAsFile());}
});

setMode(2);
</script>
</body>
</html>
