</style>
</head>
<body>
<main>
<header><div class="brand">🤖 😀 ↔️ ⚡ 🖥️ 📸</div><div class="lights"><span class="dot on"></span><span class="dot"></span><span class="dot"></span></div></header>
<section>
<div class="panel" id="leftPanel">
<div class="controlBar"><button class="mode" id="mode1">1️⃣ 😀➡️🔤</button><button class="mode on" id="mode2">2️⃣ 🔤➡️😀</button><button id="run">▶️</button><button id="image">📸</button><button id="clear">🧹</button><button id="diag">🧪</button><button id="ollama">🦙🔍</button><input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden></div>
