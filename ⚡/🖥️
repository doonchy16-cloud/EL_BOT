</div>
</section>
<footer><span id="state">⚪</span><span id="footerMode">2️⃣ 🔤➡️😀</span><span>🔒📚501</span></footer>
</main>
<script>
'use strict';
const $=(id)=>document.getElementById(id);const input=$('input'),output=$('output'),state=$('state'),file=$('file'),preview=$('preview'),previewImage=$('previewImage'),leftPanel=$('leftPanel');const alternatives=$('alternatives'),altToggle=$('altToggle'),quality=$('quality'),processing=$('processing'),hourglass=$('hourglass'),stage=$('stage'),stageMeta=$('stageMeta');const lights=[...document.querySelectorAll('.dot')];const ranks=['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣'];let imageDataUrl='',mode=2,lastSource='',rankedCandidates=[],chosenValue='';let processingActive=false,processingStarted=0,processingTimer=0,progressText='';
function status(symbol){state.textContent=symbol;lights.forEach((node,index)=>node.classList.toggle('on',index===(symbol==='✅'?2:symbol==='🔵'?1:0)));}
function semanticTone(text){const value=String(text||'').toLowerCase();if(/^(❌|🔴)$|fail|error|wrong|rejected|blocked|critical|crash/.test(value))return 'tone-bad';if(/^(⚠️|🟡)$|warning|risk|hold|pending|timeout|slow|lag/.test(value))return 'tone-warn';if(/^(✅|🟢)$|pass|verified|complete|success|healthy|ready/.test(value))return 'tone-ok';if(/^(🔒|🔐|🛂|🔑)$|locked|security|authentication|credential|canonical/.test(value))return 'tone-lock';if(/^(🏆|🥇|⭐)$|winner|best/.test(value))return 'tone-win';if(/^(🚀|🔥|⚡)$|launch|deployment|release|fast/.test(value))return 'tone-cyan';if(/^(🧪|🧠|🤖|🦙)$|diagnostics|testing|reasoning|ollama/.test(value))return 'tone-ai';if(/^(📸|👁️|🖼️)$|screenshot|captured|camera|image|visible/.test(value))return 'tone-cyan';if(/^(🖥️|💻|📊)$|interface|dashboard|computer/.test(value))return 'tone-info';return '';}
function renderRich(target,value){target.replaceChildren();const chunks=String(value??'').split(/(\s+|[.,;:!?]+)/g);for(const chunk of chunks){if(!chunk)continue;if(/^\s+$/.test(chunk)||/^[.,;:!?]+$/.test(chunk)){target.appendChild(document.createTextNode(chunk));continue;}const span=document.createElement('span');span.className='richSegment '+semanticTone(chunk);span.textContent=chunk;target.appendChild(span);}}
function setOutput(value='⚪'){renderRich(output,String(value??'⚪'));}function clearAlternatives(){rankedCandidates=[];chosenValue='';alternatives.replaceChildren();alternatives.classList.remove('on');altToggle.classList.remove('on');altToggle.textContent='🔀0';}
function setQuality(metrics={}){const coverage=Number(metrics.coverage),roundtrip=Number(metrics.roundtrip),count=Number(metrics.candidates||0),unknownDensity=Number(metrics.unknown_density||0),unknownCount=Number(metrics.unknown_count||0),declared=String(metrics.quality_status||'');if(!Number.isFinite(coverage)||!Number.isFinite(roundtrip)){quality.textContent='⚪🛡️🔤';return;}let marker=(count<=0||coverage<.55||roundtrip<.45||unknownDensity>=.45)?'❌':(coverage<.82||roundtrip<.72||unknownDensity>=.12||unknownCount>0)?'🟡':'✅';if(declared==='fail')marker='❌';else if(declared==='hold'&&marker==='✅')marker='🟡';else if(declared==='pass'&&marker!=='❌'&&unknownCount===0)marker='✅';quality.textContent=marker+'🛡️🔤 '+Math.round(coverage*100)+'/'+Math.round(roundtrip*100)+(unknownCount?'  ❓'+unknownCount:'');quality.title='Meaning coverage / round-trip fidelity / unresolved content';}
function refreshProcessing(){if(!processingActive)return;const elapsed=((performance.now()-processingStarted)/1000).toFixed((performance.now()-processingStarted)<10000?1:0);stageMeta.textContent=(progressText?progressText+'  •  ':'')+'⏱️ '+elapsed+'s';}
function beginProcessing(label,detail=''){if(processingTimer)clearInterval(processingTimer);processingActive=true;processingStarted=performance.now();progressText=String(detail||'');stage.textContent=String(label||'🔵');processing.classList.add('on');hourglass.classList.add('flip');refreshProcessing();processingTimer=setInterval(refreshProcessing,100);}
function updateStage(payload){if(!payload||typeof payload!=='object')return;if(!processingActive)beginProcessing(payload.label||'🔵');stage.textContent=String(payload.label||'🔵');const index=Number(payload.index||0),total=Number(payload.total||0);progressText=index>0&&total>0?index+' / '+total:'';refreshProcessing();}
function finishProcessing(){if(processingTimer)clearInterval(processingTimer);processingTimer=0;processingActive=false;processingStarted=0;progressText='';hourglass.classList.remove('flip');processing.classList.remove('on');stage.textContent='⚪';stageMeta.textContent='';}
function setMode(next){mode=next===1?1:2;$('mode1').classList.toggle('on',mode===1);$('mode2').classList.toggle('on',mode===2);const marker=mode===1?'1️⃣ 😀➡️🔤':'2️⃣ 🔤➡️😀';$('direction').textContent=marker;$('footerMode').textContent=marker;setOutput('⚪');setQuality();clearAlternatives();status('⚪');finishProcessing();input.focus();}
function showImage(dataUrl){imageDataUrl=dataUrl;previewImage.src=dataUrl;preview.classList.add('on');input.value='📸';clearAlternatives();status('🔵');}
function compressImage(dataUrl){return new Promise((resolve)=>{const image=new Image();image.onload=()=>{const maxSide=1024,scale=Math.min(1,maxSide/Math.max(image.naturalWidth||1,image.naturalHeight||1)),width=Math.max(1,Math.round(image.naturalWidth*scale)),height=Math.max(1,Math.round(image.naturalHeight*scale)),canvas=document.createElement('canvas');canvas.width=width;canvas.height=height;const context=canvas.getContext('2d',{alpha:false});context.fillStyle='#fff';context.fillRect(0,0,width,height);context.drawImage(image,0,0,width,height);resolve(canvas.toDataURL('image/jpeg',.86));};image.onerror=()=>resolve(dataUrl);image.src=dataUrl;});}
function readImage(blob){if(!blob||!String(blob.type||'').startsWith('image/'))return;const reader=new FileReader();reader.onload=async()=>showImage(await compressImage(String(reader.result||'')));reader.onerror=()=>{setOutput('❌📸');status('❌');};reader.readAsDataURL(blob);}
function renderAlternatives(){alternatives.replaceChildren();rankedCandidates.forEach((item,index)=>{const value=String(item&&item.value||'');if(!value)return;const button=document.createElement('button');button.className='alt'+(value===chosenValue?' current':'');const rank=document.createElement('span');rank.textContent=ranks[index]||String(index+1);const wrap=document.createElement('span');wrap.className='altValue';const text=document.createElement('span');renderRich(text,value);wrap.appendChild(text);const score=Number(item.score),coverage=Number(item.coverage),roundtrip=Number(item.roundtrip);if(Number.isFinite(score)||Number.isFinite(coverage)||Number.isFinite(roundtrip)){const meta=document.createElement('span');meta.className='altMeta';const bits=[];if(Number.isFinite(score))bits.push('⚖️ '+score.toFixed(1));if(Number.isFinite(coverage))bits.push('🎯 '+Math.round(coverage*100)+'%');if(Number.isFinite(roundtrip))bits.push('🔁 '+Math.round(roundtrip*100)+'%');meta.textContent=bits.join('   ');if(Array.isArray(item.reasons))meta.title=item.reasons.join(' • ');wrap.appendChild(meta);}const chosen=document.createElement('span');chosen.className='altChosen';chosen.textContent=value===chosenValue?'🏆':'';button.append(rank,wrap,chosen);button.addEventListener('click',()=>chooseAlternative(value));alternatives.appendChild(button);});}
async function chooseAlternative(value){if(!value)return;chosenValue=value;setOutput(value);renderAlternatives();if(window['😀']&&window['😀']['🏆']&&lastSource){try{await window['😀']['🏆'](mode,lastSource,value);}catch(_){}}}
function applyRanked(result,source){clearAlternatives();if(!result||typeof result!=='object'){setOutput('🟡❓');status('🟡');setQuality();return;}const winner=String(result.winner||'🟡❓');lastSource=String(result.source_key||source||'');chosenValue=winner;rankedCandidates=Array.isArray(result.candidates)?result.candidates.filter(item=>item&&typeof item.value==='string'&&item.value):[];if(!rankedCandidates.some(item=>item.value===winner))rankedCandidates.unshift({value:winner});setOutput(winner);setQuality(result.metrics||{});status(winner.startsWith('❌')?'❌':winner.startsWith('🟡')?'🟡':'✅');if(rankedCandidates.length>1){altToggle.textContent='🔀'+rankedCandidates.length;altToggle.classList.add('on');renderAlternatives();}}
async function runTranslation(){if(!window['😀']||!window['😀']['↔️']){setOutput('❌↔️🔌');status('❌');return;}const source=input.value.trim();if(!source){setOutput('🟡❓');status('🟡');return;}clearAlternatives();status('🔵');beginProcessing(mode===1?'😀➡️🔤 Emoji → ABC Engine':'🔤➡️😀 ABC → Emoji Engine');try{applyRanked(await window['😀']['↔️'](mode,source),source);}catch(_){setOutput('❌↔️🧯');status('❌');}finally{finishProcessing();}}
async function runImage(){if(!imageDataUrl){file.click();return;}if(!window['😀']||!window['😀']['📸']){setOutput('❌📸🔌');status('❌');return;}clearAlternatives();status('🔵');beginProcessing('📸 Screenshot Vision');try{applyRanked(await window['😀']['📸'](mode,imageDataUrl),imageDataUrl);}catch(_){setOutput('❌📸🧯');status('❌');}finally{finishProcessing();}}
async function runBot(source,label){if(!window['😀']||!window['😀']['▶️']){setOutput('❌🔌');status('❌');return;}clearAlternatives();status('🔵');beginProcessing(label);try{const value=String(await window['😀']['▶️'](source));setOutput(value);status(value.startsWith('❌')?'❌':value.startsWith('🟡')?'🟡':'✅');}catch(_){setOutput('❌🧯');status('❌');}finally{finishProcessing();}}
function clearAll(){input.value='';setOutput('⚪');setQuality();imageDataUrl='';lastSource='';previewImage.removeAttribute('src');preview.classList.remove('on');file.value='';clearAlternatives();finishProcessing();status('⚪');input.focus();}function runCurrent(){imageDataUrl?runImage():runTranslation();}
$('mode1').addEventListener('click',()=>setMode(1));$('mode2').addEventListener('click',()=>setMode(2));$('run').addEventListener('click',runCurrent);$('image').addEventListener('click',()=>file.click());$('clear').addEventListener('click',clearAll);$('diag').addEventListener('click',()=>runBot('🧪','🧪 Diagnostics Engine'));$('ollama').addEventListener('click',()=>runBot('🦙🔍','🦙 Status Check'));altToggle.addEventListener('click',()=>alternatives.classList.toggle('on'));file.addEventListener('change',()=>readImage(file.files&&file.files[0]));
input.addEventListener('input',()=>{clearAlternatives();if(imageDataUrl&&input.value!=='📸'){imageDataUrl='';previewImage.removeAttribute('src');preview.classList.remove('on');file.value='';}});input.addEventListener('keydown',(event)=>{if(event.key==='Enter'&&!event.shiftKey&&!event.isComposing){event.preventDefault();runCurrent();}});['dragenter','dragover'].forEach(name=>leftPanel.addEventListener(name,(event)=>{event.preventDefault();leftPanel.classList.add('drop');}));['dragleave','drop'].forEach(name=>leftPanel.addEventListener(name,(event)=>{event.preventDefault();leftPanel.classList.remove('drop');}));leftPanel.addEventListener('drop',(event)=>{const files=event.dataTransfer&&event.dataTransfer.files;if(files&&files[0])readImage(files[0]);});window.addEventListener('paste',(event)=>{const items=[...(event.clipboardData?event.clipboardData.items:[])],item=items.find(entry=>String(entry.type||'').startsWith('image/'));if(item){event.preventDefault();readImage(item.getAsFile());}});if(window['😀']&&typeof window['😀']['⏳']==='function')window['😀']['⏳'](updateStage);setMode(2);
</script>
