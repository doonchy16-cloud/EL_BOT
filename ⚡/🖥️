<style>
:root{color-scheme:dark;font-family:Segoe UI,Arial,sans-serif}*{box-sizing:border-box;min-width:0}html,body{width:100%;height:100%;margin:0}body{min-height:100vh;background:radial-gradient(circle at 15% 10%,#12203a 0,#080b12 36%,#05070c 100%);color:#f6f8ff}main{width:100%;min-height:100vh;height:100vh;padding:clamp(12px,1.6vw,24px);display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:clamp(10px,1.2vw,18px)}header,footer,.panel{background:#0d1320e8;border:1px solid #26334f;box-shadow:0 12px 40px #0008}header{display:flex;align-items:center;justify-content:space-between;gap:16px;border-radius:20px;padding:15px 20px}.brand{font-size:30px;letter-spacing:8px}.lights{display:flex;gap:8px}.dot{width:12px;height:12px;border-radius:50%;background:#38435c}.dot.on{background:#61e294;box-shadow:0 0 14px #61e294}section{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(10px,1.2vw,18px);min-height:0;width:100%}.panel{border-radius:20px;padding:14px;display:flex;flex-direction:column;gap:10px;min-height:0;min-width:0;overflow:hidden}.controlBar{display:flex;align-items:center;gap:clamp(4px,.7vw,10px);width:100%;flex-wrap:nowrap;overflow:visible}.controlBar button{flex:0 1 auto;white-space:nowrap;font-size:clamp(15px,1.25vw,21px);padding:clamp(7px,.65vw,10px) clamp(8px,.9vw,15px)}button{border:1px solid #34486d;background:#16233a;color:#fff;border-radius:14px;cursor:pointer;transition:.16s transform,.16s background,.16s box-shadow,.16s border-color}button:hover{transform:translateY(-1px);background:#1d3154;box-shadow:0 0 22px #3a6aa044}button:active{transform:translateY(1px)}button.mode{opacity:.72}button.mode.on{opacity:1;border-color:#61e294;background:#17352e;box-shadow:0 0 18px #61e29433}.inputStack,.outputStack{flex:1 1 auto;min-height:0;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:10px}textarea,.outputViewport{width:100%;height:100%;min-height:0;border:1px solid #283653;background:#070b13;border-radius:15px}textarea{margin:0;color:#f7f9