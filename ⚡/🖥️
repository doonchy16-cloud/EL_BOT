<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data: blob:;">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🤖😀</title>
<style>
:root{color-scheme:dark;font-family:Segoe UI,Arial,sans-serif}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:radial-gradient(circle at 15% 10%,#12203a 0,#080b12 36%,#05070c 100%);color:#f6f8ff;display:flex;align-items:stretch;justify-content:center}
main{width:min(1160px,100%);padding:28px;display:grid;grid-template-rows:auto 1fr auto;gap:18px}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;background:#0d1320cc;border:1px solid #26334f;border-radius:20px;padding:18px 20px;box-shadow:0 12px 40px #0008}
.brand{font-size:30px;letter-spacing:8px}.lights{display:flex;gap:8px}.dot{width:12px;height:12px;border-radius:50%;background:#38435c}.dot.on{background:#61e294;box-shadow:0 0 14px #61e294}
section{display:grid;grid-template-columns:1fr 1fr;gap:18px;min-height:0}
.panel{background:#0d1320e8;border:1px solid #26334f;border-radius:20px;padding:16px;display:grid;grid-template-rows:auto auto 1fr;gap:12px;box-shadow:0 12px 40px #0008;min-height:450px}
.toolbar,.modes{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
button{border:1px solid #34486d;background:#16233a;color:#fff;border-radius:14px;padding:11px 17px;font-size:22px;cursor:pointer;transition:.16s transform,.16s background,.16s box-shadow,.16s border-color}
button:hover{transform:translateY(-1px);background:#1d3154;box-shadow:0 0 22px #3a6aa044}
button:active{transform:translateY(1px)}
button.mode{font-size:19px;opacity:.72}button.mode.on{opacity:1;border-color:#61e294;background:#17352e;box-shadow:0 0 18px #61e29433}
textarea,pre{width:100%;height:100%;min-height:330px;margin:0;border:1px solid #283653;background:#070b13;color:#f7f9ff;border-radius:15px;padding:16px;font:21px/1.55 "Segoe UI Emoji","Noto Color Emoji","Segoe UI",sans-serif;outline:none;resize:none;overflow:auto;white-space:pre-wrap;word-break:break-word}
textarea:focus{border-color:#5f80bd;box-shadow:0 0 0 3px #5f80bd22}
.inputStack{display:grid;grid-template-rows:1fr auto;gap:10px;min-height:0}
.preview{display:none;position:relative;border:1px solid #34486d;border-radius:15px;background:#070b13;padding:10px;min-height:120px;max-height:270px;overflow:hidden}
.preview.on{display:block}.preview img{display:block;max-width:100%;max-height:245px;margin:auto;border-radius:10px;object-fit:contain}.previewBadge{position:absolute;top:12px;left:12px;background:#0d1320dd;border:1px solid #34486d;border-radius:10px;padding:5px 8px;font-size:18px}
.drop{outline:3px solid #5f80bd88;box-shadow:0 0 30px #5f80bd44}
footer{background:#0d1320cc;border:1px solid #26334f;border-radius:18px;padding:13px 18px;display:flex;justify-content:space-between;align-items:center;font-size:20px;box-shadow:0 12px 40px #0008}
@media(max-width:820px){section{grid-template-columns:1fr}.panel{min-height:340px}textarea,pre{min-height:240px}}
</style>
</head>
<body>
<main>
<header>
  <div class="brand">🤖 😀 ↔️ ⚡ 🖥️ 📸</div>
  <div class="lights"><span class="dot on"></span><span class="dot"></span><span class="dot"></span></div>
</header>
<section>
  <div class="panel" id="leftPanel">
    <div class="modes">
      <button class="mode" id="mode1">1️⃣ 😀➡️🔤</button>
      <button class="mode on" id="mode2">2️⃣ 🔤➡️😀</button>
    </div>
    <div class="toolbar">
      <button id="run">▶️</button>
      <button id="image">📸</button>
      <button id="clear">🧹</button>
      <button id="diag">🧪</button>
      <button id="ollama">🦙🔍</button>
      <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden>
    </div>
    <div class="inputStack">
      <textarea id="input" spellcheck="false"></textarea>
      <div class="preview" id="preview"><span class="previewBadge">📸</span><img id="previewImage" alt=""></div>
    </div>
  </div>
  <div class="panel">
    <div class="modes"><span id="direction">2️⃣ 🔤➡️😀</span></div>
    <div class="toolbar"><span>📤 🤖</span></div>
    <pre id="output">⚪</pre>
  </div>
</section>
<footer><span id="state">⚪</span><span id="footerMode">2️⃣ 🔤➡️😀</span><span>🔒📚501</span></footer>
</main>
<script>
const $ = (id) => document.getElementById(id);
const input = $('input');
const output = $('output');
const state = $('state');
const file = $('file');
const preview = $('preview');
const previewImage = $('previewImage');
const leftPanel = $('leftPanel');
const lights = [...document.querySelectorAll('.dot')];
let imageDataUrl = '';
let mode = 2;

function status(symbol){
  state.textContent = symbol;
  lights.forEach((node,index)=>node.classList.toggle('on', index === (symbol === '✅' ? 2 : symbol === '🔵' ? 1 : 0)));
}

function setMode(next){
  mode = next === 1 ? 1 : 2;
  $('mode1').classList.toggle('on', mode === 1);
  $('mode2').classList.toggle('on', mode === 2);
  const marker = mode === 1 ? '1️⃣ 😀➡️🔤' : '2️⃣ 🔤➡️😀';
  $('direction').textContent = marker;
  $('footerMode').textContent = marker;
  output.textContent = '⚪';
  status('⚪');
  input.focus();
}

function showImage(dataUrl){
  imageDataUrl = dataUrl;
  previewImage.src = dataUrl;
  preview.classList.add('on');
  input.value = '📸';
  status('🔵');
}

function compressImage(dataUrl){
  return new Promise((resolve)=>{
    const image = new Image();
    image.onload = ()=>{
      const maxSide = 1024;
      const scale = Math.min(1, maxSide / Math.max(image.naturalWidth || 1, image.naturalHeight || 1));
      const width = Math.max(1, Math.round(image.naturalWidth * scale));
      const height = Math.max(1, Math.round(image.naturalHeight * scale));
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext('2d', {alpha:false});
      context.fillStyle = '#ffffff';
      context.fillRect(0,0,width,height);
      context.drawImage(image,0,0,width,height);
      resolve(canvas.toDataURL('image/jpeg',0.86));
    };
    image.onerror = ()=>resolve(dataUrl);
    image.src = dataUrl;
  });
}

function readImage(blob){
  if (!blob || !String(blob.type || '').startsWith('image/')) return;
  const reader = new FileReader();
  reader.onload = async ()=>{
    const raw = String(reader.result || '');
    showImage(await compressImage(raw));
  };
  reader.onerror = () => {output.textContent='❌📸';status('❌');};
  reader.readAsDataURL(blob);
}

function applyResult(result, fallback='⚪'){
  const value = String(result || fallback);
  output.textContent = value;
  status(value.startsWith('❌') ? '❌' : value.startsWith('🟡') ? '🟡' : '✅');
}

async function runBot(source){
  if (!window['😀'] || !window['😀']['▶️']) {
    output.textContent = '❌🔌';
    status('❌');
    return;
  }
  status('🔵');
  output.textContent = '⏳';
  try { applyResult(await window['😀']['▶️'](source)); }
  catch (_) { output.textContent='❌🧯';status('❌'); }
}

async function runTranslation(){
  if (!window['😀'] || !window['😀']['↔️']) {
    output.textContent = '❌↔️🔌';
    status('❌');
    return;
  }
  if (!input.value.trim()) {
    output.textContent = '🟡❓';
    status('🟡');
    return;
  }
  status('🔵');
  output.textContent = mode === 1 ? '😀➡️🔤⏳' : '🔤➡️😀⏳';
  try { applyResult(await window['😀']['↔️'](mode,input.value)); }
  catch (_) { output.textContent='❌↔️🧯';status('❌'); }
}

async function runImage(){
  if (!imageDataUrl) {
    file.click();
    return;
  }
  if (!window['😀'] || !window['😀']['📸']) {
    output.textContent = '❌📸🔌';
    status('❌');
    return;
  }
  status('🔵');
  output.textContent = mode === 1 ? '📸➡️🔤⏳' : '📸➡️😀⏳';
  try { applyResult(await window['😀']['📸'](mode,imageDataUrl),'🟡📸❓'); }
  catch (_) { output.textContent='❌📸🧯';status('❌'); }
}

function clearAll(){
  input.value='';
  output.textContent='⚪';
  imageDataUrl='';
  previewImage.removeAttribute('src');
  preview.classList.remove('on');
  file.value='';
  status('⚪');
  input.focus();
}

$('mode1').addEventListener('click',()=>setMode(1));
$('mode2').addEventListener('click',()=>setMode(2));
$('run').addEventListener('click',()=>imageDataUrl ? runImage() : runTranslation());
$('image').addEventListener('click',()=>file.click());
$('clear').addEventListener('click',clearAll);
$('diag').addEventListener('click',()=>runBot('🧪'));
$('ollama').addEventListener('click',()=>runBot('🦙🔍'));
file.addEventListener('change',()=>readImage(file.files && file.files[0]));
input.addEventListener('input',()=>{if(imageDataUrl && input.value !== '📸'){imageDataUrl='';previewImage.removeAttribute('src');preview.classList.remove('on');file.value='';}});
input.addEventListener('keydown',(event)=>{if(event.ctrlKey && event.key==='Enter'){event.preventDefault();imageDataUrl ? runImage() : runTranslation();}});

['dragenter','dragover'].forEach(name=>leftPanel.addEventListener(name,(event)=>{event.preventDefault();leftPanel.classList.add('drop');}));
['dragleave','drop'].forEach(name=>leftPanel.addEventListener(name,(event)=>{event.preventDefault();leftPanel.classList.remove('drop');}));
leftPanel.addEventListener('drop',(event)=>{const files=event.dataTransfer && event.dataTransfer.files;if(files && files[0]) readImage(files[0]);});
window.addEventListener('paste',(event)=>{
  const items=[...(event.clipboardData ? event.clipboardData.items : [])];
  const item=items.find(entry=>String(entry.type || '').startsWith('image/'));
  if(item){event.preventDefault();readImage(item.getAsFile());}
});

setMode(2);
</script>
</body>
</html>
