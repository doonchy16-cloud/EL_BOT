/* Phase 5 rendered visual polish. Loaded after the base UI so these rules are authoritative. */
.processing{transition:background .22s ease,box-shadow .22s ease,border-color .22s ease}
.processing.warn{background:radial-gradient(circle at 50% 43%,#3a250f 0,#17100a 44%,#080b12 100%);box-shadow:inset 0 0 0 2px #ffb34788,inset 0 0 70px #ff9f1c18}
.hourglass{width:clamp(112px,10.5vw,150px);height:clamp(134px,12.6vw,178px);filter:drop-shadow(0 0 23px #ffd166a8)}
.hourglass svg{overflow:visible}
.hgFrame{stroke:#ffe7a7;stroke-width:5.8;filter:drop-shadow(0 0 3px #ffd16655)}
.hgGlass{fill:#bfeaff18;stroke:#b9e6ffb8;stroke-width:1.8}
.sandTop,.sandBottom,.sandStream,.sandGrain{fill:#ffd166;filter:drop-shadow(0 0 5px #ffc43dcc)}
.sandStream{stroke:#ffe8a3;stroke-width:2.2;paint-order:stroke fill}
.sandGrain{stroke:#ffe8a3;stroke-width:.9;paint-order:stroke fill}
.hourglass.flip{animation:hourglassFlip 5.6s cubic-bezier(.46,.03,.42,.98) infinite}
.hourglass.flip svg{animation:hourglassGlow 1.05s ease-in-out infinite}
.hourglass.flip .sandTop{animation:sandTopFlow 5.6s linear infinite}
.hourglass.flip .sandBottom{animation:sandBottomFlow 5.6s linear infinite}
.hourglass.flip .sandStream{animation:sandStreamFlow 5.6s linear infinite}
.hourglass.flip .flowDown{animation:flowDownWindow 5.6s linear infinite}
.hourglass.flip .flowUp{animation:flowUpWindow 5.6s linear infinite}
.hourglass.flip .flowDown .sandGrain{animation:sandGrainDown .62s linear infinite}
.hourglass.flip .flowUp .sandGrain{animation:sandGrainUp .62s linear infinite}
.hourglass.flip .sandGrain.g2,.hourglass.flip .sandGrain.u2{animation-delay:.10s}
.hourglass.flip .sandGrain.g3,.hourglass.flip .sandGrain.u3{animation-delay:.20s}
.hourglass.flip .sandGrain.g4,.hourglass.flip .sandGrain.u4{animation-delay:.30s}
.hourglass.flip .sandGrain.g5,.hourglass.flip .sandGrain.u5{animation-delay:.40s}

/* 0↔180 only. Stream stops before each turn, stays stopped through the turn/settle, then resumes. */
@keyframes hourglassFlip{
  0%,34%{transform:rotate(0deg)}
  44%,82%{transform:rotate(180deg)}
  92%,100%{transform:rotate(0deg)}
}
@keyframes hourglassGlow{
  0%,100%{filter:drop-shadow(0 0 3px #ffd16677)}
  50%{filter:drop-shadow(0 0 13px #ffd166e6)}
}
@keyframes sandTopFlow{
  0%{transform:scaleY(1);transform-origin:50% 100%}
  30%,48%{transform:scaleY(.055);transform-origin:50% 100%}
  78%,100%{transform:scaleY(1);transform-origin:50% 100%}
}
@keyframes sandBottomFlow{
  0%{transform:scaleY(.055);transform-origin:50% 100%}
  30%,48%{transform:scaleY(1);transform-origin:50% 100%}
  78%,100%{transform:scaleY(.055);transform-origin:50% 100%}
}
@keyframes sandStreamFlow{
  0%,30%{opacity:1}
  31%,47%{opacity:0}
  48%,78%{opacity:1}
  79%,100%{opacity:0}
}
@keyframes flowDownWindow{
  0%,30%{opacity:1}
  31%,100%{opacity:0}
}
@keyframes flowUpWindow{
  0%,47%{opacity:0}
  48%,78%{opacity:1}
  79%,100%{opacity:0}
}
@keyframes sandGrainDown{
  0%{opacity:0;transform:translateY(-12px)}
  12%{opacity:1}
  84%{opacity:1;transform:translateY(14px)}
  100%{opacity:0;transform:translateY(17px)}
}
@keyframes sandGrainUp{
  0%{opacity:0;transform:translateY(12px)}
  12%{opacity:1}
  84%{opacity:1;transform:translateY(-14px)}
  100%{opacity:0;transform:translateY(-17px)}
}
.processing.warn .hourglass{filter:drop-shadow(0 0 30px #ff9f1ccc) saturate(1.2)}
.processing.warn .hgFrame{stroke:#ffc15b}
.stage{font-size:clamp(19px,1.55vw,25px);font-weight:800;line-height:1.28;text-shadow:0 2px 16px #000}
.stageMeta{min-height:2.15em;padding:8px 12px;border:1px solid #34486d;border-radius:11px;background:#101827dd;color:#c3cee0;font:700 clamp(15px,1.08vw,18px)/1.2 ui-monospace,"Cascadia Mono","Segoe UI",monospace;letter-spacing:.15px;box-shadow:0 7px 25px #0005}
.processing.warn .stageMeta{color:#ffd58a;border-color:#ffb347aa;background:#291b0de8;box-shadow:0 0 24px #ff9f1c28}
.processing.warn .stage{color:#fff1cc}
.preview{cursor:zoom-in;transition:border-color .18s ease,box-shadow .18s ease,background .18s ease}
.preview:hover,.preview:focus-visible{border-color:#76b7ff;box-shadow:0 0 0 3px #76b7ff22,0 0 28px #4f9cff22;outline:none}
.preview.zoom{display:grid;position:fixed;inset:clamp(12px,3vw,42px);z-index:60;max-height:none;min-height:0;padding:clamp(26px,4vw,58px);place-items:center;background:#04070cf2;border-color:#76b7ff;box-shadow:0 24px 90px #000d,0 0 0 9999px #0009;cursor:zoom-out;overflow:auto}
.preview.zoom img{width:auto;height:auto;max-width:100%;max-height:calc(100vh - 120px);object-fit:contain;box-shadow:0 18px 60px #000b}
.preview.zoom .previewBadge{position:fixed;top:clamp(22px,4vw,54px);left:clamp(22px,4vw,54px);font-size:20px;border-color:#76b7ff}
.previewBadge{user-select:none}
@media(max-width:700px){.hourglass{width:104px;height:126px}.stageMeta{font-size:14px;padding:7px 9px}.preview.zoom{inset:8px;padding:44px 12px 16px}}
