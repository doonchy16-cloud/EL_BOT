#!/usr/bin/env node
'use strict';

const { app, BrowserWindow, ipcMain } = require('electron');
const { spawn, spawnSync } = require('child_process');
const crypto = require('crypto');
const path = require('path');
const fs = require('fs');
const ADMIN = require('./🛡️');

const ROOT = path.resolve(__dirname, '..');
const BOT = path.join(ROOT, '🤖');
const TRANSLATE = path.join(ROOT, '↔️', '⚡');
const VISION = path.join(ROOT, '📸', '📸');
const PRELOAD = path.join(__dirname, '🔌');
const VIEW_SOURCE = path.join(__dirname, '🖥️');
const POLISH_CSS = path.join(__dirname, '✨');
const POLISH_JS = path.join(__dirname, '🎞️');
const IDENTITY_DIR = path.join(ROOT, '🪪');
const IDENTITY_CONFIG = JSON.parse(fs.readFileSync(path.join(IDENTITY_DIR, '🎛️'), 'utf8'));
const APP_NAME = String(IDENTITY_CONFIG.name || 'EL Bot');
const APP_ID = String(IDENTITY_CONFIG.app_id || 'com.thespark.elbot');
const APP_ICON_SOURCE = path.join(IDENTITY_DIR, String(IDENTITY_CONFIG.icon_asset || '🎨'));
const REQUIRED_VIEW_IDS = Object.freeze(['mode1', 'mode2', 'run', 'image', 'clear', 'diag', 'ollama', 'input', 'output', 'state']);

app.setName(APP_NAME);
if (process.platform === 'win32') app.setAppUserModelId(APP_ID);

function hasCommand(command, args = []) {
  try { return spawnSync(command, args, { windowsHide: true, stdio: 'ignore', timeout: 4000 }).status === 0; }
  catch (_) { return false; }
}

function pythonCandidate() {
  const candidates = [];
  if (process.env.EL_PYTHON) candidates.push({ command: process.env.EL_PYTHON, prefix: [] });
  candidates.push({ command: path.join(ROOT, 'python', 'python.exe'), prefix: [] });
  if (process.env.RUNNER_TOOL_CACHE) candidates.push({ command: path.join(process.env.RUNNER_TOOL_CACHE, 'ELPython', '3.12.10', 'python.exe'), prefix: [] });
  candidates.push(
    { command: 'C:\\Git\\EL-bot-runner\\actions-runner\\_work\\_tool\\ELPython\\3.12.10\\python.exe', prefix: [] },
    { command: 'py', prefix: ['-3'] },
    { command: 'python', prefix: [] },
    { command: 'python3', prefix: [] },
  );
  for (const candidate of candidates) {
    if (candidate.command.includes(path.sep) || /^[A-Za-z]:\\/.test(candidate.command)) {
      if (fs.existsSync(candidate.command)) return candidate;
      continue;
    }
    if (hasCommand(candidate.command, [...candidate.prefix, '--version'])) return candidate;
  }
  return null;
}

function rankDbPath() { return path.join(app.getPath('userData'), '🏆'); }

function ensureAppIconPath() {
  const encoded = fs.readFileSync(APP_ICON_SOURCE, 'utf8').trim();
  const bytes = Buffer.from(encoded, 'base64');
  const signature = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
  if (bytes.length < 100 || !bytes.subarray(0, 8).equals(signature)) throw new Error('invalid EL Bot icon asset');
  const folder = app.getPath('userData');
  fs.mkdirSync(folder, { recursive: true });
  const target = path.join(folder, 'el-bot-icon.png');
  let current = null;
  try { current = fs.readFileSync(target); } catch (_) {}
  if (!current || !current.equals(bytes)) fs.writeFileSync(target, bytes);
  return target;
}

function validateViewSource(source) {
  if (typeof source !== 'string' || source.length < 1000) throw new Error('EL Bot UI source is empty');
  if (!/^\s*<!doctype html>/i.test(source)) throw new Error('EL Bot UI source is not HTML');
  for (const id of REQUIRED_VIEW_IDS) if (!source.includes(`id="${id}"`)) throw new Error(`EL Bot UI source missing ${id}`);
  if (!source.includes('<script>') || !source.includes('</html>')) throw new Error('EL Bot UI source is incomplete');
}

function materializeHtmlView() {
  const source = fs.readFileSync(VIEW_SOURCE, 'utf8');
  validateViewSource(source);
  const digest = crypto.createHash('sha256').update(source, 'utf8').digest('hex').slice(0, 16);
  const folder = path.join(app.getPath('userData'), 'runtime');
  fs.mkdirSync(folder, { recursive: true });
  const target = path.join(folder, `el-bot-${digest}.html`);
  let validExisting = false;
  try { validExisting = fs.readFileSync(target, 'utf8') === source; } catch (_) {}
  if (!validExisting) {
    const temp = path.join(folder, `.el-bot-${digest}-${process.pid}.tmp`);
    fs.writeFileSync(temp, source, { encoding: 'utf8', flag: 'w' });
    try { fs.rmSync(target, { force: true }); } catch (_) {}
    fs.renameSync(temp, target);
  }
  for (const name of fs.readdirSync(folder)) {
    if (name === path.basename(target)) continue;
    if (/^el-bot-[0-9a-f]{16}\.html$/i.test(name)) try { fs.rmSync(path.join(folder, name), { force: true }); } catch (_) {}
  }
  return target;
}

async function verifyRenderedView(win) {
  if (!win || win.isDestroyed()) return false;
  return Boolean(await win.webContents.executeJavaScript(`(() => {
    const required = ${JSON.stringify(REQUIRED_VIEW_IDS)};
    const idsReady = required.every((id) => document.getElementById(id));
    const htmlReady = document.documentElement && document.documentElement.tagName === 'HTML' && document.body;
    const rawSource = document.body && /^\\s*<!doctype html>/i.test(document.body.innerText || '');
    return Boolean(idsReady && htmlReady && !rawSource);
  })()`, true));
}

async function applyPhase5Enhancements(win) {
  if (!fs.existsSync(POLISH_CSS) || !fs.existsSync(POLISH_JS)) throw new Error('Phase-5 visual polish layer is missing');
  const css = fs.readFileSync(POLISH_CSS, 'utf8');
  const script = fs.readFileSync(POLISH_JS, 'utf8');
  if (!css.includes('@keyframes hourglassFlip') || css.includes('rotate(360deg)')) throw new Error('invalid Phase-5 hourglass contract');
  await win.webContents.insertCSS(css);
  await win.webContents.executeJavaScript(script, true);
}

function startupFailureHtml(error) {
  const message = String(error && error.message ? error.message : error || 'unknown startup failure').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  return `<!doctype html><html><head><meta charset="utf-8"><title>${APP_NAME}</title><style>html,body{height:100%;margin:0;background:#080b12;color:#f6f8ff;font-family:Segoe UI,Arial,sans-serif}body{display:grid;place-items:center}.card{max-width:760px;margin:28px;padding:28px;border:1px solid #7b3040;border-radius:20px;background:#170c12;box-shadow:0 18px 60px #0009}h1{margin:0 0 12px;font-size:30px}p{font-size:18px;line-height:1.5;color:#ffc7cf}code{display:block;margin-top:18px;padding:14px;border-radius:12px;background:#080b12;color:#fff;white-space:pre-wrap}</style></head><body><div class="card"><h1>❌ EL Bot UI failed to load</h1><p>The application blocked an invalid or incomplete interface instead of displaying raw source code.</p><code>${message}</code></div></body></html>`;
}

async function loadApplicationView(win) {
  const runtimeView = materializeHtmlView();
  if (path.extname(runtimeView).toLowerCase() !== '.html') throw new Error('runtime view is not an HTML file');
  await win.loadFile(runtimeView);
  if (!(await verifyRenderedView(win))) throw new Error('rendered UI verification failed');
  await applyPhase5Enhancements(win);
  await ADMIN.install(win);
  return runtimeView;
}

function emitStage(event, payload) {
  try { if (event && event.sender && !event.sender.isDestroyed()) event.sender.send('⏳', payload); }
  catch (_) {}
}
function stagePayload(payload, kind) {
  const value = payload && typeof payload === 'object' ? { ...payload } : {};
  const label = String(value.label || '');
  if (kind === 'vision') {
    if (/Load Vision Model/i.test(label)) value.warn_after_ms = 30000;
    else if (/Observe|Retry/i.test(label)) value.warn_after_ms = 20000;
    else value.warn_after_ms = 8000;
  } else if (kind === 'translation') value.warn_after_ms = 5000;
  return value;
}

function runPython(target, source, timeoutMs, extraArgs = [], onStage = null) {
  return new Promise((resolve) => {
    if (typeof source !== 'string') { resolve('❌🔣'); return; }
    const python = pythonCandidate();
    if (!python) { resolve('❌🐍'); return; }
    const child = spawn(python.command, [...python.prefix, target, ...extraArgs], {
      cwd: ROOT,
      windowsHide: true,
      stdio: ['pipe', 'pipe', 'pipe'],
      env: { ...process.env, PYTHONIOENCODING: 'utf-8', EL_RANK_DB: rankDbPath(), EL_FORGEY_REGISTRY: ADMIN.registryPath() },
    });
    let stdout = '', stderr = '', stderrBuffer = '', settled = false;
    const finish = (value) => { if (!settled) { settled = true; resolve(value); } };
    const timer = setTimeout(() => { try { child.kill(); } catch (_) {} finish('🟡⏱️'); }, timeoutMs);
    const consumeLine = (line) => {
      if (line.startsWith('EL_STAGE\t')) {
        try { const payload = JSON.parse(line.slice('EL_STAGE\t'.length)); if (onStage) onStage(payload); } catch (_) {}
      } else if (line.trim()) stderr += line + '\n';
    };
    child.stdout.setEncoding('utf8');child.stderr.setEncoding('utf8');
    child.stdout.on('data', (chunk) => { stdout += chunk; });
    child.stderr.on('data', (chunk) => {
      stderrBuffer += chunk;
      let newline;
      while ((newline = stderrBuffer.indexOf('\n')) >= 0) {
        consumeLine(stderrBuffer.slice(0, newline).replace(/\r$/, ''));
        stderrBuffer = stderrBuffer.slice(newline + 1);
      }
    });
    child.on('error', () => { clearTimeout(timer); finish('❌🐍'); });
    child.on('close', (code) => {
      clearTimeout(timer);
      if (stderrBuffer) consumeLine(stderrBuffer.replace(/\r$/, ''));
      if (settled) return;
      if (code === 0 && stdout.trim()) finish(stdout.trim());
      else if (stderr.trim()) finish('❌🧯');
      else finish('❌🤖');
    });
    child.stdin.end(source, 'utf8');
  });
}

function parseRanked(raw) {
  try { const parsed = JSON.parse(raw); if (parsed && typeof parsed.winner === 'string' && Array.isArray(parsed.candidates)) return parsed; }
  catch (_) {}
  return { winner: raw, candidates: raw ? [{ value: raw, score: 0, reasons: [], coverage: 0, roundtrip: 0 }] : [], metrics: {} };
}

async function runTranslation(event, mode, source) {
  if (![1, 2].includes(mode) || typeof source !== 'string') return { winner: '❌🔣', candidates: [], metrics: {} };
  const started = Date.now();
  const raw = await runPython(TRANSLATE, `${mode}\n${source}`, 420000, ['🔀'], (payload) => emitStage(event, stagePayload(payload, 'translation')));
  const result = parseRanked(raw);
  ADMIN.recordTranslation({ mode, sourceLength: source.length, elapsedMs: Date.now() - started, result });
  return result;
}

async function runVision(event, mode, imageDataUrl) {
  if (![1, 2].includes(mode) || typeof imageDataUrl !== 'string' || !imageDataUrl.startsWith('data:image/')) return { winner: '❌📸🔣', candidates: [], metrics: {} };
  const raw = await runPython(VISION, `${mode}\n${imageDataUrl}`, 350000, ['🔀'], (payload) => emitStage(event, stagePayload(payload, 'vision')));
  return parseRanked(raw);
}

async function recordSelection(mode, source, value) {
  if (![1, 2].includes(mode) || typeof source !== 'string' || typeof value !== 'string') return '❌🏆';
  return runPython(TRANSLATE, JSON.stringify({ mode, source, value }), 30000, ['✅']);
}

async function createWindow() {
  const iconPath = ensureAppIconPath();
  const win = new BrowserWindow({ width:1400, height:900, minWidth:780, minHeight:580, title:APP_NAME, icon:iconPath, backgroundColor:'#080b12', autoHideMenuBar:true, show: false, webPreferences:{ preload:PRELOAD, contextIsolation:true, nodeIntegration:false, sandbox:true } });
  if (process.platform === 'win32') {
    try { win.setAppDetails({ appId: APP_ID, appIconPath: iconPath }); } catch (_) {}
    try { win.setThumbnailToolTip(APP_NAME); } catch (_) {}
  }
  try { await loadApplicationView(win); }
  catch (error) { const fallback='data:text/html;charset=utf-8,'+encodeURIComponent(startupFailureHtml(error));try{await win.loadURL(fallback);}catch(_){} }
  if (!win.isDestroyed()) win.show();
  return win;
}

async function writePackageSmoke(win, target) {
  const rendered = await verifyRenderedView(win);
  const polished = Boolean(await win.webContents.executeJavaScript(`(() => {
    const preview = document.getElementById('preview');
    const meta = document.getElementById('stageMeta');
    return preview && preview.getAttribute('aria-label') === 'Enlarge screenshot preview' && meta && getComputedStyle(meta).fontFamily.toLowerCase().includes('mono');
  })()`, true));
  const python = pythonCandidate();
  const bundledPath = path.resolve(path.join(ROOT, 'python', 'python.exe'));
  const selectedPath = python ? path.resolve(python.command) : '';
  const bundledPython = Boolean(python && selectedPath.toLowerCase() === bundledPath.toLowerCase());
  let pythonExec = false;
  if (python) {
    try { pythonExec = spawnSync(python.command, [...python.prefix, '-c', 'import sys; assert sys.version_info[:2] == (3, 12)'], { cwd: ROOT, windowsHide: true, stdio: 'ignore', timeout: 10000 }).status === 0; }
    catch (_) { pythonExec = false; }
  }
  const evidence = { schema_version:1, app_is_packaged:app.isPackaged, rendered, polished, bundled_python:bundledPython, python_exec:pythonExec, python_path:selectedPath, root:ROOT };
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, JSON.stringify(evidence, null, 2));
  if (!app.isPackaged || !rendered || !polished || !bundledPython || !pythonExec) throw new Error('packaged runtime smoke failed: '+JSON.stringify(evidence));
}

ipcMain.handle('😀➡️🤖', async (_event, source) => runPython(BOT, source, 30000));
ipcMain.handle('↔️', async (event, mode, source) => runTranslation(event, mode, source));
ipcMain.handle('🏆', async (_event, mode, source, value) => recordSelection(mode, source, value));
ipcMain.handle('📸➡️🦙', async (event, mode, imageDataUrl) => runVision(event, mode, imageDataUrl));

app.whenReady().then(async()=>{
  const win = await createWindow();
  const smokeFile = String(process.env.EL_PACKAGE_SMOKE_FILE || '').trim();
  if (smokeFile) {
    await writePackageSmoke(win, smokeFile);
    if (!win.isDestroyed()) win.destroy();
    app.quit();
    return;
  }
  app.on('activate',()=>{if(BrowserWindow.getAllWindows().length===0)void createWindow();});
}).catch((error)=>{console.error(error && error.stack ? error.stack : error);app.exit(1);});
app.on('window-all-closed',()=>{if(process.platform!=='darwin')app.quit();});
