#!/usr/bin/env node
'use strict';

const { app, BrowserWindow, ipcMain } = require('electron');
const { spawn, spawnSync } = require('child_process');
const path = require('path');
const fs = require('fs');

const ROOT = path.resolve(__dirname, '..');
const BOT = path.join(ROOT, '🤖');
const TRANSLATE = path.join(ROOT, '↔️', '↔️');
const VISION = path.join(ROOT, '📸', '📸');
const PRELOAD = path.join(__dirname, '🔌');
const VIEW = path.join(__dirname, '🖥️');

function hasCommand(command, args = []) {
  try {
    const result = spawnSync(command, args, { windowsHide: true, stdio: 'ignore', timeout: 4000 });
    return result.status === 0;
  } catch (_) {
    return false;
  }
}

function pythonCandidate() {
  const candidates = [];
  if (process.env.EL_PYTHON) candidates.push({ command: process.env.EL_PYTHON, prefix: [] });
  if (process.env.RUNNER_TOOL_CACHE) {
    candidates.push({ command: path.join(process.env.RUNNER_TOOL_CACHE, 'ELPython', '3.12.10', 'python.exe'), prefix: [] });
  }
  candidates.push(
    { command: 'C:\\Git\\EL-bot-runner\\actions-runner\\_work\\_tool\\ELPython\\3.12.10\\python.exe', prefix: [] },
    { command: 'py', prefix: ['-3'] },
    { command: 'python', prefix: [] },
    { command: 'python3', prefix: [] },
  );
  for (const candidate of candidates) {
    if (candidate.command.includes(path.sep) || /^[A-Za-z]:\\/.test(candidate.command)) {
      if (!fs.existsSync(candidate.command)) continue;
      return candidate;
    }
    if (hasCommand(candidate.command, [...candidate.prefix, '--version'])) return candidate;
  }
  return null;
}

function rankDbPath() {
  return path.join(app.getPath('userData'), '🏆');
}

function runPython(target, source, timeoutMs, extraArgs = []) {
  return new Promise((resolve) => {
    if (typeof source !== 'string') { resolve('❌🔣'); return; }
    const python = pythonCandidate();
    if (!python) { resolve('❌🐍'); return; }

    const child = spawn(python.command, [...python.prefix, target, ...extraArgs], {
      cwd: ROOT,
      windowsHide: true,
      stdio: ['pipe', 'pipe', 'pipe'],
      env: { ...process.env, PYTHONIOENCODING: 'utf-8', EL_RANK_DB: rankDbPath() },
    });

    let stdout = '';
    let stderr = '';
    let settled = false;
    const finish = (value) => { if (!settled) { settled = true; resolve(value); } };
    const timer = setTimeout(() => {
      try { child.kill(); } catch (_) {}
      finish('🟡⏱️');
    }, timeoutMs);

    child.stdout.setEncoding('utf8');
    child.stderr.setEncoding('utf8');
    child.stdout.on('data', (chunk) => { stdout += chunk; });
    child.stderr.on('data', (chunk) => { stderr += chunk; });
    child.on('error', () => { clearTimeout(timer); finish('❌🐍'); });
    child.on('close', (code) => {
      clearTimeout(timer);
      if (settled) return;
      if (code === 0 && stdout.trim()) finish(stdout.trim());
      else if (stderr.trim()) finish('❌🧯');
      else finish('❌🤖');
    });
    child.stdin.end(source, 'utf8');
  });
}

function runBot(source) { return runPython(BOT, source, 30000); }
function validMode(mode) { return mode === 1 || mode === 2; }

function parseRanked(raw) {
  try {
    const parsed = JSON.parse(raw);
    if (parsed && typeof parsed.winner === 'string' && Array.isArray(parsed.candidates)) return parsed;
  } catch (_) {}
  return { winner: raw, candidates: raw ? [{ value: raw, score: 0, reasons: [] }] : [] };
}

async function runTranslation(mode, source) {
  if (!validMode(mode) || typeof source !== 'string') return { winner: '❌🔣', candidates: [] };
  const raw = await runPython(TRANSLATE, `${mode}\n${source}`, 420000, ['🔀']);
  return parseRanked(raw);
}

async function recordSelection(mode, source, value) {
  if (!validMode(mode) || typeof source !== 'string' || typeof value !== 'string') return '❌🏆';
  return runPython(TRANSLATE, JSON.stringify({ mode, source, value }), 30000, ['✅']);
}

async function runVision(mode, imageDataUrl) {
  if (!validMode(mode) || typeof imageDataUrl !== 'string' || !imageDataUrl.startsWith('data:image/')) {
    return { winner: '❌📸🔣', candidates: [] };
  }
  const raw = await runPython(VISION, `${mode}\n${imageDataUrl}`, 420000, ['🔀']);
  return parseRanked(raw);
}

function createWindow() {
  const win = new BrowserWindow({
    width: 1400,
    height: 900,
    minWidth: 780,
    minHeight: 580,
    title: '🤖😀',
    backgroundColor: '#080b12',
    autoHideMenuBar: true,
    webPreferences: { preload: PRELOAD, contextIsolation: true, nodeIntegration: false, sandbox: true },
  });
  const html = fs.readFileSync(VIEW, 'utf8');
  win.loadURL('data:text/html;charset=utf-8,' + encodeURIComponent(html));
}

ipcMain.handle('😀➡️🤖', async (_event, source) => runBot(source));
ipcMain.handle('↔️', async (_event, mode, source) => runTranslation(mode, source));
ipcMain.handle('🏆', async (_event, mode, source, value) => recordSelection(mode, source, value));
ipcMain.handle('📸➡️🦙', async (_event, mode, imageDataUrl) => runVision(mode, imageDataUrl));

app.whenReady().then(() => {
  createWindow();
  app.on('activate', () => { if (BrowserWindow.getAllWindows().length === 0) createWindow(); });
});

app.on('window-all-closed', () => { if (process.platform !== 'darwin') app.quit(); });
