'use strict';

const { contextBridge, ipcRenderer } = require('electron');

contextBridge.exposeInMainWorld('😀', Object.freeze({
  '▶️': (source) => ipcRenderer.invoke('😀➡️🤖', source),
  '↔️': (mode, source) => ipcRenderer.invoke('↔️', mode, source),
  '🏆': (mode, source, value) => ipcRenderer.invoke('🏆', mode, source, value),
  '📸': (mode, imageDataUrl) => ipcRenderer.invoke('📸➡️🦙', mode, imageDataUrl),
  '⏳': (handler) => {
    if (typeof handler !== 'function') return () => {};
    const listener = (_event, payload) => handler(payload);
    ipcRenderer.on('⏳', listener);
    return () => ipcRenderer.removeListener('⏳', listener);
  },
  '🔐': Object.freeze({
    state: () => ipcRenderer.invoke('🔐:state'),
    bootstrap: (password, confirmation) => ipcRenderer.invoke('🔐:bootstrap', password, confirmation),
    login: (password) => ipcRenderer.invoke('🔐:login', password),
    logout: (token) => ipcRenderer.invoke('🔐:logout', token),
    rotate: (token, currentPassword, nextPassword, confirmation) => ipcRenderer.invoke('🔐:rotate', token, currentPassword, nextPassword, confirmation),
    snapshot: (token, force = false) => ipcRenderer.invoke('🤖:snapshot', token, Boolean(force)),
    validate: (token) => ipcRenderer.invoke('🤖:validate', token),
    rollback: (token, generation, password, confirmation) => ipcRenderer.invoke('🤖:rollback', token, generation, password, confirmation),
  }),
}));
