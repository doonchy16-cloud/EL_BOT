"""Engine 14: deterministic connector boundary with public EL-safe and internal provider channels."""

from __future__ import annotations
from dataclasses import dataclass
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from typing import Callable
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_core = _load("_el_core", _ROOT / "⚙️" / "⚙️")
_vocab = _load("_el_vocab", _ROOT / "📚" / "📚")
CoreEngine = _core.CoreEngine
ValidationStatus = _core.ValidationStatus
VocabularyEngine = _vocab.VocabularyEngine


@dataclass(frozen=True, slots=True)
class ConnectorRecord:
    marker: str
    handler: Callable[[str], str]
    probe: Callable[[], bool] | None = None


@dataclass(frozen=True, slots=True)
class InternalConnectorRecord:
    marker: str
    handler: Callable[[dict], dict]
    probe: Callable[[], bool] | None
    provider: str
    model: str


@dataclass(frozen=True, slots=True)
class ConnectorEvidence:
    marker: str
    state: str

    def render_el(self) -> str:
        return self.state + self.marker


@dataclass(frozen=True, slots=True)
class InternalConnectorResult:
    marker: str
    ok: bool
    called: bool
    provider: str
    model: str
    payload: dict | None = None
    error_code: str = ""

    def render_el(self) -> str:
        marker = "✅" if self.ok else "🟡" if not self.called else "❌"
        return marker + "🔌" + self.marker


class ConnectorEngine:
    """Register explicit adapters; never fabricate connectivity or expose raw provider data publicly."""

    def __init__(self) -> None:
        self._records: dict[str, ConnectorRecord] = {}
        self._internal_records: dict[str, InternalConnectorRecord] = {}

    @property
    def count(self) -> int:
        return len(set(self._records).union(self._internal_records))

    @property
    def markers(self) -> tuple[str, ...]:
        return tuple(dict.fromkeys(tuple(self._records) + tuple(self._internal_records)))

    @property
    def internal_count(self) -> int:
        return len(self._internal_records)

    @staticmethod
    def _validate_marker(marker: str) -> None:
        if not isinstance(marker, str) or not marker:
            raise TypeError("marker must be a non-empty string")
        parsed = CoreEngine().parse(marker, el_mode=True)
        if parsed.status is not ValidationStatus.PASS or len(parsed.tokens) != 1:
            raise ValueError("connector marker must be exactly one EL-safe token")
        if VocabularyEngine.lookup(marker) is None:
            raise ValueError("connector marker must be canonical")

    def _assert_unused(self, marker: str) -> None:
        if marker in self._records or marker in self._internal_records:
            raise ValueError("connector marker already registered")

    def register(
        self,
        marker: str,
        handler: Callable[[str], str],
        probe: Callable[[], bool] | None = None,
    ) -> None:
        self._validate_marker(marker)
        if not callable(handler):
            raise TypeError("handler must be callable")
        if probe is not None and not callable(probe):
            raise TypeError("probe must be callable")
        self._assert_unused(marker)
        self._records[marker] = ConnectorRecord(marker, handler, probe)

    def register_internal(
        self,
        marker: str,
        handler: Callable[[dict], dict],
        *,
        probe: Callable[[], bool] | None = None,
        provider: str,
        model: str,
    ) -> None:
        """Register a structured internal adapter. Its payload can never be returned by invoke()."""
        self._validate_marker(marker)
        if not callable(handler):
            raise TypeError("handler must be callable")
        if probe is not None and not callable(probe):
            raise TypeError("probe must be callable")
        if not isinstance(provider, str) or not provider.strip():
            raise ValueError("provider must be non-empty")
        if not isinstance(model, str) or not model.strip():
            raise ValueError("model must be non-empty")
        self._assert_unused(marker)
        self._internal_records[marker] = InternalConnectorRecord(marker, handler, probe, provider.strip(), model.strip())

    def unregister(self, marker: str) -> bool:
        removed = self._records.pop(marker, None) is not None
        removed = self._internal_records.pop(marker, None) is not None or removed
        return removed

    def evidence(self, marker: str) -> ConnectorEvidence:
        record = self._records.get(marker)
        internal = self._internal_records.get(marker)
        if record is None and internal is None:
            return ConnectorEvidence(marker, "⚪")
        probe = record.probe if record is not None else internal.probe
        if probe is None:
            return ConnectorEvidence(marker, "🟡")
        try:
            state = "✅" if probe() is True else "❌"
        except Exception:
            state = "❌"
        return ConnectorEvidence(marker, state)

    def invoke(self, marker: str, payload: str) -> str:
        """Public EL-safe invocation. Internal providers are deliberately inaccessible here."""
        record = self._records.get(marker)
        if record is None:
            return "🟡🔌❓"
        if record.probe is not None and self.evidence(marker).state != "✅":
            return "🟡🔌" + marker
        try:
            output = record.handler(payload)
        except Exception:
            return "❌🔌" + marker
        if not isinstance(output, str):
            return "❌🔌" + marker
        surface = CoreEngine().parse(output, el_mode=True)
        if surface.status is ValidationStatus.FAIL:
            return "❌🔌🔤"
        return output

    def invoke_internal(self, marker: str, payload: dict) -> InternalConnectorResult:
        """Internal structured invocation. The caller must deterministically validate payload before release."""
        record = self._internal_records.get(marker)
        if record is None:
            return InternalConnectorResult(marker, False, False, "", "", None, "unregistered")
        if not isinstance(payload, dict):
            return InternalConnectorResult(marker, False, False, record.provider, record.model, None, "invalid-payload")
        if record.probe is not None and self.evidence(marker).state != "✅":
            return InternalConnectorResult(marker, False, False, record.provider, record.model, None, "unavailable")
        try:
            output = record.handler(payload)
        except Exception:
            return InternalConnectorResult(marker, False, True, record.provider, record.model, None, "provider-error")
        if not isinstance(output, dict):
            return InternalConnectorResult(marker, False, True, record.provider, record.model, None, "invalid-provider-shape")
        return InternalConnectorResult(marker, True, True, record.provider, record.model, output, "")

    def render_el(self) -> str:
        if not self.markers:
            return "⚪🔌0"
        rendered = " ".join(self.evidence(marker).render_el() for marker in self.markers)
        return "🔌" + str(self.count) + " " + rendered

    def process(self, text: str) -> str:
        if text in {"🔌", "🔌📋"}:
            return self.render_el()
        if text.startswith("🔌") and len(CoreEngine().parse(text, el_mode=True).tokens) == 2:
            marker = CoreEngine().parse(text, el_mode=True).tokens[1].text
            return self.evidence(marker).render_el()
        return "🟡🔌❓"

    def render_el_status(self) -> str:
        if not self.markers:
            return "⚪🔌0"
        states = tuple(self.evidence(marker).state for marker in self.markers)
        if any(state == "❌" for state in states):
            head = "❌"
        elif any(state == "🟡" for state in states):
            head = "🟡"
        else:
            head = "✅"
        return head + "🔌" + str(self.count)
