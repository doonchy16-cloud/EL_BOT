"""Emoji-safe persistence for EL session context."""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import json
import os
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_session = _load("_el_session", _ROOT / "🧵" / "🧵")
SessionEngine = _session.SessionEngine


class PersistenceEngine:
    def __init__(self, path: str | Path | None = None) -> None:
        self.path = Path(path) if path is not None else Path(__file__).resolve().parent / "🗃️"

    def save(self, session: SessionEngine) -> int:
        if not isinstance(session, SessionEngine):
            raise TypeError("session must be a SessionEngine")

        safe_sources = [turn.source for turn in session.turns if not turn.surface.letter_tokens]
        payload = {"🔢": 1, "🧵": safe_sources}
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.path.with_name("🪣")
        temporary.write_text(
            json.dumps(payload, ensure_ascii=False, separators=(",", ":")),
            encoding="utf-8",
        )
        os.replace(temporary, self.path)
        return len(safe_sources)

    def load(self) -> SessionEngine:
        session = SessionEngine()
        if not self.path.exists():
            return session

        payload = json.loads(self.path.read_text(encoding="utf-8"))
        if not isinstance(payload, dict) or payload.get("🔢") != 1:
            raise ValueError("unsupported persistence shape")

        sources = payload.get("🧵", [])
        if not isinstance(sources, list):
            raise ValueError("invalid session payload")

        for source in sources:
            if not isinstance(source, str):
                raise ValueError("invalid turn payload")
            session.ingest(source)
        return session

    def clear(self) -> None:
        if self.path.exists():
            self.path.unlink()

    def render_el_status(self) -> str:
        return "✅💾" if self.path.exists() else "⚪💾"
