"""N01: deterministic Emoji Universe authority.

Phase 6 Step 1 prefers the materialized released Unicode emoji-test dataset. Official
RGI rows are preserved exactly so the reported count equals the source dataset. The
older broad assigned-symbol scan remains only an explicit offline fallback and never
claims to be the actual released emoji inventory.
"""
from __future__ import annotations

from dataclasses import dataclass
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys
import unicodedata


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_vocab = _load("_el_vocab_universe", _ROOT / "📚" / "📚")
_canon = _load("_el_canonicalization_universe", _ROOT / "🧷" / "🧷")
SEMANTIC_BASE_SYMBOLS = _vocab.SEMANTIC_BASE_SYMBOLS
EmojiCanonicalizationEngine = _canon.EmojiCanonicalizationEngine
_OFFICIAL_EMOJI_TEST = _ROOT / "data" / "unicode" / "emoji-test.txt"
_BROAD_RANGES = ((0x2300, 0x23FF), (0x2500, 0x27BF), (0x2B00, 0x2BFF), (0x1F000, 0x1FAFF))


def _assigned_symbol(char: str) -> bool:
    try:
        unicodedata.name(char)
    except ValueError:
        return False
    category = unicodedata.category(char)
    return category.startswith("S") or category in {"Sk", "So"}


def _decode_codepoints(field: str) -> str:
    return "".join(chr(int(part, 16)) for part in field.split())


@dataclass(frozen=True, slots=True)
class EmojiUniverseSnapshot:
    version: str
    source_kind: str
    units: tuple[str, ...]
    semantic_seed_coverage: int
    rgi_complete: bool
    fully_qualified_count: int
    component_count: int

    @property
    def count(self) -> int:
        return len(self.units)

    @property
    def canonical_coverage(self) -> int:
        """Compatibility alias: coverage of the stable semantic seed, not a ceiling."""
        return self.semantic_seed_coverage

    def render_el(self) -> str:
        return "✅🌐" + str(self.count) + ("🔒" if self.rgi_complete else "🟡")


class EmojiUniverseEngine:
    """Own the finite candidate-unit inventory; never assigns semantic meaning."""

    def __init__(self, units: tuple[str, ...] | list[str] | None = None, *, version: str = "builtin-fallback", source_kind: str = "broad-assigned-symbol-superset", rgi_complete: bool = False, fully_qualified_count: int = 0, component_count: int = 0) -> None:
        if units is None and _OFFICIAL_EMOJI_TEST.is_file():
            official = type(self).from_emoji_test(_OFFICIAL_EMOJI_TEST.read_text(encoding="utf-8"))
            self._snapshot = official.snapshot
            self._set = frozenset(self._snapshot.units)
            self._normalized_set = official._normalized_set
            return

        canonicalizer = EmojiCanonicalizationEngine()
        if units is None:
            generated: list[str] = list(SEMANTIC_BASE_SYMBOLS)
            for start, end in _BROAD_RANGES:
                for codepoint in range(start, end + 1):
                    char = chr(codepoint)
                    if _assigned_symbol(char):
                        generated.append(char)
            units = generated

        if rgi_complete:
            exact_units = tuple(dict.fromkeys(str(unit) for unit in units if unit))
            normalized_aliases: set[str] = set(exact_units)
            for unit in exact_units:
                result = canonicalizer.canonicalize_unit(unit)
                if result.valid and result.canonical:
                    normalized_aliases.add(result.canonical)
            seed_coverage = sum(1 for symbol in SEMANTIC_BASE_SYMBOLS if symbol in normalized_aliases)
            self._snapshot = EmojiUniverseSnapshot(str(version), str(source_kind), exact_units, seed_coverage, True, int(fully_qualified_count), int(component_count))
            self._set = frozenset(exact_units)
            self._normalized_set = frozenset(normalized_aliases)
            return

        normalized: list[str] = []
        seen: set[str] = set()
        for unit in units:
            result = canonicalizer.canonicalize_unit(unit)
            if not result.valid or not result.canonical or result.canonical in seen:
                continue
            seen.add(result.canonical)
            normalized.append(result.canonical)
        seed_coverage = sum(1 for symbol in SEMANTIC_BASE_SYMBOLS if symbol in seen)
        self._snapshot = EmojiUniverseSnapshot(str(version), str(source_kind), tuple(normalized), seed_coverage, False, int(fully_qualified_count), int(component_count))
        self._set = frozenset(self._snapshot.units)
        self._normalized_set = self._set

    @classmethod
    def from_emoji_test(cls, source: str) -> "EmojiUniverseEngine":
        if not isinstance(source, str) or not source.strip():
            raise ValueError("emoji-test source must be non-empty")
        version = "unknown"
        units: list[str] = []
        fully = 0
        components = 0
        for raw in source.splitlines():
            line = raw.strip()
            if line.startswith("# Version:"):
                version = line.split(":", 1)[1].strip()
                continue
            if not line or line.startswith("#") or ";" not in line:
                continue
            left, rest = line.split(";", 1)
            status = rest.split("#", 1)[0].strip()
            if status not in {"fully-qualified", "component"}:
                continue
            try:
                unit = _decode_codepoints(left.strip())
            except (ValueError, OverflowError):
                continue
            units.append(unit)
            if status == "fully-qualified":
                fully += 1
            else:
                components += 1
        if not units:
            raise ValueError("emoji-test contained no RGI rows")
        return cls(units, version=version, source_kind="unicode-emoji-test", rgi_complete=True, fully_qualified_count=fully, component_count=components)

    @property
    def snapshot(self) -> EmojiUniverseSnapshot:
        return self._snapshot

    @property
    def units(self) -> tuple[str, ...]:
        return self._snapshot.units

    def contains(self, unit: str) -> bool:
        if unit in self._set:
            return True
        result = EmojiCanonicalizationEngine().canonicalize_unit(unit)
        return result.valid and bool(result.canonical) and result.canonical in self._normalized_set

    def process(self, text: str) -> str:
        if text == "🌐":
            return self._snapshot.render_el()
        return ("✅" if self.contains(text) else "🟡") + "🌐"

    def render_el_status(self) -> str:
        return self._snapshot.render_el()
