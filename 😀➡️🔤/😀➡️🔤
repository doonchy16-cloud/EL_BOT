    @classmethod
    def _render_flow(cls,value:str)->str:
        value=value.strip(" .")
        if not value:return ""
        event=cls._event_sentence(value)
        if event:return event.rstrip(".")
        relationship=cls._relationship_sentence(value)
        if relationship:return relationship.rstrip(".")
        parts=value.split("➡️")
        rendered=[]
        for part in parts:
            item=cls._render_atom(part)
            if not item:continue
            if item.startswith("after ") and rendered:
                rendered[-1]=rendered[-1]+" "+item
            else:rendered.append(item)
        if not rendered:return cls._render_atom(value)
        if len(rendered)==1:return rendered[0]
        if len(rendered)==2:return rendered[0]+", then "+rendered[1]
        return ", ".join(rendered[:-1])+", and then "+rendered[-1]

    @classmethod
    def _realize_clause(cls,clause:str,*,concise:bool=False)->str:
        exact=_compounds.lookup_compound(clause)
        if exact:return _lang.sentence_case(exact)
        if clause in _CONVERSATION:return _CONVERSATION[clause]
        event=cls._event_sentence(clause)
        if event:return event
        relationship=cls._relationship_sentence(clause)
        if relationship:return relationship
        text=cls._render_flow(clause)
        return _lang.sentence_case(text) if text else "The input contains canonical EL concepts but no reconstructable statement."

    @classmethod
    def _realize_document(cls,source:str,*,concise:bool=False)->str:
        exact=_compounds.lookup_compound(source)
        if exact:return _lang.sentence_case(exact)
        clauses=cls._split_clauses(source)
        return " ".join(cls._realize_clause(c,concise=concise) for c in clauses).strip()

