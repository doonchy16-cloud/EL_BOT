"""Engine 24: deterministic 24-stage Emoji -> ABC translation engine."""

from __future__ import annotations

from dataclasses import replace
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import re
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_lang = _load("_el_language_foundation", _ROOT / "🧠" / "🧬")
_compounds = _load("_el_emoji_compounds", _ROOT / "📚" / "🧩")

TOTAL_STAGES = 24
STAGES = (
    "Input Integrity",
    "Grapheme Segmentation",
    "Canonical Membership Check",
    "Compound Boundary Detection",
    "Canonical Compound Resolution",
    "Canonical Individual Resolution",
    "Literal Unicode Suppression",
    "Sequence Structure Detection",
    "Relationship Detection",
    "Semantic Role Reconstruction",
    "Negation Reconstruction",
    "Severity Reconstruction",
    "Quantity Binding",
    "Temporal Reconstruction",
    "Direction Reconstruction",
    "Ambiguity Mapping",
    "Interpretation Tree Generation",
    "Sentence-Structure Generation",
    "Natural-Language Realization",
    "Glossary-Output Rejection",
    "Meaning Coverage Audit",
    "Hallucination Audit",
    "Round-Trip Verification",
    "Final Ranking + Winner Selection",
)

NUMBER_RE = re.compile(r"\d+(?:\.\d+)?")
CLAUSE_SPLIT_RE = re.compile(r"[.!?;\n]+")

_PROCESS_PATTERNS: tuple[tuple[tuple[str, ...], str], ...] = (
    (("📥", "🧪", "🧾", "✅", "🚀"), "Import the item, test and validate it, confirm that it passes, and then deploy it."),
    (("🧪", "🧾", "✅"), "Run diagnostics and validation, then confirm successful completion."),
    (("🔐", "🔒", "❌", "🔑"), "Keep the security boundary locked when the credential fails, authenticate the replacement credential, unlock access, and confirm success."),
    (("🔄", "📦", "‼️", "❤️‍🩹", "⚙️"), "Restart the package or container immediately to restore the core service."),
    (("📸", "🦙", "👁️"), "Use Ollama only for visual observation of the screenshot."),
)


class EmojiToABCEngine:
    """Translate canonical EL to natural language without a model/provider."""

    def __init__(self) -> None:
        self.stage_names = STAGES

    @staticmethod
    def _emit(index: int, enabled: bool) -> str:
        label = STAGES[index - 1]
        _lang.emit_stage(index, TOTAL_STAGES, "Emoji → ABC Engine — " + label, enabled)
        return label

    @staticmethod
    def _split_clauses(source: str) -> tuple[str, ...]:
        return tuple(part.strip() for part in CLAUSE_SPLIT_RE.split(source) if part.strip())

    @staticmethod
    def _symbols(clause: str) -> tuple[str, ...]:
        return _lang.canonical_symbols(clause)

    @staticmethod
    def _step_groups(clause: str) -> tuple[tuple[str, ...], ...]:
        parts = clause.split("➡️")
        groups: list[tuple[str, ...]] = []
        for part in parts:
            symbols = tuple(symbol for symbol in _lang.canonical_symbols(part) if symbol != "➡️")
            if symbols:
                groups.append(symbols)
        return tuple(groups)

    @staticmethod
    def _number_after_timer(clause: str) -> str | None:
        timer_index = clause.find("⏱️")
        if timer_index < 0:
            return None
        match = NUMBER_RE.search(clause, timer_index)
        return match.group(0) if match else None

    @staticmethod
    def _noun_phrase(symbols: tuple[str, ...]) -> str:
        entities = [_lang.ENTITY_PHRASES[symbol] for symbol in symbols if symbol in _lang.ENTITY_PHRASES]
        if entities:
            return ", ".join(dict.fromkeys(entities))
        values = [_lang.preferred_phrase(symbol) for symbol in symbols if not _lang.is_relation(symbol) and not _lang.is_status(symbol)]
        values = list(dict.fromkeys(values))
        return ", ".join(values[:4])

    @classmethod
    def _render_group(cls, symbols: tuple[str, ...]) -> str:
        if not symbols:
            return ""
        statuses = [_lang.STATUS_PHRASES[symbol] for symbol in symbols if symbol in _lang.STATUS_PHRASES]
        actions = [_lang.ACTION_PHRASES[symbol] for symbol in symbols if symbol in _lang.ACTION_PHRASES]
        entities = [_lang.ENTITY_PHRASES[symbol] for symbol in symbols if symbol in _lang.ENTITY_PHRASES and symbol not in _lang.ACTION_PHRASES]
        others = [
            _lang.preferred_phrase(symbol)
            for symbol in symbols
            if symbol not in _lang.STATUS_PHRASES
            and symbol not in _lang.ACTION_PHRASES
            and symbol not in _lang.ENTITY_PHRASES
            and not _lang.is_relation(symbol)
        ]
        statuses = list(dict.fromkeys(statuses))
        actions = list(dict.fromkeys(actions))
        entities = list(dict.fromkeys(entities))
        others = list(dict.fromkeys(others))

        if actions:
            verb = actions[0]
            obj = entities[0] if entities else (others[0] if others else "the current item")
            phrase = f"{verb} {obj}"
            if len(actions) > 1:
                phrase += " and " + " and ".join(actions[1:3])
            if statuses:
                phrase += " while it is " + " and ".join(statuses[:2])
            return phrase

        if statuses and entities:
            return f"the {entities[0]} is " + " and ".join(statuses[:2])
        if statuses:
            return "the current state is " + " and ".join(statuses[:3])
        if entities:
            return entities[0] if len(entities) == 1 else ", ".join(entities[:3])
        if others:
            return others[0] if len(others) == 1 else ", ".join(others[:3])
        return ""

    @classmethod
    def _pattern_sentence(cls, clause: str, symbols: tuple[str, ...]) -> str | None:
        symbol_set = set(symbols)
        for required, sentence in _PROCESS_PATTERNS:
            if all(symbol in symbol_set for symbol in required):
                return sentence

        if "🔴" in symbol_set and "❌" in symbol_set:
            timer = cls._number_after_timer(clause)
            entity_bits = [value for value in symbols if value in {"🗃️", "🔌", "📡", "⚙️", "📦"}]
            subject = cls._noun_phrase(tuple(entity_bits)) or "system"
            parts = [
                f"A critical failure affected the {subject}"
                + (f" after a {timer}-second timeout" if timer else "")
                + "."
            ]
            if "💥" in symbol_set and "📴" in symbol_set:
                parts.append("The server or event system crashed and went offline.")
            if "🔄" in symbol_set:
                urgency = " immediately" if "‼️" in symbol_set or "❗" in symbol_set else ""
                target = "package or container" if "📦" in symbol_set else "service"
                parts.append(f"Restart the {target}{urgency}.")
            if "❤️‍🩹" in symbol_set or "🧯" in symbol_set:
                parts.append("Restore the core service and recover it safely.")
            if "🧪" in symbol_set or "🧾" in symbol_set:
                parts.append("Run diagnostics and validation before confirming completion.")
            return " ".join(parts)

        if {"🔐", "🔒", "❌", "🔑"}.issubset(symbol_set):
            return "Keep the security system locked when the credential fails, authenticate the replacement credential, unlock access, and confirm success."

        if {"📡", "💥", "📴"}.issubset(symbol_set):
            return "The server or event system crashed and went offline."

        if {"🔄", "📦", "‼️"}.issubset(symbol_set):
            return "Restart the package or container immediately."

        if {"🖤", "🔘", "📊"}.issubset(symbol_set):
            return "Provide a dark-mode toggle on the dashboard."

        return None

    @classmethod
    def _realize_clause(cls, clause: str, *, concise: bool = False) -> str:
        exact = _compounds.lookup_compound(clause)
        if exact:
            return _lang.sentence_case(exact)

        symbols = cls._symbols(clause)
        if not symbols:
            return "The input contains no canonical EL concepts."

        pattern = cls._pattern_sentence(clause, symbols)
        if pattern:
            return pattern

        groups = cls._step_groups(clause)
        if len(groups) >= 2:
            rendered = [cls._render_group(group) for group in groups]
            rendered = [item for item in rendered if item]
            if not rendered:
                return "The input contains canonical EL concepts but no reconstructable statement."
            if concise:
                if len(rendered) == 1:
                    return _lang.sentence_case(rendered[0])
                return _lang.sentence_case(", ".join(rendered[:-1]) + ", and " + rendered[-1])
            if len(rendered) == 2:
                return _lang.sentence_case(rendered[0] + "; then " + rendered[1])
            if len(rendered) <= 5:
                return _lang.sentence_case("; ".join(rendered[:-1]) + "; finally, " + rendered[-1])
            first = "; ".join(rendered[:3])
            middle = "; ".join(rendered[3:-1])
            tail = rendered[-1]
            if middle:
                return _lang.sentence_case(first + ". The workflow continues with " + middle + ". It finishes by " + tail)
            return _lang.sentence_case(first + ". It finishes by " + tail)

        phrase = cls._render_group(symbols)
        if phrase:
            return _lang.sentence_case(phrase)
        return "The input contains canonical EL concepts but no reconstructable statement."

    @classmethod
    def _realize_document(cls, source: str, *, concise: bool = False) -> str:
        exact = _compounds.lookup_compound(source)
        if exact:
            return _lang.sentence_case(exact)
        clauses = cls._split_clauses(source)
        sentences = [cls._realize_clause(clause, concise=concise) for clause in clauses]
        return " ".join(sentence for sentence in sentences if sentence).strip()

    @staticmethod
    def _glossary_like(value: str) -> bool:
        lowered = value.lower()
        return (
            " | " in value
            or " = " in value
            or lowered.startswith("the el sequence communicates")
            or lowered.startswith("symbol ")
            or lowered.count("meaning") >= 2
        )

    @staticmethod
    def _hallucination_score(source_symbols: tuple[str, ...], value: str) -> float:
        candidate_signature = _lang.concept_signature_from_abc(value)
        if not candidate_signature:
            return 0.0
        source_set = set(source_symbols)
        extra = sum(1 for symbol in candidate_signature if symbol not in source_set)
        return max(0.0, 1.0 - extra / max(1, len(candidate_signature)))

    def translate(
        self,
        source: str,
        *,
        verifier=None,
        preference_counts: dict[str, int] | None = None,
        cross_verify: bool = True,
        emit: bool = True,
    ):
        stages: list[str] = []
        metrics: dict[str, float | int | str] = {}
        preference_counts = preference_counts or {}

        stages.append(self._emit(1, emit))
        if not isinstance(source, str) or not source.strip():
            candidate = _lang.Candidate("Unable to translate empty input.", 0.0, ("empty-input",), 0.0, 0.0)
            return _lang.EngineResult(1, source if isinstance(source, str) else "", (candidate,), tuple(stages), {"status": "hold"})
        normalized = source.strip()

        stages.append(self._emit(2, emit))
        graphemes = _lang._core.split_graphemes(normalized)
        metrics["graphemes"] = len(graphemes)

        stages.append(self._emit(3, emit))
        canonical = tuple(value for value in graphemes if value in _lang.MEANING_BY_SYMBOL)
        unknown = tuple(value for value in graphemes if any(ord(ch) > 127 for ch in value) and value not in _lang.MEANING_BY_SYMBOL and not value.isspace())
        metrics["canonical"] = len(canonical)
        metrics["unknown"] = len(unknown)

        stages.append(self._emit(4, emit))
        compound_exact = _compounds.lookup_compound(normalized)
        metrics["compound_boundaries"] = 1 if compound_exact else 0

        stages.append(self._emit(5, emit))
        compound_sentence = _lang.sentence_case(compound_exact) if compound_exact else ""

        stages.append(self._emit(6, emit))
        resolved_meanings = tuple(_lang.MEANING_BY_SYMBOL[symbol] for symbol in canonical)
        metrics["resolved"] = len(resolved_meanings)

        stages.append(self._emit(7, emit))
        metrics["literal_unicode_used"] = 0

        stages.append(self._emit(8, emit))
        clauses = self._split_clauses(normalized)
        metrics["clauses"] = len(clauses)

        stages.append(self._emit(9, emit))
        metrics["relations"] = sum(1 for symbol in canonical if _lang.is_relation(symbol))

        stages.append(self._emit(10, emit))
        metrics["actions"] = sum(1 for symbol in canonical if _lang.is_action(symbol))
        metrics["entities"] = sum(1 for symbol in canonical if symbol in _lang.ENTITY_PHRASES)

        stages.append(self._emit(11, emit))
        metrics["negations"] = canonical.count("❌") + canonical.count("⛔")

        stages.append(self._emit(12, emit))
        metrics["severity"] = sum(1 for symbol in canonical if symbol in {"🔴", "⚠️", "❌", "🟡", "🚧", "🛑"})

        stages.append(self._emit(13, emit))
        numbers = tuple(NUMBER_RE.findall(normalized))
        metrics["numbers"] = len(numbers)

        stages.append(self._emit(14, emit))
        metrics["temporal"] = sum(1 for clause in clauses if "⏱️" in clause or "⏳" in clause or "⌛" in clause)

        stages.append(self._emit(15, emit))
        metrics["directional"] = sum(1 for symbol in canonical if symbol in {"➡️", "⬅️", "↔️", "↕️"})

        stages.append(self._emit(16, emit))
        metrics["branches"] = 1 + (0 if compound_sentence else 2)

        stages.append(self._emit(17, emit))
        interpretation_variants = ("faithful", "concise")
        metrics["interpretations"] = len(interpretation_variants)

        stages.append(self._emit(18, emit))
        structures: list[tuple[str, str]] = []
        if compound_sentence:
            structures.append((compound_sentence, "authority-compound"))
        structures.extend(
            (
                (self._realize_document(normalized, concise=False), "faithful-structure"),
                (self._realize_document(normalized, concise=True), "concise-structure"),
            )
        )

        stages.append(self._emit(19, emit))
        realized = [(value, reason) for value, reason in structures if value and len(value.split()) >= 3]

        stages.append(self._emit(20, emit))
        filtered = [(value, reason) for value, reason in realized if not self._glossary_like(value)]
        if not filtered:
            filtered = [("Unable to reconstruct a grammatical sentence from the available canonical EL concepts.", "hold")]

        stages.append(self._emit(21, emit))
        source_signature = _lang.concept_signature_from_el(normalized)
        candidates: list[_lang.Candidate] = []
        for order, (value, reason) in enumerate(filtered):
            candidate_signature = _lang.concept_signature_from_abc(value)
            score, coverage, order_score = _lang.score_candidate(source_signature, candidate_signature, base=max(0.0, 14.0 - order))
            candidates.append(
                _lang.Candidate(value, score, (reason, "meaning-coverage", f"order:{order_score:.3f}"), coverage, 0.0)
            )

        stages.append(self._emit(22, emit))
        audited: list[_lang.Candidate] = []
        for candidate in candidates:
            hallucination = self._hallucination_score(source_signature, candidate.value)
            audited.append(
                replace(
                    candidate,
                    score=candidate.score + 16.0 * hallucination,
                    reasons=candidate.reasons + (f"hallucination-audit:{hallucination:.3f}",),
                )
            )

        stages.append(self._emit(23, emit))
        verified: list[_lang.Candidate] = []
        if cross_verify and verifier is not None:
            for candidate in audited:
                try:
                    reverse = verifier.translate(candidate.value, cross_verify=False, emit=False)
                    reverse_signature = _lang.concept_signature_from_el(reverse.winner)
                    similarity = _lang.multiset_similarity(source_signature, reverse_signature)
                except Exception:
                    similarity = 0.0
                verified.append(_lang.apply_roundtrip(candidate, similarity))
        else:
            verified = [replace(item, roundtrip=1.0) for item in audited]

        stages.append(self._emit(24, emit))
        final_rows: list[_lang.Candidate] = []
        for candidate in verified:
            observed = int(preference_counts.get(candidate.value, 0))
            if observed:
                candidate = replace(
                    candidate,
                    score=candidate.score + min(40.0, observed * 8.0),
                    reasons=candidate.reasons + ("observed-user-choice",),
                )
            final_rows.append(candidate)
        ranked = _lang.sort_candidates(final_rows)
        metrics["candidates"] = len(ranked)
        metrics["coverage"] = ranked[0].coverage if ranked else 0.0
        metrics["roundtrip"] = ranked[0].roundtrip if ranked else 0.0
        return _lang.EngineResult(1, normalized, ranked, tuple(stages), metrics)

    def process(self, source: str) -> str:
        return self.translate(source, cross_verify=False, emit=False).winner

    def render_el_status(self) -> str:
        return "✅😀➡️🔤24"
