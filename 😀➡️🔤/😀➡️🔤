def _looks_investigable_emoji(value:str)->bool:
    if not value:return False
    if "\u200d" in value or "\u20e3" in value:return True
    for char in value:
        if char in {"\ufe0e","\ufe0f"}:continue
        if unicodedata.category(char) in {"So","Sk","Sm"}:return True
    return False


def _unicode_gloss(value:str)->str:
    names=[]
    for char in value:
        if char in {"\ufe0e","\ufe0f","\u200d","\u20e3"}:continue
        name=unicodedata.name(char,"").lower()
        if not name or name.startswith("variation selector") or name=="zero width joiner":continue
        name=name.replace("emoji modifier fitzpatrick type-1-2","light skin tone")
        name=name.replace("emoji modifier fitzpatrick type-3","medium-light skin tone")
        name=name.replace("emoji modifier fitzpatrick type-4","medium skin tone")
        name=name.replace("emoji modifier fitzpatrick type-5","medium-dark skin tone")
        name=name.replace("emoji modifier fitzpatrick type-6","dark skin tone")
        if name not in names:names.append(name)
    return " + ".join(names)


def _unicode_sentence(rows:tuple[tuple[str,str],...])->str:
    glosses=[gloss for _unit,gloss in rows if gloss]
    if not glosses:return ""
    if len(glosses)==1:return "The emoji represents "+glosses[0]+"."
    return "The emoji sequence contains "+", ".join(glosses[:-1])+", and "+glosses[-1]+"."


