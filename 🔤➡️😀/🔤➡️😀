"""Engine 23: deterministic 24-stage ABC -> Emoji translation engine."""
from __future__ import annotations

from dataclasses import replace
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader=SourceFileLoader(name,str(path));spec=spec_from_loader(name,loader)
    if spec is None:raise RuntimeError("module spec unavailable")
    module=module_from_spec(spec);sys.modules[name]=module;loader.exec_module(module);return module


_ROOT=Path(__file__).resolve().parent.parent
_lang=_load("_el_language_foundation",_ROOT/"🧠"/"🧬")
_compounds=_load("_el_abc_compounds",_ROOT/"📚"/"🧩")
TOTAL_STAGES=24
STAGES=(
    "Input Integrity","Structural Segmentation","Tokenization","Phrase Detection","Canonical Phrase Lookup","Linguistic Normalization","Semantic Concept Extraction","Semantic Role Assignment","Relationship Extraction","Negation Detection","Severity Detection","Quantity + Number Binding","Temporal Analysis","Direction + Order Analysis","Canonical Symbol Resolution","Compound Resolution","Ambiguity Expansion","Candidate Construction","Hard Constraint Filtering","Meaning Coverage Audit","Grammar + Relationship Audit","Information-Loss Score","Round-Trip Verification","Final Ranking + Winner Selection",
)
_REVERSE_COMPOUNDS={meaning.lower():source for source,meaning in _compounds.COMPOUND_MEANINGS.items()}
_RELATION_MARKERS={"➡️","⬅️","↔️","➕","🔀","🚦","🔗","🚦➡️","🚦⬅️","🚦❌","🔗➡️"}
_CRITICAL_SYMBOLS={"🔴","❌","⚠️","📴","💥","🔄","‼️","❗","🧪","🧾","🔐","🔒","🔓","🛂","✅","🟢","⛔","❤️‍🩹","🧯"}


class ABCToEmojiEngine:
    """Translate natural language to canonical EL with zero provider/model calls."""
    def __init__(self)->None:self.stage_names=STAGES

    @staticmethod
    def _emit(index:int,enabled:bool)->str:
        label=STAGES[index-1];_lang.emit_stage(index,TOTAL_STAGES,"ABC → Emoji Engine — "+label,enabled);return label

    @staticmethod
    def _ordered_clause_items(clause)->list[tuple[int,int,str,str]]:
        temporal=tuple(b for b in clause.numbers if b.unit in _lang.TEMPORAL_UNIT_SYMBOLS)
        rows=[]
        for concept in clause.concepts:
            # A bound duration already carries the timer concept. Avoid detached/duplicate ⏱️.
            if concept.symbol=="⏱️" and temporal:continue
            rows.append((concept.start,concept.end,"concept",concept.symbol))
        for number in clause.numbers:rows.append((number.start,number.end,"number",number.el))
        for relation in clause.relations:rows.append((relation.position,relation.position+len(relation.phrase),"relation",relation.marker))
        rows.sort(key=lambda row:(row[0],0 if row[2]=="relation" else 1 if row[2]=="concept" else 2,row[1]))
        return rows

    @classmethod
    def _clause_to_el(cls,clause,*,compact:bool=False)->str:
        rows=cls._ordered_clause_items(clause)
        if not rows:return "🟡❓"
        out=[];seen=set();last_span=None;last_kind=""
        for start,end,kind,value in rows:
            if compact and kind=="concept" and value in seen and value not in _CRITICAL_SYMBOLS:continue
            if kind=="concept":seen.add(value)
            same_span=last_span==(start,end)
            if not out:
                out.append(value)
            elif kind=="relation":
                if out[-1] in _RELATION_MARKERS:out[-1]=value
                else:out.append(value)
            elif same_span and last_kind=="concept":
                if out[-1] not in _RELATION_MARKERS:out.append("➕")
                out.append(value)
            else:
                if out[-1] not in _RELATION_MARKERS:out.append("➡️")
                out.append(value)
            last_span=(start,end);last_kind=kind
        content_count=_lang.content_word_count(clause.source)
        density=len(clause.unknown_words)/max(1,content_count)
        if clause.unknown_words and not clause.concepts:out.extend(("➡️","🟡","➡️","❓"))
        elif len(clause.unknown_words)>=2 and density>=.34:out.extend(("➡️","🟡","➡️","❓"))
        return "".join(_lang.dedupe_adjacent(out))

    @classmethod
    def _document_candidate(cls,document,*,compact:bool=False)->str:
        return ". ".join(cls._clause_to_el(c,compact=compact) for c in document.clauses) if document.clauses else "🟡❓"

    @staticmethod
    def _expected_signature(document)->tuple[str,...]:
        return tuple(c.symbol for clause in document.clauses for c in clause.concepts if c.symbol not in {"➡️","➕"})

    @staticmethod
    def _number_integrity(document,value:str)->float:
        bindings=tuple(binding for clause in document.clauses for binding in clause.numbers)
        if not bindings:return 1.0
        return sum(1 for binding in bindings if binding.el in value)/len(bindings)

    @staticmethod
    def _relation_integrity(document,value:str)->float:
        expected=[r for c in document.clauses for r in c.relations if r.kind!="and"]
        if not expected:return 1.0
        matched=0
        for relation in expected:
            marker=relation.marker
            if marker in value:matched+=1;continue
            # Conservative fallbacks only when the exact compound marker cannot be found.
            if marker=="🚦➡️" and "🚦" in value and "➡️" in value:matched+=.6
            elif marker=="🚦⬅️" and "🚦" in value and "⬅️" in value:matched+=.6
            elif marker=="🚦❌" and "🚦" in value and "❌" in value:matched+=.6
            elif marker=="🔗➡️" and "🔗" in value and "➡️" in value:matched+=.6
        return matched/len(expected)

    @staticmethod
    def _critical_integrity(document,value:str)->float:
        expected=[c.symbol for clause in document.clauses for c in clause.concepts if c.symbol in _CRITICAL_SYMBOLS]
        if not expected:return 1.0
        actual=list(_lang.canonical_symbols(value));used=[];retained=0
        for symbol in expected:
            try:
                idx=next(i for i,s in enumerate(actual) if s==symbol and i not in used)
            except StopIteration:continue
            used.append(idx);retained+=1
        return retained/len(expected)

    @staticmethod
    def _role_integrity(document,value:str)->float:
        expected=[role.symbol for clause in document.clauses for role in clause.roles if role.kind in {"actor","action","object","state"}]
        if len(expected)<2:return 1.0
        actual=_lang.concept_signature_from_el(value)
        return _lang.order_similarity(tuple(expected),actual)

    def translate(self,source:str,*,verifier=None,preference_counts:dict[str,int]|None=None,cross_verify:bool=True,emit:bool=True):
        stages=[];metrics={};preference_counts=preference_counts or {}
        stages.append(self._emit(1,emit))
        if not isinstance(source,str) or not source.strip():
            c=_lang.Candidate("🟡❓",0.0,("empty-input",),0.0,0.0)
            return _lang.EngineResult(2,source if isinstance(source,str) else "",(c,),tuple(stages),{"status":"hold","quality_status":"fail"})

        stages.append(self._emit(2,emit));sentences=_lang.split_sentences(source);metrics["clauses"]=len(sentences)
        stages.append(self._emit(3,emit));tokens=tuple(_lang.WORD_RE.findall(source));metrics["tokens"]=len(tokens)
        stages.append(self._emit(4,emit));phrase_matches=tuple(_lang.match_concepts(s) for s in sentences);metrics["phrase_matches"]=sum(len(r) for r in phrase_matches)
        stages.append(self._emit(5,emit));metrics["authority_matches"]=sum(1 for row in phrase_matches for item in row if item.source.startswith("authority"))
        stages.append(self._emit(6,emit));normalized=_lang.normalize_text(source)
        stages.append(self._emit(7,emit));document=_lang.parse_abc_document(normalized);expected_signature=self._expected_signature(document);metrics["concepts"]=len(expected_signature)
        unknown_count=sum(len(c.unknown_words) for c in document.clauses);unknown_density=_lang.unknown_density(document);unresolved=_lang.unresolved_clause_count(document)
        metrics["unknown_count"]=unknown_count;metrics["unknown_density"]=round(unknown_density,4);metrics["unresolved_clauses"]=unresolved
        stages.append(self._emit(8,emit));metrics["actions"]=sum(1 for s in expected_signature if _lang.is_action(s));metrics["statuses"]=sum(1 for s in expected_signature if _lang.is_status(s));metrics["entities"]=sum(1 for s in expected_signature if s in _lang.ENTITY_PHRASES);metrics["roles"]=sum(len(c.roles) for c in document.clauses)
        stages.append(self._emit(9,emit));relations=tuple(r for c in document.clauses for r in c.relations);metrics["relations"]=len(relations)
        stages.append(self._emit(10,emit));metrics["negations"]=sum(1 for r in relations if r.kind in {"negation","unless"})
        stages.append(self._emit(11,emit));metrics["severity"]=sum(1 for s in expected_signature if s in {"🔴","❌","⚠️","🟡","🛑","🚧"})
        stages.append(self._emit(12,emit));bindings=tuple(b for c in document.clauses for b in c.numbers);metrics["numbers"]=len(bindings)
        stages.append(self._emit(13,emit));metrics["temporal"]=sum(1 for b in bindings if b.unit in _lang.TEMPORAL_UNIT_SYMBOLS)
        stages.append(self._emit(14,emit));metrics["directional"]=sum(1 for r in relations if r.kind in {"before","after","only_after","only_before","bidirectional","result","cause","until"})
        stages.append(self._emit(15,emit));metrics["canonical_resolved"]=sum(1 for s in expected_signature if s in _lang.MEANING_BY_SYMBOL)
        stages.append(self._emit(16,emit));exact_compound=_REVERSE_COMPOUNDS.get(normalized.lower());metrics["compound"]=1 if exact_compound else 0
        stages.append(self._emit(17,emit));metrics["branches"]=3+(1 if exact_compound else 0)

        stages.append(self._emit(18,emit));raw=[]
        if exact_compound:raw.append((exact_compound,"authority-compound"))
        faithful=self._document_candidate(document,compact=False);compact=self._document_candidate(document,compact=True)
        raw.extend(((faithful,"faithful-semantic"),(compact,"compact-semantic")))
        if faithful!=compact:raw.append((faithful,"relationship-preserving"))

        stages.append(self._emit(19,emit));valid=[(v,r) for v,r in raw if _lang.valid_el(v)] or [("🟡❓","hold")]
        stages.append(self._emit(20,emit));candidates=[]
        for order,(value,reason) in enumerate(valid):
            sig=_lang.concept_signature_from_el(value);score,coverage,order_score=_lang.score_candidate(expected_signature,sig,base=max(0.0,18.0-order))
            relation_score=self._relation_integrity(document,value);number_score=self._number_integrity(document,value);critical_score=self._critical_integrity(document,value);role_score=self._role_integrity(document,value)
            score+=34*relation_score+34*number_score+40*critical_score+22*role_score
            if bindings and number_score<1.0:score-=90
            if any(r.kind not in {"and"} for r in relations) and relation_score<.75:score-=85
            if critical_score<.80:score-=90
            candidates.append(_lang.Candidate(value,score,(reason,"meaning-coverage",f"order:{order_score:.3f}",f"relationship:{relation_score:.3f}",f"number-binding:{number_score:.3f}",f"critical:{critical_score:.3f}",f"roles:{role_score:.3f}"),coverage,0.0))

        stages.append(self._emit(21,emit));audited=list(candidates)
        stages.append(self._emit(22,emit));loss=[]
        for c in audited:
            q=c.value.count("❓");score=c.score-(unknown_density*105.0+unresolved*24.0+min(60.0,q*10.0))
            if c.value=="🟡❓" and expected_signature:score-=140
            loss.append(replace(c,score=score,reasons=c.reasons+(f"unknown-density:{unknown_density:.3f}",f"unknown-marks:{q}")))

        stages.append(self._emit(23,emit));verified=[]
        if cross_verify and verifier is not None:
            for c in loss:
                try:
                    reverse=verifier.translate(c.value,cross_verify=False,emit=False);reverse_signature=_lang.concept_signature_from_abc(reverse.winner);similarity=_lang.multiset_similarity(expected_signature,reverse_signature)
                except Exception:similarity=0.0
                verified.append(_lang.apply_roundtrip(c,similarity))
        else:verified=[replace(c,roundtrip=1.0) for c in loss]

        stages.append(self._emit(24,emit));final=[]
        for c in verified:
            observed=int(preference_counts.get(c.value,0))
            if observed:c=replace(c,score=c.score+min(32.0,observed*6.0),reasons=c.reasons+("observed-user-choice",))
            final.append(c)
        ranked=_lang.sort_candidates(final)
        metrics["candidates"]=len(ranked);metrics["coverage"]=ranked[0].coverage if ranked else 0.0;metrics["roundtrip"]=ranked[0].roundtrip if ranked else 0.0
        winner=ranked[0].value if ranked else "🟡❓";metrics["number_integrity"]=round(self._number_integrity(document,winner),4);metrics["relation_integrity"]=round(self._relation_integrity(document,winner),4);metrics["critical_integrity"]=round(self._critical_integrity(document,winner),4);metrics["role_integrity"]=round(self._role_integrity(document,winner),4)
        q=winner.count("❓")
        fail=(not ranked or (expected_signature and metrics["coverage"]<.55) or metrics["number_integrity"]<1.0 or metrics["relation_integrity"]<.70 or metrics["critical_integrity"]<.75 or unknown_density>=.48 or unresolved>=max(2,len(document.clauses)//2+1) or q>=max(4,len(document.clauses)//2+2))
        hold=(metrics["coverage"]<.86 or metrics["roundtrip"]<.78 or metrics["relation_integrity"]<.92 or metrics["critical_integrity"]<.92 or metrics["role_integrity"]<.75 or unknown_density>=.10 or q>0)
        metrics["quality_status"]="fail" if fail else "hold" if hold else "pass"
        return _lang.EngineResult(2,normalized,ranked,tuple(stages),metrics)

    def process(self,source:str)->str:return self.translate(source,cross_verify=False,emit=False).winner
    def render_el_status(self)->str:return "✅🔤➡️😀24"
