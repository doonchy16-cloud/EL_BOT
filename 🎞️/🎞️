"""Engine 17: deterministic EL Bot animation state."""

from __future__ import annotations


class AnimationEngine:
    """Own status frames and the canonical 180-degree processing flip."""

    def __init__(self) -> None:
        self._frames = ("⚪", "🔵", "🟢")
        self._processing_symbol = "⏳"
        self._terminal_states = ("⚪", "✅", "🟡", "❌")
        self._flip_degrees = 180

    @property
    def frames(self) -> tuple[str, ...]:
        return self._frames

    @property
    def processing_symbol(self) -> str:
        return self._processing_symbol

    @property
    def terminal_states(self) -> tuple[str, ...]:
        return self._terminal_states

    @property
    def flip_degrees(self) -> int:
        return self._flip_degrees

    def render(self) -> str:
        return "🎞️" + "➡️".join(self._frames)

    def process(self, text: str) -> str:
        if text == "🎞️":
            return self.render()
        if text == "⏳":
            return "🎞️⏳↪️180"
        return "🟡🎞️❓"

    def render_el_status(self) -> str:
        return "✅🎞️⏳180"
