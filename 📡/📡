"""Engine 10: deterministic EL event/signal telemetry.

Developer internals may use ordinary programming language. Every rendered event
is Emoji Language safe: no alphabetic letters are emitted to EL-facing output.
"""

from __future__ import annotations

from dataclasses import dataclass

import regex


_LETTER_RE = regex.compile(r"\p{L}")
_ALLOWED_STATUS = frozenset({"⚪", "🔵", "🟢", "🟡", "🔴", "🟣", "✅", "❌", "🚧", "⚠️", "🛑", "⛔", "📴"})


def _require_el_safe(value: str, label: str) -> str:
    if not isinstance(value, str):
        raise TypeError(f"{label} must be a string")
    if _LETTER_RE.search(value):
        raise ValueError(f"{label} must not contain alphabetic letters")
    return value


@dataclass(frozen=True, slots=True)
class Event:
    sequence: int
    marker: str
    status: str
    payload: tuple[str, ...] = ()

    def render_el(self) -> str:
        body = "".join(self.payload)
        return f"{self.sequence}:{self.marker}{self.status}{body}"


class EventEngine:
    """Append-only in-memory event stream for deterministic EL workflow telemetry."""

    def __init__(self) -> None:
        self._events: list[Event] = []

    @property
    def events(self) -> tuple[Event, ...]:
        return tuple(self._events)

    @property
    def latest(self) -> Event | None:
        return self._events[-1] if self._events else None

    def emit(self, marker: str, status: str = "🔵", *payload: str) -> Event:
        marker = _require_el_safe(marker, "marker")
        status = _require_el_safe(status, "status")
        if status not in _ALLOWED_STATUS:
            raise ValueError("unsupported event status")
        safe_payload = tuple(_require_el_safe(item, "payload") for item in payload)
        event = Event(
            sequence=len(self._events) + 1,
            marker=marker,
            status=status,
            payload=safe_payload,
        )
        self._events.append(event)
        return event

    def clear(self) -> None:
        self._events.clear()

    def render_el(self) -> str:
        if not self._events:
            return "⚪📡"
        return "\n".join(event.render_el() for event in self._events)

    def render_el_status(self) -> str:
        return f"✅📡{len(self._events)}"
