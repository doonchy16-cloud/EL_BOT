"""Engine 10: deterministic EL event/signal telemetry using Python standard library only."""

from __future__ import annotations
from dataclasses import dataclass
import unicodedata

_ALLOWED_STATUS = frozenset({"⚪", "🔵", "🟢", "🟡", "🔴", "🟣", "✅", "❌", "🚧", "⚠️", "🛑", "⛔", "📴"})


def _contains_letter(value: str) -> bool:
    return any(unicodedata.category(char).startswith("L") for char in value)


def _require_el_safe(value: str, label: str) -> str:
    if not isinstance(value, str):
        raise TypeError(f"{label} must be a string")
    if _contains_letter(value):
        raise ValueError(f"{label} must not contain alphabetic letters")
    return value


@dataclass(frozen=True, slots=True)
class Event:
    sequence: int
    marker: str
    status: str
    payload: tuple[str, ...] = ()

    def render_el(self) -> str:
        return f"{self.sequence}:{self.marker}{self.status}{''.join(self.payload)}"


class EventEngine:
    def __init__(self) -> None:
        self._events: list[Event] = []

    @property
    def events(self) -> tuple[Event, ...]:
        return tuple(self._events)

    @property
    def latest(self) -> Event | None:
        return self._events[-1] if self._events else None

    def emit(self, marker: str, status: str = "🔵", *payload: str) -> Event:
        marker = _require_el_safe(marker, "marker")
        status = _require_el_safe(status, "status")
        if status not in _ALLOWED_STATUS:
            raise ValueError("unsupported event status")
        safe_payload = tuple(_require_el_safe(item, "payload") for item in payload)
        event = Event(len(self._events) + 1, marker, status, safe_payload)
        self._events.append(event)
        return event

    def clear(self) -> None:
        self._events.clear()

    def render_el(self) -> str:
        if not self._events:
            return "⚪📡"
        return "\n".join(event.render_el() for event in self._events)

    def render_el_status(self) -> str:
        return f"✅📡{len(self._events)}"
