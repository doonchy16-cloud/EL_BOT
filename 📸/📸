#!/usr/bin/env python3
"""Screenshot/image interpretation bridge for EL Bot using local Ollama vision.

Mode 1 returns concise text.
Mode 2 returns canonical EL only.
"""

from __future__ import annotations

import base64
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys
import urllib.error


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_core = _load("_el_core", _ROOT / "⚙️" / "⚙️")
_vocab = _load("_el_vocab", _ROOT / "📚" / "📚")
_meanings = _load("_el_meanings", _ROOT / "📚" / "🧾")
_ollama = _load("_el_ollama", _ROOT / "🦙" / "🦙")

ValidationStatus = _core.ValidationStatus
CoreEngine = _core.CoreEngine
VocabularyEngine = _vocab.VocabularyEngine
OllamaConnector = _ollama.OllamaConnector

_SYMBOL_TO_MEANING = dict(zip(_vocab.CANONICAL_SYMBOLS, _meanings.PRIMARY_MEANINGS, strict=True))
_VISION_SYMBOLS = (
    "📸","👁️","🖥️","💻","📱","⌨️","🖱️","📷","📹","🖼️","🎥","🤖","🧠","🦙","⚙️","🎛️",
    "🔌","📡","🌐","🖧","📶","✅","❌","🟡","🔴","🔵","🟢","⚪","⚠️","❗","‼️","❓","🚨","🚧",
    "🛑","⛔","📴","🔒","🔓","🔐","🛡️","🧯","🔍","🔧","🛠️","🧰","🧪","🧾","📋","📄","📑","📂",
    "📁","🗃️","🗄️","💾","🗑️","🧹","📥","📤","⬅️","➡️","↔️","🔁","🔄","▶️","⏸️","⏹️","⏳","⏱️",
    "⚡","🐌","📊","📈","📉","🔘","🖤","🤍","👤","👥","🏠","🏢","🏭","📦","🚀","🏁","🔔","💬","📨",
    "📩","✉️","🔑","🆔","🔢","🔤","🔣","💥","❤️‍🩹","🪫","🔋","🌈","🎨","📐","📏","📍","💯","👍","👎"
)
_VISION_GLOSSARY = "\n".join(f"{symbol} = {_SYMBOL_TO_MEANING[symbol]}" for symbol in _VISION_SYMBOLS)
_ALLOWED = "".join(_vocab.CANONICAL_SYMBOLS)


def _strip_data_url(value: str) -> str:
    if value.startswith("data:"):
        marker = ";base64,"
        index = value.find(marker)
        if index < 0:
            raise ValueError("image data URL is not base64")
        return value[index + len(marker):]
    return value


def _valid_el(text: str) -> bool:
    if not text.strip():
        return False
    parsed = CoreEngine().parse(text, el_mode=True)
    if parsed.status is ValidationStatus.FAIL:
        return False
    return VocabularyEngine().resolve(parsed).status is ValidationStatus.PASS


def _debug_exception(exc: Exception) -> None:
    print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
    if isinstance(exc, urllib.error.HTTPError):
        try:
            body = exc.read().decode("utf-8", errors="replace")
        except Exception:
            body = ""
        if body:
            print(body[:4000], file=sys.stderr)


def _mode_prompt(mode: int) -> str:
    if mode == 1:
        return """Analyze the supplied screenshot/image visually and describe the important visible state in concise English.
This is Mode 1: visual evidence to text.
Prioritize visible errors, warnings, success states, UI state, controls, files, devices, people, relationships, and actionable evidence.
Do not invent hidden facts, causes, identities, or unseen state. If text is visibly readable, summarize it faithfully.
Return 1-5 short sentences, no markdown, under 140 words."""
    return f"""Analyze the supplied screenshot/image visually and convert the important visible evidence into canonical Emoji Language (EL).
This is Mode 2: visual evidence to emoji.
Output ONLY canonical EL symbols from the compact glossary below, plus digits, punctuation, arrows, and whitespace. Never output alphabetic letters or words.
Preserve visible error/warning/success state, UI/device/file relationships, direction, counts, and actions. Do not invent hidden facts.
If genuinely unclear, output 🟡📸❓. Keep the result concise and information-complete.

Compact visual EL glossary:
{_VISION_GLOSSARY}"""


def _correct_text_only(content: str) -> str:
    retry = f"""Convert the vision result below into strict canonical EL only.
No alphabetic letters. No non-canonical emoji. Do not add facts.
Allowed canonical symbols:
{_ALLOWED}
Vision result:
{content}
"""
    try:
        corrected = OllamaConnector(generation_timeout=60.0).generate_internal(retry).strip()
    except Exception as exc:
        _debug_exception(exc)
        return ""
    return corrected if _valid_el(corrected) else ""


def analyze(mode: int, image_value: str) -> str:
    if mode not in (1, 2):
        return "❌🔢"
    try:
        raw = _strip_data_url(image_value)
        base64.b64decode(raw, validate=True)
    except Exception:
        return "❌📸🔣"

    connector = OllamaConnector(generation_timeout=240.0)
    evidence = connector.probe()
    if not evidence.reachable:
        return "🟡📸🦙📡❓"
    if not evidence.model_present:
        return "🟡📸🦙❓"

    try:
        content = connector.chat_internal(_mode_prompt(mode), images=(raw,)).strip()
    except Exception as exc:
        _debug_exception(exc)
        return "🟡📸🦙❓"

    if not content:
        return "🟡📸❓"
    if mode == 1:
        return content
    if _valid_el(content):
        return content

    corrected = _correct_text_only(content)
    if corrected:
        return corrected
    return "🟡📸🦙🔤"


def main() -> int:
    payload = sys.stdin.read()
    if "\n" not in payload:
        print("❌🔢")
        return 0
    head, image_value = payload.split("\n", 1)
    try:
        mode = int(head.strip())
    except ValueError:
        print("❌🔢")
        return 0
    print(analyze(mode, image_value.strip()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
