#!/usr/bin/env python3
"""Screenshot observation boundary for EL Bot.

The model is allowed to observe screenshots only. It never performs EL
translation, candidate ranking or winner selection. Its structured observation
is handed to deterministic EL Bot code for conversion and ranking.
"""

from __future__ import annotations

import base64
from dataclasses import dataclass
from hashlib import sha256
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
from pathlib import Path
import sys
import urllib.error


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_ollama = _load("_el_vision_ollama", _ROOT / "🦙" / "🦙")
_rank = _load("_el_vision_rank", _ROOT / "🧠" / "🔀")
_translate = _load("_el_vision_translate", _ROOT / "↔️" / "↔️")
_ai_policy = _load("_el_ai_policy", _ROOT / "🔐" / "📸")

OllamaConnector = _ollama.OllamaConnector
SemanticRanker = _rank.SemanticRanker
TranslationEngine = _translate.TranslationEngine
AIUsePolicy = _ai_policy.AIUsePolicy


@dataclass(frozen=True, slots=True)
class VisionObservation:
    facts: tuple[str, ...] = ()
    visible_text: tuple[str, ...] = ()
    states: tuple[str, ...] = ()
    relationships: tuple[str, ...] = ()
    counts: tuple[str, ...] = ()

    def is_empty(self) -> bool:
        return not any((self.facts, self.visible_text, self.states, self.relationships, self.counts))

    def render_text(self) -> str:
        rows: list[str] = []
        if self.facts:
            rows.append("Visible facts: " + "; ".join(self.facts) + ".")
        if self.visible_text:
            rows.append("Visible text: " + " | ".join(self.visible_text) + ".")
        if self.states:
            rows.append("Visible states: " + "; ".join(self.states) + ".")
        if self.relationships:
            rows.append("Visible relationships: " + "; ".join(self.relationships) + ".")
        if self.counts:
            rows.append("Visible counts: " + "; ".join(self.counts) + ".")
        return " ".join(rows).strip()


def _strip_data_url(value: str) -> str:
    if value.startswith("data:"):
        marker = ";base64,"
        index = value.find(marker)
        if index < 0:
            raise ValueError("image data URL is not base64")
        return value[index + len(marker):]
    return value


def _debug_exception(exc: Exception) -> None:
    print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
    if isinstance(exc, urllib.error.HTTPError):
        try:
            body = exc.read().decode("utf-8", errors="replace")
        except Exception:
            body = ""
        if body:
            print(body[:4000], file=sys.stderr)


def _source_key(raw: str) -> str:
    return "📸#" + sha256(raw.encode("ascii", errors="ignore")).hexdigest()


def _observation_prompt() -> str:
    return """You are the screenshot observation sensor for EL Bot. You are NOT a translator.
Inspect only the supplied screenshot/image and report visible evidence as strict JSON only using this schema:
{"facts":["..."],"visible_text":["..."],"states":["..."],"relationships":["..."],"counts":["..."]}

Rules:
- Report atomic visible facts, not a final answer or translation.
- Do not output Emoji Language, candidate translations, rankings, scores or a winner.
- Do not infer hidden causes, hidden application state or unreadable text.
- Do not identify people.
- Preserve readable error/warning/success states, controls, devices, files, direction, counts and visible relationships.
- visible_text must contain only text actually readable in the image.
- Keep each list concise; omit uncertain items rather than guessing.
- Return JSON only."""


def _as_strings(value) -> tuple[str, ...]:
    if not isinstance(value, list):
        return ()
    out: list[str] = []
    for item in value:
        if not isinstance(item, str):
            continue
        clean = " ".join(item.strip().split())
        if clean and clean not in out:
            out.append(clean)
        if len(out) >= 24:
            break
    return tuple(out)


def _parse_observation(raw: str) -> VisionObservation:
    text = raw.strip()
    if not text:
        return VisionObservation()
    if text.startswith("```"):
        lines = text.splitlines()
        if lines and lines[0].startswith("```"):
            lines = lines[1:]
        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]
        text = "\n".join(lines).strip()
    payload = json.loads(text)
    if not isinstance(payload, dict):
        raise ValueError("vision observation must be a JSON object")
    return VisionObservation(
        facts=_as_strings(payload.get("facts")),
        visible_text=_as_strings(payload.get("visible_text")),
        states=_as_strings(payload.get("states")),
        relationships=_as_strings(payload.get("relationships")),
        counts=_as_strings(payload.get("counts")),
    )


def observe(image_value: str) -> tuple[str, VisionObservation | None, str | None]:
    raw = _strip_data_url(image_value)
    base64.b64decode(raw, validate=True)
    key = _source_key(raw)

    policy = AIUsePolicy()
    policy.require("📸")

    connector = OllamaConnector(generation_timeout=300.0)
    evidence = connector.probe()
    if not evidence.reachable:
        return key, None, "📡"
    if not evidence.model_present:
        return key, None, "🦙"

    try:
        answer = connector.chat_internal(_observation_prompt(), images=(raw,)).strip()
        observation = _parse_observation(answer)
        if observation.is_empty():
            return key, None, "❓"
        return key, observation, None
    except Exception as exc:
        _debug_exception(exc)
        return key, None, "❓"


def _unavailable_result(mode: int, key: str, reason: str):
    ranker = SemanticRanker()
    if mode == 1:
        message = {
            "📡": "Local screenshot vision is unreachable.",
            "🦙": "Local screenshot vision model is unavailable.",
            "❓": "The screenshot could not be observed reliably.",
        }.get(reason, "The screenshot could not be observed reliably.")
        return ranker.rank_text_candidates(key, [message])
    marker = {
        "📡": "🟡📸🦙📡❓",
        "🦙": "🟡📸🦙❓",
        "❓": "🟡📸❓",
    }.get(reason, "🟡📸❓")
    return ranker.rank_el_candidates(key, [marker], ())


def ranked_analyze(mode: int, image_value: str):
    if mode not in (1, 2):
        raise ValueError("invalid vision mode")
    key, observation, reason = observe(image_value)
    if observation is None:
        return key, _unavailable_result(mode, key, reason or "❓")

    observation_text = observation.render_text()
    if mode == 1:
        result = SemanticRanker().rank_text_candidates(key, [observation_text])
    else:
        result = TranslationEngine().ranked_to_el(observation_text)
    return key, result


def analyze(mode: int, image_value: str) -> str:
    try:
        _, result = ranked_analyze(mode, image_value)
    except Exception:
        return "❌📸🔣" if mode in (1, 2) else "❌🔢"
    return result.winner


def main() -> int:
    payload = sys.stdin.read()
    if "\n" not in payload:
        print("❌🔢")
        return 0
    head, image_value = payload.split("\n", 1)
    try:
        mode = int(head.strip())
    except ValueError:
        print("❌🔢")
        return 0
    try:
        key, result = ranked_analyze(mode, image_value.strip())
    except ValueError:
        print("❌📸🔣" if mode in (1, 2) else "❌🔢")
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "🔀":
        payload_out = result.as_dict()
        payload_out["source_key"] = key
        print(json.dumps(payload_out, ensure_ascii=False, separators=(",", ":")))
    else:
        print(result.winner)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
