#!/usr/bin/env python3
"""Ranked screenshot/image interpretation bridge using local Ollama vision.

Mode 1 returns ranked text interpretations.
Mode 2 returns ranked canonical EL interpretations.
Default CLI output remains the winning value; 🔀 returns structured candidates.
"""

from __future__ import annotations

import base64
from hashlib import sha256
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
from pathlib import Path
import sys
import urllib.error


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_vocab = _load("_el_vision_vocab", _ROOT / "📚" / "📚")
_meanings = _load("_el_vision_meanings", _ROOT / "📚" / "🧾")
_ollama = _load("_el_vision_ollama", _ROOT / "🦙" / "🦙")
_rank = _load("_el_vision_rank", _ROOT / "🧠" / "🔀")

OllamaConnector = _ollama.OllamaConnector
SemanticRanker = _rank.SemanticRanker

_SYMBOL_TO_MEANING = dict(zip(_vocab.CANONICAL_SYMBOLS, _meanings.PRIMARY_MEANINGS, strict=True))
_VISION_SYMBOLS = (
    "📸","👁️","🖥️","💻","📱","⌨️","🖱️","📷","📹","🖼️","🎥","🤖","🧠","🦙","⚙️","🎛️",
    "🔌","📡","🌐","🖧","📶","✅","❌","🟡","🔴","🔵","🟢","⚪","⚠️","❗","‼️","❓","🚨","🚧",
    "🛑","⛔","📴","🔒","🔓","🔐","🛡️","🧯","🔍","🔧","🛠️","🧰","🧪","🧾","📋","📄","📑","📂",
    "📁","🗃️","🗄️","💾","🗑️","🧹","📥","📤","⬅️","➡️","↔️","🔁","🔄","▶️","⏸️","⏹️","⏳","⏱️",
    "⚡","🐌","📊","📈","📉","🔘","🖤","🤍","👤","👥","🏠","🏢","🏭","📦","🚀","🏁","🔔","💬","📨",
    "📩","✉️","🔑","🆔","🔢","🔤","🔣","💥","❤️‍🩹","🪫","🔋","🌈","🎨","📐","📏","📍","💯","👍","👎"
)
_VISION_GLOSSARY = "\n".join(f"{symbol} = {_SYMBOL_TO_MEANING[symbol]}" for symbol in _VISION_SYMBOLS)


def _strip_data_url(value: str) -> str:
    if value.startswith("data:"):
        marker = ";base64,"
        index = value.find(marker)
        if index < 0:
            raise ValueError("image data URL is not base64")
        return value[index + len(marker):]
    return value


def _debug_exception(exc: Exception) -> None:
    print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
    if isinstance(exc, urllib.error.HTTPError):
        try:
            body = exc.read().decode("utf-8", errors="replace")
        except Exception:
            body = ""
        if body:
            print(body[:4000], file=sys.stderr)


def _source_key(raw: str) -> str:
    return "📸#" + sha256(raw.encode("ascii", errors="ignore")).hexdigest()


def _candidate_prompt(mode: int) -> str:
    if mode == 1:
        return """Analyze the supplied screenshot/image and generate the plausible interpretations supported by visible evidence.
Return strict JSON only: {\"candidates\":[{\"value\":\"...\"}]}.
Generate up to 8 materially different interpretations only where ambiguity is real. Put the strongest evidence-supported interpretation first.
Prioritize visible errors, warnings, success states, UI state, controls, files, devices, relationships and actionable evidence.
Do not identify people. Do not invent hidden causes, state or unreadable text. Return each candidate as 1-5 concise sentences under 140 words."""
    return f"""Analyze the supplied screenshot/image and generate plausible canonical Emoji Language interpretations of the visible evidence.
Return strict JSON only: {{\"candidates\":[{{\"value\":\"...\"}}]}}.
Generate up to 8 materially different candidates only where ambiguity is real. Put the strongest evidence-supported interpretation first.
Candidate values must contain ONLY canonical EL symbols from the glossary below plus digits, punctuation, arrows and whitespace. Never use alphabetic words.
Preserve visible error/warning/success state, UI/device/file relationships, direction, counts and actions. Do not invent hidden facts. Avoid meaningless repetition.

Compact visual EL glossary:
{_VISION_GLOSSARY}"""


def _single_prompt(mode: int) -> str:
    if mode == 1:
        return """Analyze the supplied screenshot/image visually and describe only the important visible state in concise English. Do not invent hidden facts or unreadable text. Return 1-5 short sentences under 140 words."""
    return f"""Convert the important visible evidence in the supplied screenshot/image into canonical Emoji Language. Output ONLY canonical EL symbols from this glossary plus digits, punctuation, arrows and whitespace. Avoid repetition. If genuinely unclear output 🟡📸❓.\n{_VISION_GLOSSARY}"""


def ranked_analyze(mode: int, image_value: str):
    if mode not in (1, 2):
        raise ValueError("invalid vision mode")
    raw = _strip_data_url(image_value)
    base64.b64decode(raw, validate=True)
    key = _source_key(raw)

    connector = OllamaConnector(generation_timeout=300.0)
    evidence = connector.probe()
    if not evidence.reachable:
        candidates = ["🟡📸🦙📡❓"] if mode == 2 else ["Local vision provider is unreachable."]
    elif not evidence.model_present:
        candidates = ["🟡📸🦙❓"] if mode == 2 else ["Local vision model is unavailable."]
    else:
        candidates: list[str] = []
        try:
            raw_answer = connector.chat_internal(_candidate_prompt(mode), images=(raw,)).strip()
            candidates.extend(_rank._extract_json_candidates(raw_answer))
        except Exception as exc:
            _debug_exception(exc)
        if not candidates:
            try:
                single = connector.chat_internal(_single_prompt(mode), images=(raw,)).strip()
                if single:
                    candidates.append(single)
            except Exception as exc:
                _debug_exception(exc)

    ranker = SemanticRanker()
    if mode == 1:
        result = ranker.rank_text_candidates(key, candidates or ["Unable to interpret visible evidence."])
    else:
        valid = [value for value in candidates if _rank.valid_el(value)]
        if not valid:
            valid = ["🟡📸❓"]
        result = ranker.rank_el_candidates(key, valid, ())
    return key, result


def analyze(mode: int, image_value: str) -> str:
    try:
        _, result = ranked_analyze(mode, image_value)
    except Exception:
        return "❌📸🔣" if mode in (1, 2) else "❌🔢"
    return result.winner


def main() -> int:
    payload = sys.stdin.read()
    if "\n" not in payload:
        print("❌🔢")
        return 0
    head, image_value = payload.split("\n", 1)
    try:
        mode = int(head.strip())
    except ValueError:
        print("❌🔢")
        return 0
    try:
        key, result = ranked_analyze(mode, image_value.strip())
    except ValueError:
        print("❌📸🔣" if mode in (1, 2) else "❌🔢")
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "🔀":
        payload_out = result.as_dict()
        payload_out["source_key"] = key
        print(json.dumps(payload_out, ensure_ascii=False, separators=(",", ":")))
    else:
        print(result.winner)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
