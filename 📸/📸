def _load(name:str,path:Path):
    if name in sys.modules:return sys.modules[name]
    loader=SourceFileLoader(name,str(path));spec=spec_from_loader(name,loader)
    if spec is None:raise RuntimeError("module spec unavailable")
    module=module_from_spec(spec);sys.modules[name]=module;loader.exec_module(module);return module

_ROOT=Path(__file__).resolve().parent.parent
_ollama=_load("_el_vision_ollama",_ROOT/"🦙"/"🦙")
_lang=_load("_el_vision_language",_ROOT/"🧠"/"🧬")
_abc=_load("_el_vision_abc",_ROOT/"🔤➡️😀"/"🔤➡️😀")
_emoji=_load("_el_vision_emoji",_ROOT/"😀➡️🔤"/"😀➡️🔤")
OllamaConnector=_ollama.OllamaConnector;ABCToEmojiEngine=_abc.ABCToEmojiEngine;EmojiToABCEngine=_emoji.EmojiToABCEngine

_FACT_FIELDS=("visible_text","objects","controls","states","relationships")
_FIELD_LIMITS={"visible_text":6,"objects":5,"controls":5,"states":4,"relationships":4}
_KEY_ALIASES={
    "visibletext":"visible_text","text":"visible_text","readable_text":"visible_text","readabletext":"visible_text",
    "object":"objects","visible_objects":"objects","visibleobjects":"objects",
    "control":"controls","ui_controls":"controls","uicontrols":"controls",
    "state":"states","visible_states":"states","visiblestates":"states",
    "relationship":"relationships","relations":"relationships","visible_relationships":"relationships",
}
