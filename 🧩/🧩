@dataclass(frozen=True, slots=True)
class SemanticComponent:
    role: str
    concept: str
    weight: float = 1.0


@dataclass(frozen=True, slots=True)
class SemanticRelation:
    source: str
    relation: str
    target: str


@dataclass(frozen=True, slots=True)
class ConceptDecomposition:
    source: str
    normalized: str
    sense_id: str
    components: tuple[SemanticComponent, ...]
    relations: tuple[SemanticRelation, ...]
    resolved: bool
    confidence: float
    reason: str

    @property
    def concept_keys(self) -> tuple[str, ...]:
        return tuple(dict.fromkeys(item.concept for item in self.components))


