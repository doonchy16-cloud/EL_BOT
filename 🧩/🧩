class ConceptDecompositionEngine:
    """Break a resolved sense into semantic components; never selects emoji."""

    def __init__(self) -> None:
        self.context = _context.ContextSenseDisambiguationEngine()
        self.graph = _graph.SemanticGraphEngine()

    def decompose(self, term: str, context: str = "") -> ConceptDecomposition:
        decision = self.context.resolve(term, context)
        if not decision.resolved:
            return ConceptDecomposition(term, decision.normalized, decision.sense_id, (), (), False, 0.0, decision.reason)

        template = _TEMPLATES.get(decision.sense_id)
        if template is not None:
            components, relations = template
            return ConceptDecomposition(term, decision.normalized, decision.sense_id, components, relations, True, decision.confidence, decision.reason)

        if decision.sense_id == "generic-tool":
            components = (
                SemanticComponent("entity", "tool", 0.8),
                SemanticComponent("action", decision.concept, 0.8),
            )
            return ConceptDecomposition(term, decision.normalized, decision.sense_id, components, (), True, decision.confidence, decision.reason)

        node = self.graph.node(decision.concept)
        if node is not None:
            return ConceptDecomposition(term, decision.normalized, decision.sense_id, (SemanticComponent(node.kind, node.key, 1.0),), (), True, decision.confidence, decision.reason)

        return ConceptDecomposition(term, decision.normalized, decision.sense_id, (), (), False, 0.0, "resolved-sense-without-decomposition")

    def decompose_terms(self, terms: tuple[str, ...] | list[str], context: str = "") -> tuple[ConceptDecomposition, ...]:
        results: list[ConceptDecomposition] = []
        seen: set[tuple[str, str]] = set()
        for term in terms:
            item = self.decompose(term, context)
            key = (item.normalized, item.sense_id)
            if key in seen:
                continue
            seen.add(key)
            results.append(item)
        return tuple(results)

    def semantic_terms(self, decomposition: ConceptDecomposition) -> tuple[str, ...]:
        terms: list[str] = []
        for component in decomposition.components:
            expanded = self.graph.semantic_terms(component.concept, depth=2)
            if expanded:
                terms.extend(expanded)
            else:
                terms.extend(component.concept.replace("-", " ").split())
        return tuple(dict.fromkeys(term.lower() for term in terms if term))

    def render_el_status(self) -> str:
        return "✅🧩"
