SEMANTIC_BASE_SYMBOLS: tuple[str, ...] = _core.split_graphemes(_SEMANTIC_SEED_STREAM)
if not SEMANTIC_BASE_SYMBOLS or len(set(SEMANTIC_BASE_SYMBOLS)) != len(SEMANTIC_BASE_SYMBOLS):
    raise RuntimeError("EL semantic seed invariant violated")

# Backward-compatible name for engines whose meanings are tied to the semantic seed.
# New code must not interpret len(CANONICAL_SYMBOLS) as the Unicode emoji count.
CANONICAL_SYMBOLS = SEMANTIC_BASE_SYMBOLS
_SEMANTIC_ORDINAL = {symbol: index for index, symbol in enumerate(SEMANTIC_BASE_SYMBOLS, start=1)}


def _official_authority() -> tuple[dict[str, int], int, str]:
    resolver = _lexical.resolver()
    mapping = {unit: index for index, unit in enumerate(resolver.emoji.units, start=1)}
    return mapping, len(mapping), resolver.emoji.version


def official_emoji_count() -> int:
    return _official_authority()[1]


def official_emoji_version() -> str:
    return _official_authority()[2]


def is_official_emoji(symbol: str) -> bool:
    return symbol in _official_authority()[0]


def is_valid_el_symbol(symbol: str) -> bool:
    return symbol in _SEMANTIC_ORDINAL or is_official_emoji(symbol)


@dataclass(frozen=True, slots=True)
class SymbolAuthority:
    symbol: str
    ordinal: int


@dataclass(frozen=True, slots=True)
class VocabularyResult:
    source: ParseResult
    resolved: tuple[SymbolAuthority, ...]
    unknown_emoji: tuple[Token, ...]
    status: ValidationStatus
    compound_meaning: str | None = None

    @property
    def is_fully_canonical(self) -> bool:
        return self.status is ValidationStatus.PASS and self.compound_meaning is None

    @property
    def is_explicit_compound(self) -> bool:
        return self.status is ValidationStatus.PASS and self.compound_meaning is not None

    def render_el_status(self) -> str:
        if self.status is ValidationStatus.FAIL:
            return "❌🔤"
        if self.status is ValidationStatus.HOLD:
            if self.unknown_emoji:
                return "🟡❓" + "".join(token.text for token in self.unknown_emoji)
            return "🟡❓"
        if self.compound_meaning is not None:
            return "✅📚🧩"
        return "✅📚"


class VocabularyEngine:
    def resolve(self, parsed: ParseResult) -> VocabularyResult:
        if not isinstance(parsed, ParseResult):
            raise TypeError("parsed must be a ParseResult")

        compound_meaning = _compounds.lookup_compound(parsed.source)
        official, _, _ = _official_authority()
        resolved: list[SymbolAuthority] = []
        unknown_emoji: list[Token] = []
        for token in parsed.tokens:
            ordinal = _SEMANTIC_ORDINAL.get(token.text)
            if ordinal is not None:
                resolved.append(SymbolAuthority(token.text, ordinal))
            elif token.text in official:
                resolved.append(SymbolAuthority(token.text, len(SEMANTIC_BASE_SYMBOLS) + official[token.text]))
            elif token.kind is TokenKind.EMOJI:
                unknown_emoji.append(token)

        if parsed.status is ValidationStatus.FAIL:
            status = ValidationStatus.FAIL
        elif parsed.status is ValidationStatus.HOLD:
            status = ValidationStatus.HOLD
        elif compound_meaning is not None:
            status = ValidationStatus.PASS
            unknown_emoji = []
        elif unknown_emoji:
            status = ValidationStatus.HOLD
        else:
            status = ValidationStatus.PASS

        return VocabularyResult(parsed, tuple(resolved), tuple(unknown_emoji), status, compound_meaning)

    @staticmethod
    def lookup(symbol: str) -> SymbolAuthority | None:
        ordinal = _SEMANTIC_ORDINAL.get(symbol)
        if ordinal is not None:
            return SymbolAuthority(symbol, ordinal)
        official, _, _ = _official_authority()
        official_ordinal = official.get(symbol)
        if official_ordinal is None:
            return None
        return SymbolAuthority(symbol, len(SEMANTIC_BASE_SYMBOLS) + official_ordinal)

    @staticmethod
    def lookup_compound(source: str) -> str | None:
        return _compounds.lookup_compound(source)
