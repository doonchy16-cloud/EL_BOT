"""Engine 19: deterministic in-memory EL notification queue."""

from __future__ import annotations

from dataclasses import dataclass
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_core = _load("_el_core", _ROOT / "⚙️" / "⚙️")
ValidationStatus = _core.ValidationStatus
CoreEngine = _core.CoreEngine


@dataclass(frozen=True, slots=True)
class Notification:
    marker: str
    payload: str

    def render_el(self) -> str:
        return "🔔" + self.marker + self.payload


class NotificationEngine:
    def __init__(self) -> None:
        self._queue: list[Notification] = []

    @property
    def count(self) -> int:
        return len(self._queue)

    def emit(self, marker: str, payload: str = "") -> Notification:
        rendered = marker + payload
        if CoreEngine().parse(rendered, el_mode=True).status is ValidationStatus.FAIL:
            raise ValueError("notification must be letter-free")
        item = Notification(marker, payload)
        self._queue.append(item)
        return item

    def drain(self) -> tuple[Notification, ...]:
        items = tuple(self._queue)
        self._queue.clear()
        return items

    def render_el(self) -> str:
        if not self._queue:
            return "⚪🔔0"
        return "✅🔔" + str(self.count) + " " + " ".join(item.render_el() for item in self._queue)

    def process(self, text: str) -> str:
        if text == "🔔":
            return self.render_el()
        if text == "🔔🧹":
            count = self.count
            self._queue.clear()
            return "✅🔔🧹" + str(count)
        return "🟡🔔❓"

    def render_el_status(self) -> str:
        return "⚪🔔0" if not self._queue else "✅🔔" + str(self.count)
