"""Local Ollama provider boundary for EL Bot.

User-facing methods render only EL-safe status. Raw model text is available only
through explicitly internal methods and must pass downstream deterministic
validation before it can ever reach an EL surface.
"""
from __future__ import annotations

from dataclasses import dataclass
import json
from typing import Callable, Iterable
import urllib.error
import urllib.request

DEFAULT_BASE_URL="http://127.0.0.1:11434"
DEFAULT_MODEL="qwen2.5vl:7b"

@dataclass(frozen=True,slots=True)
class OllamaEvidence:
    reachable:bool
    model_present:bool
    model:str
    def render_el(self)->str:
        if not self.reachable:return "❌🦙📡"
        if not self.model_present:return "🟡🦙❓"
        return "✅🦙👁️7️⃣"

class OllamaConnector:
    """Strict local provider boundary. Normal translation never imports this module."""
    def __init__(self,model:str=DEFAULT_MODEL,base_url:str=DEFAULT_BASE_URL,probe_timeout:float=5.0,generation_timeout:float=120.0,urlopen:Callable[...,object]=urllib.request.urlopen)->None:
        if not isinstance(model,str) or not model.strip():raise ValueError("model must be a non-empty string")
        if not isinstance(base_url,str) or not base_url.startswith(("http://","https://")):raise ValueError("base_url must be http(s)")
        if probe_timeout<=0 or generation_timeout<=0:raise ValueError("timeouts must be positive")
        self.model=model.strip();self.base_url=base_url.rstrip("/");self.probe_timeout=float(probe_timeout);self.generation_timeout=float(generation_timeout);self._urlopen=urlopen;self._last_evidence:OllamaEvidence|None=None

    def _request_json(self,path:str,payload:dict|None=None,*,timeout:float|None=None)->dict:
        data=None;headers={"Accept":"application/json"};method="GET"
        if payload is not None:
            data=json.dumps(payload,ensure_ascii=False).encode("utf-8");headers["Content-Type"]="application/json";method="POST"
        request=urllib.request.Request(self.base_url+path,data=data,headers=headers,method=method)
        response=self._urlopen(request,timeout=self.probe_timeout if timeout is None else timeout)
        manager=response if hasattr(response,"__enter__") else None
        if manager is not None:
            with manager as opened:raw=opened.read()
        else:raw=response.read()
        decoded=json.loads(raw.decode("utf-8"))
        if not isinstance(decoded,dict):raise ValueError("Ollama response must be a JSON object")
        return decoded

    def models(self)->tuple[str,...]:
        payload=self._request_json("/api/tags",timeout=self.probe_timeout);models=payload.get("models",[])
        if not isinstance(models,list):raise ValueError("Ollama models payload must be a list")
        return tuple(item["name"] for item in models if isinstance(item,dict) and isinstance(item.get("name"),str) and item["name"])
    def running_models(self)->tuple[str,...]:
        payload=self._request_json("/api/ps",timeout=self.probe_timeout);models=payload.get("models",[])
        if not isinstance(models,list):raise ValueError("Ollama running-model payload must be a list")
        return tuple(item["name"] for item in models if isinstance(item,dict) and isinstance(item.get("name"),str) and item["name"])
    def probe(self)->OllamaEvidence:
        try:names=self.models()
        except (OSError,TimeoutError,ValueError,json.JSONDecodeError,urllib.error.URLError):evidence=OllamaEvidence(False,False,self.model)
        except Exception:evidence=OllamaEvidence(False,False,self.model)
        else:evidence=OllamaEvidence(True,self.model in names,self.model)
        self._last_evidence=evidence;return evidence
    def warm_internal(self,keep_alive:str="10m")->bool:
        if not isinstance(keep_alive,str) or not keep_alive:raise ValueError("keep_alive must be a non-empty string")
        self._request_json("/api/generate",{"model":self.model,"prompt":"","stream":False,"keep_alive":keep_alive},timeout=self.generation_timeout)
        return self.model in self.running_models()
    @staticmethod
    def _validate_images(images:Iterable[str])->tuple[str,...]:
        image_list=tuple(images)
        if any(not isinstance(item,str) or not item for item in image_list):raise ValueError("images must contain non-empty base64 strings")
        return image_list
    @staticmethod
    def _chat_content(decoded:dict)->str:
        payload=decoded.get("message")
        if not isinstance(payload,dict):raise ValueError("Ollama chat message is missing")
        content=payload.get("content")
        if not isinstance(content,str) or not content.strip():raise ValueError("Ollama chat content is missing")
        return content

    def generate_internal(self,prompt:str,images:Iterable[str]=())->str:
        if not isinstance(prompt,str) or not prompt.strip():raise ValueError("prompt must be a non-empty string")
        image_list=self._validate_images(images);payload={"model":self.model,"prompt":prompt,"stream":False,"keep_alive":"10m","options":{"temperature":0}}
        if image_list:payload["images"]=list(image_list)
        decoded=self._request_json("/api/generate",payload,timeout=self.generation_timeout);response=decoded.get("response")
        if not isinstance(response,str) or not response.strip():raise ValueError("Ollama response text is missing")
        return response

    def chat_internal(self,prompt:str,images:Iterable[str]=(),*,num_predict:int=512,num_ctx:int=4096,keep_alive:str="30m")->str:
        """Unconstrained chat used only inside the screenshot sensor boundary."""
        if not isinstance(prompt,str) or not prompt.strip():raise ValueError("prompt must be a non-empty string")
        if not isinstance(num_predict,int) or num_predict<32 or num_predict>1536:raise ValueError("num_predict out of range")
        if not isinstance(num_ctx,int) or num_ctx<1024 or num_ctx>16384:raise ValueError("num_ctx out of range")
        if not isinstance(keep_alive,str) or not keep_alive:raise ValueError("keep_alive must be a non-empty string")
        image_list=self._validate_images(images);message={"role":"user","content":prompt}
        if image_list:message["images"]=list(image_list)
        payload={"model":self.model,"messages":[message],"stream":False,"keep_alive":keep_alive,"options":{"temperature":0,"num_ctx":num_ctx,"num_predict":num_predict}}
        # qwen2.5vl:7b image inference has repeatedly exceeded the screenshot
        # caller's 140-second budget on the Windows runner. Keep text chat on the
        # caller-supplied timeout, but give VL/image chat a bounded 210-second floor.
        effective_timeout=max(self.generation_timeout,210.0) if image_list else self.generation_timeout
        return self._chat_content(self._request_json("/api/chat",payload,timeout=effective_timeout))

    def chat_json_internal(self,prompt:str,images:Iterable[str]=(),*,schema:dict|None=None,num_predict:int=768,num_ctx:int=4096,keep_alive:str="30m")->str:
        """Structured internal provider mode for validated sensors/resolvers."""
        if not isinstance(prompt,str) or not prompt.strip():raise ValueError("prompt must be a non-empty string")
        if not isinstance(num_predict,int) or num_predict<64 or num_predict>1536:raise ValueError("num_predict out of range")
        if not isinstance(num_ctx,int) or num_ctx<1024 or num_ctx>16384:raise ValueError("num_ctx out of range")
        if not isinstance(keep_alive,str) or not keep_alive:raise ValueError("keep_alive must be a non-empty string")
        if schema is not None and not isinstance(schema,dict):raise ValueError("schema must be a JSON schema object")
        image_list=self._validate_images(images);message={"role":"user","content":prompt}
        if image_list:message["images"]=list(image_list)
        payload={"model":self.model,"messages":[message],"stream":False,"keep_alive":keep_alive,"format":schema if schema is not None else "json","options":{"temperature":0,"num_ctx":num_ctx,"num_predict":num_predict}}
        return self._chat_content(self._request_json("/api/chat",payload,timeout=self.generation_timeout))

    def process(self,text:str)->str:
        if text in {"🦙","🦙🔍"}:return self.probe().render_el()
        return "🟡🦙❓"
    def render_el_status(self)->str:
        return "⚪🦙" if self._last_evidence is None else self._last_evidence.render_el()
