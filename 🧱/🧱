class ELGrammarCompositionEngine:
    """Construct EL templates from semantic components; never ranks."""

    def __init__(self) -> None:
        self.graph = _graph.SemanticGraphEngine()

    @staticmethod
    def is_canonical_expression(expression: str) -> bool:
        graphemes = _core.split_graphemes(expression)
        meaningful = [g for g in graphemes if not g.isspace() and g not in {".", ",", ";", ":", "!", "?", "-"}]
        checker = getattr(_vocab, "is_valid_el_symbol", lambda value: value in _vocab.CANONICAL_SYMBOLS)
        return bool(meaningful) and all(checker(g) or g in _RELATIONS or g.isdigit() for g in meaningful)

    def compose(self, decomposition) -> tuple[ELCompositionTemplate, ...]:
        if not getattr(decomposition, "resolved", False):
            return ()
        sense_id = str(getattr(decomposition, "sense_id", ""))
        concepts = tuple(getattr(decomposition, "concept_keys", ()))
        explicit = _SENSE_TEMPLATES.get(sense_id, ())
        templates: list[ELCompositionTemplate] = []
        for template_id, expression, coverage in explicit:
            templates.append(ELCompositionTemplate(template_id, expression, coverage, self.is_canonical_expression(expression), concepts))

        if not explicit:
            symbols: list[str] = []
            for component in getattr(decomposition, "components", ()):
                concept = str(getattr(component, "concept", ""))
                symbol = _COMPONENT_SYMBOLS.get(concept)
                if symbol is None:
                    hints = self.graph.canonical_hints(concept, depth=0)
                    symbol = hints[0] if hints else None
                if symbol and symbol not in symbols:
                    symbols.append(symbol)
            if symbols:
                expression = "➕".join(symbols)
                templates.append(ELCompositionTemplate("component-composition", expression, min(1.0, 0.55 + 0.1 * len(symbols)), self.is_canonical_expression(expression), concepts))
        return tuple(dict.fromkeys(templates))

    def compose_primary(self, decomposition) -> ELCompositionTemplate | None:
        rows = self.compose(decomposition)
        if not rows:
            return None
        return max(rows, key=lambda item: (item.semantic_coverage, -len(item.expression), item.template_id))

    def render_el_status(self) -> str:
        return f"✅🧱{len(_SENSE_TEMPLATES)}"
