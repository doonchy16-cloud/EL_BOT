"""N04: deterministic semantic graph for EL Bot Phase 3.

The graph is read-only in Phase 3. It supplies concept/sense relationships and
canonical EL hints, but it does not rank candidates, graduate knowledge, or call
providers.
"""
from __future__ import annotations

from dataclasses import dataclass
from collections import deque
import re

_WORD = re.compile(r"[a-z0-9]+(?:'[a-z0-9]+)?", re.I)


@dataclass(frozen=True, slots=True)
class SemanticNode:
    key: str
    kind: str
    labels: tuple[str, ...]
    canonical_hints: tuple[str, ...] = ()


@dataclass(frozen=True, slots=True)
class SemanticEdge:
    source: str
    relation: str
    target: str
    weight: float = 1.0


