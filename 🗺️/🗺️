class SemanticGraphEngine:
    """Read-only concept graph used by deterministic Phase-3 reasoning."""

    def __init__(self) -> None:
        self._nodes = {node.key: node for node in _NODES}
        self._edges = _EDGES
        aliases: dict[str, list[str]] = {}
        for node in _NODES:
            aliases.setdefault(node.key, []).append(node.key)
            for label in node.labels:
                aliases.setdefault(label.lower(), []).append(node.key)
        self._aliases = {key: tuple(dict.fromkeys(values)) for key, values in aliases.items()}

    @property
    def nodes(self) -> tuple[SemanticNode, ...]:
        return tuple(self._nodes.values())

    @property
    def edges(self) -> tuple[SemanticEdge, ...]:
        return self._edges

    def node(self, key: str) -> SemanticNode | None:
        return self._nodes.get(str(key).strip().lower())

    def resolve_label(self, text: str) -> tuple[str, ...]:
        return self._aliases.get(str(text).strip().lower(), ())

    def neighbors(self, key: str, *, relation: str | None = None) -> tuple[SemanticEdge, ...]:
        key = str(key).strip().lower()
        return tuple(edge for edge in self._edges if edge.source == key and (relation is None or edge.relation == relation))

    def expand(self, key: str, *, depth: int = 2) -> tuple[str, ...]:
        """Return deterministic breadth-first related concept keys."""
        key = str(key).strip().lower()
        if key not in self._nodes:
            return ()
        seen = {key}
        ordered = [key]
        queue = deque([(key, 0)])
        while queue:
            current, level = queue.popleft()
            if level >= max(0, int(depth)):
                continue
            for edge in self._edges:
                if edge.source == current:
                    nxt = edge.target
                elif edge.target == current:
                    nxt = edge.source
                else:
                    continue
                if nxt in seen:
                    continue
                seen.add(nxt)
                ordered.append(nxt)
                queue.append((nxt, level + 1))
        return tuple(ordered)

    def semantic_terms(self, key: str, *, depth: int = 2) -> tuple[str, ...]:
        terms: list[str] = []
        for related in self.expand(key, depth=depth):
            node = self._nodes[related]
            terms.append(related.replace("-", " "))
            terms.extend(node.labels)
        words: list[str] = []
        for term in terms:
            words.extend(match.group(0).lower() for match in _WORD.finditer(term))
        return tuple(dict.fromkeys(words))

    def canonical_hints(self, key: str, *, depth: int = 1) -> tuple[str, ...]:
        hints: list[str] = []
        for related in self.expand(key, depth=depth):
            hints.extend(self._nodes[related].canonical_hints)
        return tuple(dict.fromkeys(hints))

    def render_el_status(self) -> str:
        return f"✅🗺️{len(self._nodes)}➕{len(self._edges)}"
