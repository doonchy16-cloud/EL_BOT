"""N05: deterministic positive/negative evidence and confidence aggregation."""
from __future__ import annotations

from dataclasses import dataclass

_ALLOWED_POLARITY = frozenset({"positive", "negative", "ambiguous"})


@dataclass(frozen=True, slots=True)
class EvidenceRecord:
    evidence_id: str
    claim_id: str
    polarity: str
    weight: float
    source: str
    reason: str
    provenance_id: str

    def render_el(self) -> str:
        marker = "✅" if self.polarity == "positive" else "❌" if self.polarity == "negative" else "🟡"
        return marker + "📊"


@dataclass(frozen=True, slots=True)
class ConfidenceSnapshot:
    claim_id: str
    positive_weight: float
    negative_weight: float
    ambiguous_weight: float
    confidence: float
    evidence_count: int

    @property
    def support(self) -> float:
        return self.positive_weight

    @property
    def opposition(self) -> float:
        return self.negative_weight

    def render_el(self) -> str:
        percent = max(0, min(100, round(self.confidence * 100)))
        marker = "✅" if percent >= 80 else "🟡" if percent >= 50 else "❌"
        return marker + "📊" + str(percent)


class EvidenceConfidenceEngine:
    """Accumulate evidence only; never decides knowledge maturity."""

    def __init__(self) -> None:
        self._records: list[EvidenceRecord] = []
        self._ids: set[str] = set()

    @property
    def records(self) -> tuple[EvidenceRecord, ...]:
        return tuple(self._records)

    def record(self, *, evidence_id: str, claim_id: str, polarity: str, weight: float, source: str, reason: str, provenance_id: str) -> EvidenceRecord:
        for label, value in (("evidence_id", evidence_id), ("claim_id", claim_id), ("source", source), ("reason", reason), ("provenance_id", provenance_id)):
            if not isinstance(value, str) or not value.strip():
                raise ValueError(f"{label} must be non-empty")
        if evidence_id in self._ids:
            raise ValueError("evidence_id already exists")
        if polarity not in _ALLOWED_POLARITY:
            raise ValueError("unsupported polarity")
        try:
            normalized_weight = float(weight)
        except (TypeError, ValueError) as exc:
            raise ValueError("weight must be numeric") from exc
        if not 0.0 <= normalized_weight <= 1.0:
            raise ValueError("weight must be between 0 and 1")
        record = EvidenceRecord(
            evidence_id=evidence_id.strip(),
            claim_id=claim_id.strip(),
            polarity=polarity,
            weight=normalized_weight,
            source=source.strip(),
            reason=reason.strip(),
            provenance_id=provenance_id.strip(),
        )
        self._ids.add(record.evidence_id)
        self._records.append(record)
        return record

    def for_claim(self, claim_id: str) -> tuple[EvidenceRecord, ...]:
        return tuple(item for item in self._records if item.claim_id == claim_id)

    def confidence(self, claim_id: str) -> ConfidenceSnapshot:
        records = self.for_claim(claim_id)
        positive = sum(item.weight for item in records if item.polarity == "positive")
        negative = sum(item.weight for item in records if item.polarity == "negative")
        ambiguous = sum(item.weight for item in records if item.polarity == "ambiguous")
        total = positive + negative + ambiguous
        score = 0.0 if total <= 0 else (positive + (0.5 * ambiguous)) / total
        return ConfidenceSnapshot(
            claim_id=claim_id,
            positive_weight=positive,
            negative_weight=negative,
            ambiguous_weight=ambiguous,
            confidence=max(0.0, min(1.0, score)),
            evidence_count=len(records),
        )

    def process(self, text: str) -> str:
        if text == "📊":
            return "✅📊" + str(len(self._records))
        snapshot = self.confidence(text)
        return snapshot.render_el() if snapshot.evidence_count else "⚪📊0"

    def render_el_status(self) -> str:
        return "✅📊" + str(len(self._records))
