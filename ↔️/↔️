def _unicode_label(grapheme: str) -> str:
    names: list[str] = []
    for char in grapheme:
        if ord(char) in (0xFE0E, 0xFE0F, 0x200D):
            continue
        name = unicodedata.name(char, "")
        if name:
            names.append(name.lower())
    return " + ".join(names) if names else "unknown unicode symbol"


def _meaning_lines(graphemes: tuple[str, ...]) -> str:
    lines: list[str] = []
    seen: set[str] = set()
    for symbol in graphemes:
        if symbol in seen:
            continue
        seen.add(symbol)
        if symbol in _SYMBOL_TO_MEANING:
            lines.append(f"{symbol} = {_SYMBOL_TO_MEANING[symbol]}")
        elif any(ord(ch) > 127 for ch in symbol):
            lines.append(f"{symbol} = non-canonical Unicode: {_unicode_label(symbol)}")
    return "\n".join(lines)


def _candidate_symbols(text: str, limit: int = 120) -> tuple[str, ...]:
    lowered = text.lower()
    words = set(re.findall(r"[a-z0-9]+", lowered))
    selected: list[str] = []
    forced: list[tuple[int, int, str]] = []
    for order, (phrase, symbol) in enumerate(_PHRASES):
        index = lowered.find(phrase)
        if index >= 0:
            forced.append((index, order, symbol))
    forced.sort()
    for _, _, symbol in forced:
        if symbol not in selected:
            selected.append(symbol)

    scored: list[tuple[int, int, str]] = []
    for ordinal, (symbol, meaning) in enumerate(_SYMBOL_TO_MEANING.items()):
        if symbol in selected:
            continue
        meaning_words = set(re.findall(r"[a-z0-9]+", meaning.lower()))
        score = len(words & meaning_words)
        if score:
            scored.append((-score, ordinal, symbol))
    scored.sort()
    for _, _, symbol in scored:
        if symbol not in selected:
            selected.append(symbol)
        if len(selected) >= limit:
            return tuple(selected[:limit])
    for symbol in _CORE:
        if symbol not in selected:
            selected.append(symbol)
        if len(selected) >= limit:
            break
    return tuple(selected[:limit])


def _fallback_to_el(text: str) -> str:
    lowered = text.lower()
    hits: list[tuple[int, int, str]] = []
    for order, (phrase, symbol) in enumerate(_PHRASES):
        start = 0
        while True:
            index = lowered.find(phrase, start)
            if index < 0:
                break
            hits.append((index, order, symbol))
            start = index + max(1, len(phrase))
    hits.sort()
    out: list[str] = []
    for _, _, symbol in hits:
        if symbol not in out:
            out.append(symbol)
    for number in re.findall(r"\b\d+(?:\.\d+)?\b", text):
        if number not in out:
            out.append(number)
    if not out:
        return "🟡❓"
    return "➡️".join(out)


def _literal_text_candidate(graphemes: tuple[str, ...]) -> str:
    parts: list[str] = []
    for symbol in graphemes:
        if symbol in _SYMBOL_TO_MEANING:
            parts.append(_SYMBOL_TO_MEANING[symbol])
        elif symbol.isspace() or symbol in ".,;:!?-()[]{}":
            parts.append(symbol)
        elif symbol.isdigit():
            parts.append(symbol)
        elif any(ord(ch) > 127 for ch in symbol):
            parts.append("non-canonical " + _unicode_label(symbol))
    return " | ".join(part for part in parts if part.strip())


class TranslationEngine:
    def __init__(self, ollama=None, ranker=None) -> None:
        self.ollama = ollama if ollama is not None else OllamaConnector(generation_timeout=180.0)
        self.ranker = ranker if ranker is not None else SemanticRanker()

    def _ask(self, prompt: str) -> str:
        return self.ollama.generate_internal(prompt).strip()

    def ranked_to_text(self, source: str) -> RankedResult:
        if not isinstance(source, str) or not source.strip():
            return self.ranker.rank_text_candidates(source if isinstance(source, str) else "", ["Unable to interpret empty input."])
        if any(char.isalpha() for char in source):
            return self.ranker.rank_text_candidates(source, ["Mode 1 expects emoji or symbol input, not alphabetic text."])

        graphemes = _core.split_graphemes(source)
        evidence = _meaning_lines(graphemes)
        candidates: list[str] = []
        exact = _rank._compounds.lookup_compound(source)
        if exact:
            candidates.append(exact)
        try:
            raw = self._ask(_rank.candidate_prompt_mode1(source, evidence))
            candidates.extend(_rank._extract_json_candidates(raw))
        except Exception:
            pass
        literal = _literal_text_candidate(graphemes)
        if literal:
            candidates.append(literal)
        if not candidates:
            candidates.append("Unable to interpret input from available authority.")
        return self.ranker.rank_text_candidates(source, candidates)

    def ranked_to_el(self, source: str) -> RankedResult:
        if not isinstance(source, str) or not source.strip():
            return self.ranker.rank_el_candidates(source if isinstance(source, str) else "", ["🟡❓"], _PHRASES)

        symbols = _candidate_symbols(source)
        glossary = "\n".join(f"{symbol} = {_SYMBOL_TO_MEANING[symbol]}" for symbol in symbols)
        candidates: list[str] = []
        fallback = _fallback_to_el(source)
        if _rank.valid_el(fallback):
            candidates.append(fallback)
        try:
            raw = self._ask(_rank.candidate_prompt_mode2(source, glossary))
            candidates.extend(_rank._extract_json_candidates(raw))
        except Exception:
            pass
        result = self.ranker.rank_el_candidates(source, candidates, _PHRASES)
        if result.candidates:
            return result
        return self.ranker.rank_el_candidates(source, ["🟡❓"], _PHRASES)

    def ranked(self, mode: int, source: str) -> RankedResult:
        if mode == 1:
            return self.ranked_to_text(source)
        if mode == 2:
            return self.ranked_to_el(source)
        raise ValueError("invalid translation mode")

    def process(self, mode: int, source: str) -> str:
        if mode not in (1, 2):
            return "❌🔢"
        return self.ranked(mode, source).winner

    def record_selection(self, mode: int, source: str, value: str) -> int:
        return self.ranker.record_selection(mode, source, value)


def _read_mode_source() -> tuple[int, str] | None:
    payload = sys.stdin.read()
    if "\n" not in payload:
        return None
    head, source = payload.split("\n", 1)
    try:
        mode = int(head.strip())
    except ValueError:
        return None
    return mode, source.strip()


def main() -> int:
    engine = TranslationEngine()
    action = sys.argv[1] if len(sys.argv) > 1 else ""

    if action == "✅":
        try:
            payload = json.loads(sys.stdin.read())
            count = engine.record_selection(int(payload["mode"]), str(payload["source"]), str(payload["value"]))
        except Exception:
            print("❌🏆")
            return 0
        print("✅🏆" + str(count))
        return 0

    pair = _read_mode_source()
    if pair is None:
        print("❌🔢")
        return 0
    mode, source = pair
    if mode not in (1, 2):
        print("❌🔢")
        return 0

    result = engine.ranked(mode, source)
    if action == "🔀":
        print(json.dumps(result.as_dict(), ensure_ascii=False, separators=(",", ":")))
    else:
        print(result.winner)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
