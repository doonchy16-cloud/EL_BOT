#!/usr/bin/env python3
"""Deterministic bidirectional translation facade for EL Bot.

1 = Emoji Language -> ABC
2 = ABC -> Emoji Language

Normal translation never imports or calls Ollama. The facade coordinates the
two independent 24-stage engines, round-trip verification, and observed user
choice evidence.
"""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
from pathlib import Path
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_lang = _load("_el_bidi_foundation", _ROOT / "🧠" / "🧬")
_rank = _load("_el_bidi_rank", _ROOT / "🧠" / "🔀")
_abc = _load("_el_abc_engine", _ROOT / "🔤➡️😀" / "🔤➡️😀")
_emoji = _load("_el_emoji_engine", _ROOT / "😀➡️🔤" / "😀➡️🔤")

ABCToEmojiEngine = _abc.ABCToEmojiEngine
EmojiToABCEngine = _emoji.EmojiToABCEngine
SelectionStore = _rank.SelectionStore


class TranslationEngine:
    def __init__(self, store=None) -> None:
        self.store = store if store is not None else SelectionStore()
        self.abc_to_emoji = ABCToEmojiEngine()
        self.emoji_to_abc = EmojiToABCEngine()
        self.provider_call_count = 0

    def ranked_to_text(self, source: str, *, emit: bool = True):
        counts = self.store.counts(1, source)
        return self.emoji_to_abc.translate(
            source,
            verifier=self.abc_to_emoji,
            preference_counts=counts,
            cross_verify=True,
            emit=emit,
        )

    def ranked_to_el(self, source: str, *, emit: bool = True):
        counts = self.store.counts(2, source)
        return self.abc_to_emoji.translate(
            source,
            verifier=self.emoji_to_abc,
            preference_counts=counts,
            cross_verify=True,
            emit=emit,
        )

    def ranked(self, mode: int, source: str, *, emit: bool = True):
        if mode == 1:
            return self.ranked_to_text(source, emit=emit)
        if mode == 2:
            return self.ranked_to_el(source, emit=emit)
        raise ValueError("invalid translation mode")

    def process(self, mode: int, source: str) -> str:
        if mode not in (1, 2):
            return "❌🔢"
        return self.ranked(mode, source, emit=False).winner

    def record_selection(self, mode: int, source: str, value: str) -> int:
        if mode not in (1, 2) or not source or not value:
            raise ValueError("invalid ranking selection")
        if mode == 2 and not _lang.valid_el(value):
            raise ValueError("selected EL candidate is invalid")
        return self.store.record(mode, source, value)

    def render_el_status(self) -> str:
        return "✅↔️24+24🤖❌"


def _read_mode_source() -> tuple[int, str] | None:
    payload = sys.stdin.read()
    if "\n" not in payload:
        return None
    head, source = payload.split("\n", 1)
    try:
        mode = int(head.strip())
    except ValueError:
        return None
    return mode, source.strip()


def main() -> int:
    engine = TranslationEngine()
    action = sys.argv[1] if len(sys.argv) > 1 else ""

    if action == "✅":
        try:
            payload = json.loads(sys.stdin.read())
            count = engine.record_selection(int(payload["mode"]), str(payload["source"]), str(payload["value"]))
        except Exception:
            print("❌🏆")
            return 0
        print("✅🏆" + str(count))
        return 0

    pair = _read_mode_source()
    if pair is None:
        print("❌🔢")
        return 0
    mode, source = pair
    if mode not in (1, 2):
        print("❌🔢")
        return 0

    result = engine.ranked(mode, source, emit=True)
    if action == "🔀":
        print(json.dumps(result.as_dict(), ensure_ascii=False, separators=(",", ":")))
    else:
        print(result.winner)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
