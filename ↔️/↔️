#!/usr/bin/env python3
"""Bidirectional ranked translation boundary for EL Bot.

1 = emoji/symbol -> text
2 = text -> canonical EL

Default CLI output is the winning candidate for compatibility. Passing the
emoji argument 🔀 returns structured ranked candidates as JSON. Passing ✅
records an explicit user selection as observed ranking evidence.
"""

