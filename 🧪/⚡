#!/usr/bin/env python3
"""Deterministic translation throughput plus runtime-render safety acceptance check."""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys
from time import perf_counter


def _load(name: str, path: Path):
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


ROOT = Path(__file__).resolve().parent.parent
abc = _load("_el_perf_abc", ROOT / "🔤➡️😀" / "🔤➡️😀")
emoji = _load("_el_perf_emoji", ROOT / "😀➡️🔤" / "😀➡️🔤")
lang = _load("_el_perf_lang", ROOT / "🧠" / "🧬")


def assert_runtime_render_contract() -> None:
    main_js = (ROOT / "⚡" / "⚡").read_text(encoding="utf-8")
    view = (ROOT / "⚡" / "🖥️").read_text(encoding="utf-8")

    assert view.lstrip().lower().startswith("<!doctype html>")
    for marker in ('id="mode1"', 'id="mode2"', 'id="run"', 'id="image"', 'id="input"', 'id="output"', 'id="state"'):
        assert marker in view, f"UI marker missing: {marker}"

    assert "function materializeHtmlView()" in main_js
    assert "function validateViewSource(source)" in main_js
    assert "async function verifyRenderedView(win)" in main_js
    assert "async function loadApplicationView(win)" in main_js
    assert "el-bot-${digest}.html" in main_js
    assert "path.extname(runtimeView).toLowerCase() !== '.html'" in main_js
    assert "show: false" in main_js
    assert "await loadApplicationView(win)" in main_js
    assert "if (!win.isDestroyed()) win.show()" in main_js
    assert "win.loadFile(VIEW_SOURCE)" not in main_js
    assert "win.loadFile(VIEW)" not in main_js
    assert "raw source code" in main_js


def main() -> int:
    assert_runtime_render_contract()

    abc_engine = abc.ABCToEmojiEngine()
    emoji_engine = emoji.EmojiToABCEngine()
    lang.canonical_patterns()
    abc_engine.translate("Restart the local server after 30 seconds.", cross_verify=False, emit=False)
    emoji_engine.translate("🔴📡❌⏱️30➡️🔄⚙️", cross_verify=False, emit=False)

    iterations = 250
    start = perf_counter()
    for index in range(iterations):
        abc_engine.translate(
            f"Critical server error after {30 + index} seconds. Restart the service immediately and verify success.",
            cross_verify=False,
            emit=False,
        )
        emoji_engine.translate(
            f"🔴📡❌⏱️{30 + index}➡️🔄⚙️‼️➡️🧾➡️✅",
            cross_verify=False,
            emit=False,
        )
    elapsed = max(0.001, perf_counter() - start)
    translations = iterations * 2
    per_minute = int(translations * 60.0 / elapsed)
    assert per_minute >= 1000, f"throughput below requirement: {per_minute}/min"
    print(f"✅🖥️🌐")
    print(f"✅⚡🔤{per_minute}/min")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
