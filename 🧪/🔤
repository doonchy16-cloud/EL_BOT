#!/usr/bin/env python3
"""Deterministic translation-quality acceptance checks for the pre-Phase-9 gate."""
from __future__ import annotations

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys


def _load(name:str,path:Path):
    loader=SourceFileLoader(name,str(path));spec=spec_from_loader(name,loader)
    if spec is None:raise RuntimeError("module spec unavailable")
    module=module_from_spec(spec);sys.modules[name]=module;loader.exec_module(module);return module

ROOT=Path(__file__).resolve().parent.parent
abc=_load("_el_quality_abc",ROOT/"🔤➡️😀"/"🔤➡️😀")
emoji=_load("_el_quality_emoji",ROOT/"😀➡️🔤"/"😀➡️🔤")
bidi=_load("_el_quality_bidi",ROOT/"↔️"/"↔️")
vision=_load("_el_quality_vision",ROOT/"📸"/"📸")
lang=_load("_el_quality_lang",ROOT/"🧠"/"🧬")


def main()->int:
    a=abc.ABCToEmojiEngine();e=emoji.EmojiToABCEngine();passed=0

    hi=a.translate("hi",verifier=e,cross_verify=True,emit=False)
    assert hi.winner=="👋" and hi.metrics.get("quality_status")!="fail",hi.as_dict();print("👋✅")

    r=a.translate("Load the file, test it, validate the result, and deploy only after every required check passes.",verifier=e,cross_verify=True,emit=False);print("1️⃣ "+r.winner)
    for marker in ("📥","📄","🧪","🧾","🚀","🚦➡️","✅"):assert marker in r.winner,(marker,r.as_dict())
    assert r.metrics.get("relation_integrity",0)>=.9;passed+=1

    r=e.translate("📥➡️🧪➡️🧾➡️✅➡️🚀",verifier=a,cross_verify=True,emit=False);t=r.winner.lower();print("2️⃣ "+r.winner)
    for word in ("load","test","valid","deploy"):assert word in t,(word,r.as_dict())
    assert "the el sequence communicates" not in t and "|" not in r.winner;passed+=1

    r=a.translate("The local server failed after 45 seconds and went offline. Restart the service immediately and verify that it is healthy.",verifier=e,cross_verify=True,emit=False);print("3️⃣ "+r.winner)
    assert "⏱️45" in r.winner and "📴" in r.winner and "🔄" in r.winner and "‼️" in r.winner and "🟢" in r.winner
    assert "⏱️➡️⏱️45" not in r.winner and r.metrics.get("number_integrity",0)==1.0;passed+=1

    r=a.translate("A critical database connection timed out after 30 seconds. The local server crashed and went offline. Restart the container immediately, restore the service, reconnect to the database, run diagnostics, and verify that the system is healthy before continuing.",verifier=e,cross_verify=True,emit=False);print("4️⃣ "+r.winner)
    for marker in ("🔴","🗃️","🔌","⏱️30","📡","💥","📴","🔄","📦","‼️","❤️‍🩹","🧪","🟢"):assert marker in r.winner,(marker,r.as_dict())
    assert r.metrics.get("critical_integrity",0)>=.85;passed+=1

    r=a.translate("The security system must remain locked if authentication fails. Reject the invalid credential, request a replacement key, authenticate it, unlock access only after verification succeeds, and keep the system locked if authentication fails again.",verifier=e,cross_verify=True,emit=False);print("5️⃣ "+r.winner)
    for marker in ("🔐","🔒","🚦","🛂","❌","🔑","🔓","🚦➡️","✔️","✅"):assert marker in r.winner,(marker,r.as_dict())
    assert r.metrics.get("relation_integrity",0)>=.8;passed+=1

    r=a.translate("The AI bot works quickly in both directions through the computer interface, preserves the active session, validates every result, and supports screenshots without using AI for normal translation.",verifier=e,cross_verify=True,emit=False);print("6️⃣ "+r.winner)
    for marker in ("🤖","⚡","↔️","🖥️","🧵","🧾","📸","❌"):assert marker in r.winner,(marker,r.as_dict())
    passed+=1

    r=e.translate("🔐🔒➡️❌🔑➡️🛂🔑➡️🔓🚦➡️✔️✅",verifier=a,cross_verify=True,emit=False);t=r.winner.lower();print("7️⃣ "+r.winner)
    for word in ("security","lock","credential","authenticate","unlock","after","verify"):assert word in t,(word,r.as_dict())
    passed+=1

    r=e.translate("🔴📡❌➡️⏱️45➡️📴➡️🔄⚙️‼️➡️🧪➡️🧾➡️✅➡️🟢",verifier=a,cross_verify=True,emit=False);t=r.winner.lower();print("8️⃣ "+r.winner)
    for word in ("critical","server","45","offline","restart","immediately","diagnostic","valid","healthy"):assert word in t,(word,r.as_dict())
    assert r.metrics.get("critical_retention",0)>=.75;passed+=1

    long_source=" ".join([
        "The local server failed after 45 seconds and went offline. Restart the service immediately and verify that it is healthy.",
        "Keep the security system locked if authentication fails and preserve the current session and saved data.",
        "Load the package, test every file, validate the result, deploy only after success, and notify the user when complete.",
        "Use screenshot vision only for visible image facts and keep normal translation deterministic.",
    ]*12)
    r=a.translate(long_source,verifier=e,cross_verify=True,emit=False);print("9️⃣📏 "+str(len(r.winner))+" ❓"+str(r.winner.count("❓"))+" "+r.winner[:220])
    assert r.winner!="🟡❓" and "⏱️45" in r.winner and len(r.winner)>300
    assert r.winner.count("❓")<24 and r.metrics.get("unknown_density",1.0)<.40;passed+=1

    facade=bidi.TranslationEngine();before=facade.provider_call_count
    assert facade.process(2,"The local server failed after 30 seconds. Restart the service immediately, preserve the active session, run diagnostics, validate recovery, and confirm that the system is healthy.")
    assert facade.process(1,"📡❌➡️⏱️30➡️🔄⚙️‼️➡️🧪➡️🧾➡️✅➡️🟢")
    assert facade.provider_call_count==before==0;print("🔟 🤖❌↔️✅");passed+=1

    parsed,strategy=vision._parse_observation('{"visible_text":["Error"],"objects":["window"],"controls":["Retry"],"states":["error"],"relationships":["Retry is below Error"]}')
    assert strategy=="json" and parsed is not None and parsed["visible_text"]==("Error",)
    candidates,m=vision._facts_to_el(parsed);assert candidates and lang.valid_el(candidates[0].value) and m["vision_fact_coverage"]>0
    print("1️⃣1️⃣ 📸📋✅");passed+=1

    truncated='{"visible_text":["Error","Retry"],"objects":["application window"],"controls":["Retry button"],"states":["error"],"relationships":['
    recovered,recovery_strategy=vision._parse_observation(truncated)
    assert recovery_strategy=="partial-json-repair" and recovered is not None
    assert recovered["visible_text"]==("Error","Retry") and recovered["controls"]==("Retry button",)
    print("1️⃣2️⃣ 📸✂️📋🧯✅");passed+=1

    vision_source=(ROOT/"📸"/"📸").read_text(encoding="utf-8");ollama_source=(ROOT/"🦙"/"🦙").read_text(encoding="utf-8")
    for marker in ("_VISION_SCHEMA","_extract_partial_arrays","structured-vision-retry","Retry Compact Visible Facts","controlled retry","sensor_calls"):assert marker in vision_source,marker
    assert "Do not translate into Emoji Language" in vision_source and "chat_json_internal" in vision_source
    assert "schema if schema is not None else" in ollama_source and "num_ctx\":8192" in ollama_source
    print("1️⃣3️⃣ 📸📜🧬🔁✅");passed+=1

    ui=(ROOT/"⚡"/"🖥️").read_text(encoding="utf-8");electron=(ROOT/"⚡"/"⚡").read_text(encoding="utf-8")
    for marker in ("@media(max-width:1100px)","controlBar","sandTop","sandBottom","sandStream","sandGrain","flowDown","flowUp","sandGrainDown","sandGrainUp","g5","u5","rotate(180deg)","stageStarted","processingStarted","warnAfterMs","Σ ","maxSide=png?1800:1600","updateStage(payload)"):assert marker in ui,marker
    assert "rotate(360deg)" not in ui and "background:#070b13;padding" in ui
    for marker in ("stagePayload","warn_after_ms","170000"):assert marker in electron,marker
    print("1️⃣4️⃣ 🖥️⏳🏖️⏱️0↔180✅");passed+=1

    print(f"✅🧪🔤{passed}/14")
    return 0

if __name__=="__main__":raise SystemExit(main())
