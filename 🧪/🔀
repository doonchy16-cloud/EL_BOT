#!/usr/bin/env python3
"""Deterministic ranking tests for EL Bot semantic candidate selection."""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys
import tempfile


def _load(name: str, path: Path):
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


ROOT = Path(__file__).resolve().parent.parent
rank = _load("_el_rank_test", ROOT / "🧠" / "🔀")


def main() -> int:
    store_path = Path(tempfile.gettempdir()) / "🏆🧪"
    if store_path.exists():
        store_path.unlink()
    store = rank.SelectionStore(store_path)
    assert store.counts(2, "x") == {}
    engine = rank.SemanticRanker(store)

    good = "🔥➡️🚀"
    bad = ("🔥➡️" * 16) + "🚀"
    ranked = engine.rank_el_candidates("launch", [bad, good], (("launch", "🚀"),))
    assert ranked.winner == good
    assert rank._degeneracy_penalty(bad) > rank._degeneracy_penalty(good)

    compound = "🏠💻🦙🤖🧠👁️2️⃣.5️⃣-7️⃣🐝"
    text_ranked = engine.rank_text_candidates(compound, ["grinning robot"])
    assert "qwen2.5vl:7b" in text_ranked.winner

    source = "🤖😀↔️⚡🖥️📸"
    glossary_dump = "Forgey/AI agent/bot | non-canonical grinning face | two-way/bidirectional | fast/power/performance | UI/terminal/computer interface | screenshot/captured evidence"
    sentence = "The Forgey AI agent communicates bidirectionally at high speed through a computer interface using captured screenshots."
    sentence_ranked = engine.rank_text_candidates(source, [glossary_dump, sentence])
    assert sentence_ranked.winner == sentence
    assert "|" not in sentence_ranked.winner
    assert rank._text_sentence_adjustment(sentence)[0] > rank._text_sentence_adjustment(glossary_dump)[0]

    first = engine.rank_el_candidates("x", ["🔥", "🚀"], ())
    assert first.winner == "🔥"
    engine.record_selection(2, "x", "🚀")
    second = engine.rank_el_candidates("x", ["🔥", "🚀"], ())
    assert second.winner == "🚀"

    parsed = rank._extract_json_candidates('{"candidates":[{"value":"🔥➡️🚀"},{"value":"🚀"}]}')
    assert parsed == ["🔥➡️🚀", "🚀"]

    if store_path.exists():
        store_path.unlink()
    print("✅🧪🔀")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
