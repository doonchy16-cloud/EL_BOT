#!/usr/bin/env python3
"""Emoji-only self-test entry point."""

from base64 import b64decode
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from json import loads
from pathlib import Path
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


ROOT = Path(__file__).resolve().parent.parent
diagnostics = _load("_el_diag", ROOT / "🧪" / "🧪")
core = _load("_el_core", ROOT / "⚙️" / "⚙️")
vocab = _load("_el_vocab", ROOT / "📚" / "📚")
instructor = _load("_el_instructor", ROOT / "🧑‍🏫" / "🧑‍🏫")
animation = _load("_el_animation_phase1", ROOT / "🎞️" / "🎞️")
identity = _load("_el_identity_phase1", ROOT / "🪪" / "🪪")

compound = "🏠💻🤖🧠👁️2️⃣.5️⃣-7️⃣🐝"
explicit_compound = "🏠💻🦙🤖🧠👁️2️⃣.5️⃣-7️⃣🐝"
old_compound = "💻🦙🤖🧠👁️7️⃣:🐝"
expected = "local ollama model qwen2.5vl:7b"
resolved = vocab.VocabularyEngine().resolve(core.CoreEngine().parse(compound))
explicit_resolved = vocab.VocabularyEngine().resolve(core.CoreEngine().parse(explicit_compound))
old_resolved = vocab.VocabularyEngine().resolve(core.CoreEngine().parse(old_compound))
assert resolved.status is core.ValidationStatus.PASS
assert resolved.is_explicit_compound
assert resolved.compound_meaning == expected
assert explicit_resolved.status is core.ValidationStatus.PASS
assert explicit_resolved.is_explicit_compound
assert explicit_resolved.compound_meaning == expected
assert instructor.InstructorEngine().translate_compound_to_text(compound) == expected
assert instructor.InstructorEngine().translate_compound_to_text(explicit_compound) == expected
assert instructor.InstructorEngine().process("🧑‍🏫" + compound) == "✅🧑‍🏫🧩"
assert instructor.InstructorEngine().process("🧑‍🏫" + explicit_compound) == "✅🧑‍🏫🧩"
assert old_resolved.status is core.ValidationStatus.HOLD
assert not old_resolved.is_explicit_compound

rich_ui = (ROOT / "⚡" / "🖥️").read_text(encoding="utf-8")
for marker in (
    "function renderRich",
    "function semanticTone",
    "function ansiRuns",
    "function appendInline",
    "tone-ok",
    "tone-bad",
    "tone-warn",
    "tone-lock",
    "tone-info",
    "tone-ai",
    "tone-cyan",
    "tone-win",
    "richCode",
    "richBold",
    "richItalic",
    "richUnderline",
):
    assert marker in rich_ui
assert ".innerHTML" not in rich_ui

electron_main = (ROOT / "⚡" / "⚡").read_text(encoding="utf-8")
for marker in (
    "app.setAppUserModelId(APP_ID)",
    "ensureAppIconPath",
    "phaseOneHtml",
    "controlBar",
    "flex-wrap:nowrap!important",
    "hourglassFlip",
    "phase-one-runtime",
    "processing.id='processing'",
    "hourglass.id='hourglass'",
    "stage.id='stage'",
    "icon: iconPath",
    "win.setAppDetails",
    "win.setThumbnailToolTip",
):
    assert marker in electron_main

identity_config = loads((ROOT / "🪪" / "🎛️").read_text(encoding="utf-8"))
assert identity_config["name"] == "EL Bot"
assert identity_config["app_id"] == "com.thespark.elbot"
assert identity_config["icon_asset"] == "🎨"
icon_bytes = b64decode((ROOT / "🪪" / "🎨").read_text(encoding="utf-8").strip(), validate=True)
assert icon_bytes.startswith(b"\x89PNG\r\n\x1a\n")
assert len(icon_bytes) > 100

animation_engine = animation.AnimationEngine()
assert animation_engine.processing_symbol == "⏳"
assert animation_engine.process("⏳") == "🎞️⏳🔁"

identity_snapshot = identity.IdentityEngine().snapshot()
assert identity_snapshot.app_name == "EL Bot"
assert identity_snapshot.app_user_model_id == "com.thespark.elbot"
assert identity_snapshot.icon_asset == "🎨"

report = diagnostics.DiagnosticsEngine().run()
print(report.render_el())
print("🎨✅")
print("🧩✅")
print("⏳✅")
print("🪪✅")
raise SystemExit(0 if report.passed else 1)
