#!/usr/bin/env python3
"""Full deterministic EL Bot self-test entry point."""

from __future__ import annotations

from base64 import b64decode
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from json import loads
from pathlib import Path
import sys
import tempfile
from time import perf_counter


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


ROOT = Path(__file__).resolve().parent.parent
diagnostics = _load("_el_diag", ROOT / "🧪" / "🧪")
core = _load("_el_core", ROOT / "⚙️" / "⚙️")
vocab = _load("_el_vocab", ROOT / "📚" / "📚")
instructor = _load("_el_instructor", ROOT / "🧑‍🏫" / "🧑‍🏫")
animation = _load("_el_animation_self", ROOT / "🎞️" / "🎞️")
identity = _load("_el_identity_self", ROOT / "🪪" / "🪪")
abc = _load("_el_abc_self", ROOT / "🔤➡️😀" / "🔤➡️😀")
emoji = _load("_el_emoji_self", ROOT / "😀➡️🔤" / "😀➡️🔤")
bidi = _load("_el_bidi_self", ROOT / "↔️" / "↔️")

compound = "🏠💻🤖🧠👁️2️⃣.5️⃣-7️⃣🐝"
explicit_compound = "🏠💻🦙🤖🧠👁️2️⃣.5️⃣-7️⃣🐝"
expected = "local ollama model qwen2.5vl:7b"
resolved = vocab.VocabularyEngine().resolve(core.CoreEngine().parse(compound))
explicit_resolved = vocab.VocabularyEngine().resolve(core.CoreEngine().parse(explicit_compound))
assert resolved.status is core.ValidationStatus.PASS and resolved.is_explicit_compound and resolved.compound_meaning == expected
assert explicit_resolved.status is core.ValidationStatus.PASS and explicit_resolved.is_explicit_compound and explicit_resolved.compound_meaning == expected
assert instructor.InstructorEngine().translate_compound_to_text(explicit_compound) == expected
assert len(vocab.CANONICAL_SYMBOLS) == 501 and len(set(vocab.CANONICAL_SYMBOLS)) == 501

electron_main = (ROOT / "⚡" / "⚡").read_text(encoding="utf-8")
for marker in ("app.setAppUserModelId(APP_ID)", "ensureAppIconPath", "event.sender.send('⏳'", "win.loadFile(VIEW)"):
    assert marker in electron_main
ui_source = (ROOT / "⚡" / "🖥️").read_text(encoding="utf-8")
for marker in ("controlBar", "hourglassFlip", "180deg", "@media(max-width:1100px)", "id=\"quality\"", "updateStage(payload)"):
    assert marker in ui_source
preload = (ROOT / "⚡" / "🔌").read_text(encoding="utf-8")
assert "ipcRenderer.on('⏳'" in preload

identity_config = loads((ROOT / "🪪" / "🎛️").read_text(encoding="utf-8"))
assert identity_config["name"] == "EL Bot" and identity_config["app_id"] == "com.thespark.elbot" and identity_config["icon_asset"] == "🎨"
icon_bytes = b64decode((ROOT / "🪪" / "🎨").read_text(encoding="utf-8").strip(), validate=True)
assert icon_bytes.startswith(b"\x89PNG\r\n\x1a\n") and len(icon_bytes) > 100

animation_engine = animation.AnimationEngine()
assert animation_engine.processing_symbol == "⏳" and animation_engine.flip_degrees == 180 and animation_engine.process("⏳") == "🎞️⏳↪️180"
identity_snapshot = identity.IdentityEngine().snapshot()
assert identity_snapshot.app_name == "EL Bot" and identity_snapshot.app_user_model_id == "com.thespark.elbot"

normal_sources = "\n".join((ROOT / path).read_text(encoding="utf-8") for path in ("↔️/↔️", "🔤➡️😀/🔤➡️😀", "😀➡️🔤/😀➡️🔤", "🧠/🧬"))
for forbidden in ("OllamaConnector", "_ollama", "urllib.request", "chat_internal", "generate_internal"):
    assert forbidden not in normal_sources
vision_source = (ROOT / "📸" / "📸").read_text(encoding="utf-8")
assert "OllamaConnector" in vision_source and "vision sensor, not a translator" in vision_source and "ABCToEmojiEngine" in vision_source and "Do not translate into Emoji Language" in vision_source

abc_engine = abc.ABCToEmojiEngine()
emoji_engine = emoji.EmojiToABCEngine()
assert len(abc_engine.stage_names) == 24 and len(set(abc_engine.stage_names)) == 24
assert len(emoji_engine.stage_names) == 24 and len(set(emoji_engine.stage_names)) == 24

critical_source = "A critical database connection timed out after 30 seconds. The local server crashed and went offline. Restart the container immediately to restore the service."
critical = abc_engine.translate(critical_source, verifier=emoji_engine, cross_verify=True, emit=False)
assert critical.winner != "🟡❓" and "⏱️30" in critical.winner and "🔄" in critical.winner and "📴" in critical.winner
process = emoji_engine.translate("📥➡️🧪➡️🧾➡️✅➡️🚀", verifier=abc_engine, cross_verify=True, emit=False)
process_lower = process.winner.lower()
assert "import" in process_lower and "test" in process_lower and "valid" in process_lower and "deploy" in process_lower
assert "the el sequence communicates" not in process_lower and "|" not in process.winner

long_source = " ".join([
    "The local server failed after 45 seconds and went offline. Restart the service immediately and verify success.",
    "Keep the security system locked if authentication fails. Preserve the session and saved data.",
    "Load the package, test the file, validate the result, deploy after success, and notify the user when complete.",
] * 12)
long_result = abc_engine.translate(long_source, verifier=emoji_engine, cross_verify=True, emit=False)
assert long_result.winner != "🟡❓" and "⏱️45" in long_result.winner and len(long_result.winner) > 200

with tempfile.TemporaryDirectory() as folder:
    store = _load("_el_rank_self", ROOT / "🧠" / "🔀").SelectionStore(Path(folder) / "🏆")
    facade = bidi.TranslationEngine(store=store)
    assert facade.provider_call_count == 0
    assert facade.process(2, "Restart the local server after 30 seconds.")
    assert facade.process(1, "📥➡️🧪➡️🧾➡️✅➡️🚀")
    assert facade.provider_call_count == 0

start = perf_counter()
for index in range(120):
    abc_engine.translate(f"Restart the local server after {30 + index} seconds and verify success.", cross_verify=False, emit=False)
elapsed = max(0.001, perf_counter() - start)
rate = int(120 * 60 / elapsed)
assert rate >= 1000

report = diagnostics.DiagnosticsEngine().run()
assert len(report.checks) == 24
print(report.render_el())
print("🎨✅")
print("⏳↪️180✅")
print("🤖➡️📸🔒✅")
print("↔️🤖❌✅")
print("🔤➡️😀24✅")
print("😀➡️🔤24✅")
print("⚡🔤" + str(rate) + "/min✅")
raise SystemExit(0 if report.passed else 1)
