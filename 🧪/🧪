@dataclass(frozen=True, slots=True)
class DiagnosticCheck:
    marker: str
    passed: bool

    def render_el(self) -> str:
        return self.marker + ("✅" if self.passed else "❌")


@dataclass(frozen=True, slots=True)
class DiagnosticReport:
    checks: tuple[DiagnosticCheck, ...]

    @property
    def passed(self) -> bool:
        return all(item.passed for item in self.checks)

    def render_el(self) -> str:
        passed = sum(1 for item in self.checks if item.passed)
        total = len(self.checks)
        head = "✅🧪" if self.passed else "❌🧪"
        return head + f"{passed}/{total}" + "\n" + " ".join(item.render_el() for item in self.checks)


class DiagnosticsEngine:
    def run(self) -> DiagnosticReport:
        checks: list[DiagnosticCheck] = []

        core = _core.CoreEngine()
        surface = core.parse("🔥➡️1️⃣.\n  ✅")
        family = core.parse("👨‍👩‍👧‍👦")
        checks.append(DiagnosticCheck("1️⃣⚙️", surface.status is _core.ValidationStatus.PASS and surface.reconstructed == "🔥➡️1️⃣.\n  ✅" and core.parse("abc").status is _core.ValidationStatus.FAIL and len(family.tokens) == 1))

        vocab = _vocab.VocabularyEngine()
        meaning_map = dict(zip(_vocab.CANONICAL_SYMBOLS, _meanings.PRIMARY_MEANINGS, strict=True))
        checks.append(DiagnosticCheck("2️⃣📚", len(_vocab.CANONICAL_SYMBOLS) == 501 and len(set(_vocab.CANONICAL_SYMBOLS)) == 501 and len(_meanings.PRIMARY_MEANINGS) == 501 and meaning_map["↔️"].startswith("two-way") and meaning_map["🦙"] == "ollama"))

        resolved = vocab.resolve(core.parse("🔥➡️🚀"))
        interpreted = _intel.IntelligenceEngine().interpret(resolved)
        checks.append(DiagnosticCheck("3️⃣🧠", bool(interpreted.lines) and interpreted.lines[0].el_relationships == ("🔥➡️🚀",)))

        validation = _valid.ValidationEngine().validate(interpreted, "🔥➡️🚀")
        checks.append(DiagnosticCheck("4️⃣🧾", validation.releasable and validation.safe_output() == "🔥➡️🚀"))

        session = _session.SessionEngine()
        turn = session.ingest("🔥➡️🚀")
        checks.append(DiagnosticCheck("5️⃣🧵", turn.safe_output() == "🔥➡️🚀" and session.render_el_status() == "✅🧵"))

        with tempfile.TemporaryDirectory() as folder:
            persistence = _persist.PersistenceEngine(Path(folder) / "🗃️")
            persistence.save(session)
            restored = persistence.load()
            persist_ok = len(restored.turns) == 1 and restored.latest is not None and restored.latest.source == "🔥➡️🚀"
        checks.append(DiagnosticCheck("6️⃣💾", persist_ok))

        checks.append(DiagnosticCheck("7️⃣🧪", DiagnosticReport((DiagnosticCheck("🧪", True),)).passed))

        ui = _load("_el_ui_diag", _ROOT / "🖥️" / "🖥️")
        ui_engine = ui.UIEngine()
        checks.append(DiagnosticCheck("8️⃣🖥️", ui_engine.process("🪪").startswith("✅🪪") and ui_engine.process("abc") == "❌🔐🔤"))

        with tempfile.TemporaryDirectory() as folder:
            workflow = _workflow.WorkflowEngine(_persist.PersistenceEngine(Path(folder) / "🗃️"))
            workflow_ok = workflow.process("🔥➡️🚀") == "🔥➡️🚀\n✅🧵" and workflow.process("🎞️").startswith("🎞️")
        checks.append(DiagnosticCheck("9️⃣🔁", workflow_ok))

        events = _event.EventEngine()
        events.emit("📥", "🔵")
        events.emit("📤", "✅")
        checks.append(DiagnosticCheck("🔟📡", events.render_el() == "1:📥🔵\n2:📤✅"))

        security = _security.SecurityEngine()
        checks.append(DiagnosticCheck("1️⃣1️⃣🔐", security.authorize("✦").authorized and security.authorize("🪪").authorized and not security.authorize("abc").authorized))

        recovery = _recovery.RecoveryEngine()
        def explode():
            raise RuntimeError("hidden exception")
        checks.append(DiagnosticCheck("1️⃣2️⃣🧯", recovery.protect("🖥️", lambda: "🔥") == "🔥" and recovery.protect("🖥️", explode) == "❌🧯" and recovery.protect("🖥️", lambda: "hidden words") == "❌🧯🔤"))

        configuration = _config.ConfigurationEngine()
        config_default = configuration.process("🎛️")
        configuration.process("🎛️💾❌")
        checks.append(DiagnosticCheck("1️⃣3️⃣🎛️", config_default.startswith("🎛️") and "💾❌" in configuration.process("🎛️")))

        connectors = _connector.ConnectorEngine()
        empty = connectors.render_el() == "⚪🔌0"
        connectors.register("🌐", lambda payload: "✅🔌" + payload)
        checks.append(DiagnosticCheck("1️⃣4️⃣🔌", empty and connectors.invoke("🌐", "🔥") == "✅🔌🔥" and connectors.invoke("☁️", "🔥") == "🟡🔌❓"))

        orchestration = _orchestration.OrchestrationEngine()
        checks.append(DiagnosticCheck("1️⃣5️⃣✦", orchestration.process("✦").startswith("✅✦12 ") and len(orchestration.stages) == 12))

        instructor = _instructor.InstructorEngine()
        record = instructor.lookup("🔄")
        checks.append(DiagnosticCheck("1️⃣6️⃣🧑‍🏫", instructor.process("🧑‍🏫") == "✅🧑‍🏫501" and record is not None and record.ordinal == 100))

        animation = _animation.AnimationEngine()
        checks.append(DiagnosticCheck("1️⃣7️⃣🎞️", animation.processing_symbol == "⏳" and animation.flip_degrees == 180 and animation.process("⏳") == "🎞️⏳↪️180"))

        reliability = _reliability.ReliabilityEngine()
        reliable = reliability.assess(("✅⚙️", "✅📚"))
        held = reliability.assess(("✅⚙️", "🟡🔌0"))
        translated = reliability.assess_translation({"coverage": 0.95, "roundtrip": 0.9, "candidates": 2})
        checks.append(DiagnosticCheck("1️⃣8️⃣🛡️", reliable.marker == "✅" and held.marker == "🟡" and translated.marker == "✅"))

        notifications = _notification.NotificationEngine()
        notifications.emit("🟡", "🧵")
        checks.append(DiagnosticCheck("1️⃣9️⃣🔔", notifications.render_el() == "✅🔔1 🔔🟡🧵" and len(notifications.drain()) == 1))

        identity = _identity.IdentityEngine()
        identity_snapshot = identity.snapshot()
        checks.append(DiagnosticCheck("2️⃣0️⃣🪪", identity.process("🪪").startswith("✅🪪🤖") and identity_snapshot.app_name == "EL Bot"))

        authentication = _auth.AuthenticationEngine()
        checks.append(DiagnosticCheck("2️⃣1️⃣🛂", authentication.verify(identity_snapshot.kind, identity_snapshot.protocol) and not authentication.verify("👤", identity_snapshot.protocol)))

        updater = _updater.UpdaterEngine()
        updater_ok = updater.process("🔄") == "✅🔄1" and updater.propose(2) and updater.apply() and updater.process("🔄") == "✅🔄2"
        checks.append(DiagnosticCheck("2️⃣2️⃣🔄", updater_ok))

        abc_engine = _abc.ABCToEmojiEngine()
        abc_result = abc_engine.translate("A critical database connection timed out after 30 seconds. Restart the container immediately.", cross_verify=False, emit=False)
        checks.append(DiagnosticCheck("2️⃣3️⃣🔤➡️😀", len(abc_engine.stage_names) == 24 and "⏱️30" in abc_result.winner and "🔄" in abc_result.winner and abc_engine.render_el_status() == "✅🔤➡️😀24"))

        emoji_engine = _emoji.EmojiToABCEngine()
        emoji_result = emoji_engine.translate("📥➡️🧪➡️🧾➡️✅➡️🚀", cross_verify=False, emit=False)
        lower = emoji_result.winner.lower()
        checks.append(DiagnosticCheck("2️⃣4️⃣😀➡️🔤", len(emoji_engine.stage_names) == 24 and "test" in lower and "valid" in lower and "deploy" in lower and "the el sequence communicates" not in lower and "|" not in emoji_result.winner and emoji_engine.render_el_status() == "✅😀➡️🔤24"))

        canonicalizer = _canonicalization.EmojiCanonicalizationEngine()
        sun = canonicalizer.canonicalize_unit("☀")
        keycap = canonicalizer.canonicalize_unit("1\u20e3")
        checks.append(DiagnosticCheck("2️⃣5️⃣🧷", sun.valid and sun.canonical == "☀️" and keycap.valid and keycap.canonical == "1️⃣" and not canonicalizer.canonicalize_unit("abc").valid))

        universe = _universe.EmojiUniverseEngine()
        checks.append(DiagnosticCheck("2️⃣6️⃣🌐", universe.snapshot.count > 501 and universe.snapshot.canonical_coverage == 501 and not universe.snapshot.rgi_complete and universe.contains("😀")))

        provenance = _provenance.ProvenanceLedgerEngine()
        p1 = provenance.append(record_id="p1", claim_id="c1", source_kind="deterministic", source_ref="diagnostics", validation_status="pass", created_at="2026-08-12T23:00:00Z")
        checks.append(DiagnosticCheck("2️⃣7️⃣📜", provenance.for_claim("c1") == (p1,) and p1.validation_status == "pass"))

        evidence = _evidence.EvidenceConfidenceEngine()
        evidence.record(evidence_id="e1", claim_id="c1", polarity="positive", weight=0.9, source="validation", reason="pass", provenance_id="p1")
        evidence.record(evidence_id="e2", claim_id="c1", polarity="negative", weight=0.1, source="countercheck", reason="minor", provenance_id="p1")
        confidence = evidence.confidence("c1")
        checks.append(DiagnosticCheck("2️⃣8️⃣📊", confidence.evidence_count == 2 and abs(confidence.confidence - 0.9) < 1e-9))

        with tempfile.TemporaryDirectory() as folder:
            knowledge = _versioning.KnowledgeVersioningRollbackEngine(Path(folder) / "knowledge.json")
            v1 = knowledge.commit({"claims": {"c1": {"expression": "🔥"}}}, change_ids=("c1",), created_at="2026-08-12T23:00:00Z")
            v2 = knowledge.commit({"claims": {"c1": {"expression": "🚀"}}}, change_ids=("c1",), created_at="2026-08-12T23:01:00Z")
            v3 = knowledge.rollback("1")
            version_ok = v1.version_id == "1" and v2.parent_id == "1" and v3.parent_id == "2" and knowledge.snapshot_for("3") == knowledge.snapshot_for("1")
        checks.append(DiagnosticCheck("2️⃣9️⃣🗃️", version_ok))

        integrity = _integrity.KnowledgeIntegrityEngine()
        good = integrity.assess({"claim_id":"c1","concept":"deploy","expression":"🚀","maturity":"canonical"}, confidence=confidence, provenance=provenance.for_claim("c1"))
        bad = integrity.assess({"claim_id":"c2","concept":"converter","expression":"🔄","maturity":"discovered"})
        checks.append(DiagnosticCheck("3️⃣0️⃣🧿", good.passed and bad.status == "fail"))

        if len(checks) != 30:
            raise RuntimeError("diagnostic check count invariant violated")
        return DiagnosticReport(tuple(checks))
