"""Deterministic diagnostics engine for the emoji-path EL Bot."""

from __future__ import annotations

from dataclasses import dataclass
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import tempfile
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_core = _load("_el_core", _ROOT / "⚙️" / "⚙️")
_vocab = _load("_el_vocab", _ROOT / "📚" / "📚")
_intel = _load("_el_intel", _ROOT / "🧠" / "🧠")
_valid = _load("_el_valid", _ROOT / "🧾" / "🧾")
_session = _load("_el_session", _ROOT / "🧵" / "🧵")
_persist = _load("_el_persist", _ROOT / "💾" / "💾")
_event = _load("_el_event", _ROOT / "📡" / "📡")
_security = _load("_el_security", _ROOT / "🔐" / "🔐")
_recovery = _load("_el_recovery", _ROOT / "🧯" / "🧯")
_config = _load("_el_config", _ROOT / "🎛️" / "🎛️")
_connector = _load("_el_connector", _ROOT / "🔌" / "🔌")
_workflow = _load("_el_workflow", _ROOT / "🔁" / "🔁")


@dataclass(frozen=True, slots=True)
class DiagnosticCheck:
    marker: str
    passed: bool

    def render_el(self) -> str:
        return self.marker + ("✅" if self.passed else "❌")


@dataclass(frozen=True, slots=True)
class DiagnosticReport:
    checks: tuple[DiagnosticCheck, ...]

    @property
    def passed(self) -> bool:
        return all(item.passed for item in self.checks)

    def render_el(self) -> str:
        passed = sum(1 for item in self.checks if item.passed)
        total = len(self.checks)
        head = "✅🧪" if self.passed else "❌🧪"
        return head + f"{passed}/{total}" + "\n" + " ".join(item.render_el() for item in self.checks)


class DiagnosticsEngine:
    def run(self) -> DiagnosticReport:
        checks: list[DiagnosticCheck] = []

        surface = _core.CoreEngine().parse("🔥➡️1️⃣.\n  ✅")
        checks.append(DiagnosticCheck("1️⃣⚙️", surface.status is _core.ValidationStatus.PASS and surface.reconstructed == "🔥➡️1️⃣.\n  ✅"))
        checks.append(DiagnosticCheck("2️⃣🔤", _core.CoreEngine().parse("abc").status is _core.ValidationStatus.FAIL))

        checks.append(DiagnosticCheck("3️⃣📚", len(_vocab.CANONICAL_SYMBOLS) == 500 and len(set(_vocab.CANONICAL_SYMBOLS)) == 500))
        unknown = _vocab.VocabularyEngine().resolve(_core.CoreEngine().parse("🙂"))
        checks.append(DiagnosticCheck("4️⃣❓", unknown.status is _core.ValidationStatus.HOLD))

        resolved = _vocab.VocabularyEngine().resolve(_core.CoreEngine().parse("🔥➡️🚀"))
        interpreted = _intel.IntelligenceEngine().interpret(resolved)
        relation_ok = bool(interpreted.lines) and interpreted.lines[0].el_relationships == ("🔥➡️🚀",)
        checks.append(DiagnosticCheck("5️⃣🧠", relation_ok))

        report = _valid.ValidationEngine().validate(interpreted, "🔥➡️🚀")
        checks.append(DiagnosticCheck("6️⃣🧾", report.releasable and report.safe_output() == "🔥➡️🚀"))

        session = _session.SessionEngine()
        turn = session.ingest("🔥➡️🚀")
        checks.append(DiagnosticCheck("7️⃣🧵", turn.safe_output() == "🔥➡️🚀" and session.render_el_status() == "✅🧵"))

        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "🗃️"
            persistence = _persist.PersistenceEngine(path)
            persistence.save(session)
            restored = persistence.load()
            persist_ok = len(restored.turns) == 1 and restored.latest is not None and restored.latest.source == "🔥➡️🚀"
        checks.append(DiagnosticCheck("8️⃣💾", persist_ok))

        events = _event.EventEngine()
        events.emit("📥", "🔵")
        events.emit("📤", "✅")
        event_text = events.render_el()
        event_ok = (
            event_text == "1:📥🔵\n2:📤✅"
            and events.render_el_status() == "✅📡2"
            and _core.CoreEngine().parse(event_text).status is _core.ValidationStatus.PASS
        )
        checks.append(DiagnosticCheck("🔟📡", event_ok))

        security = _security.SecurityEngine()
        security_ok = (
            security.authorize("🔥➡️🚀").authorized
            and security.authorize("🧹").authorized
            and security.authorize("🔌").authorized
            and security.authorize("🔌📋").authorized
            and not security.authorize("abc").authorized
            and security.authorize("abc").render_el_status() == "❌🔐🔤"
            and security.render_el_status() == "✅🔐"
        )
        checks.append(DiagnosticCheck("1️⃣1️⃣🔐", security_ok))

        recovery = _recovery.RecoveryEngine()

        def explode():
            raise RuntimeError("hidden developer exception")

        recovery_success = recovery.protect("🖥️", lambda: "🔥➡️🚀")
        recovery_failure = recovery.protect("🖥️", explode)
        recovery_letters = recovery.protect("🖥️", lambda: "hidden words")
        recovery_ok = (
            recovery_success == "🔥➡️🚀"
            and recovery_failure == "❌🧯"
            and recovery_letters == "❌🧯🔤"
            and recovery.incidents == 2
            and _core.CoreEngine().parse(recovery_failure).status is _core.ValidationStatus.PASS
            and _core.CoreEngine().parse(recovery_letters).status is _core.ValidationStatus.PASS
            and recovery.render_el_status() == "❌🧯2"
        )
        checks.append(DiagnosticCheck("1️⃣2️⃣🧯", recovery_ok))

        configuration = _config.ConfigurationEngine()
        config_default = configuration.process("🎛️")
        configuration.process("🎛️💾❌")
        configuration.process("🎛️📡❌")
        config_off = configuration.process("🎛️")
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "🗃️"
            persistence = _persist.PersistenceEngine(path)
            workflow_config = _workflow.WorkflowEngine(persistence, configuration)
            config_output = workflow_config.process("🔥➡️🚀")
            config_ok = (
                config_default == "🎛️ 💾✅ 📡✅ 🔤❌🔒"
                and config_off == "🎛️ 💾❌ 📡❌ 🔤❌🔒"
                and not configuration.enabled("💾")
                and not configuration.enabled("📡")
                and config_output == "🔥➡️🚀\n✅🧵"
                and not path.exists()
                and workflow_config.process("📡") == "⚪📡"
                and _core.CoreEngine().parse(config_off).status is _core.ValidationStatus.PASS
            )
        checks.append(DiagnosticCheck("1️⃣3️⃣🎛️", config_ok))

        connectors = _connector.ConnectorEngine()
        connector_empty = connectors.render_el() == "⚪🔌0"
        connector_unknown = connectors.invoke("🌐", "🔥") == "🟡🔌❓"
        connectors.register("🌐", lambda payload: "✅🔌" + payload)
        connector_output = connectors.invoke("🌐", "🔥")
        connectors.register("☁️", lambda payload: "hidden words")
        connector_letters = connectors.invoke("☁️", "🔥")
        connector_ok = (
            connector_empty
            and connector_unknown
            and connector_output == "✅🔌🔥"
            and connector_letters == "❌🔌🔤"
            and connectors.count == 2
            and connectors.render_el_status() == "✅🔌2"
            and _core.CoreEngine().parse(connector_output).status is _core.ValidationStatus.PASS
            and _core.CoreEngine().parse(connector_letters).status is _core.ValidationStatus.PASS
        )
        checks.append(DiagnosticCheck("1️⃣4️⃣🔌", connector_ok))

        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "🗃️"
            persistence = _persist.PersistenceEngine(path)
            workflow = _workflow.WorkflowEngine(persistence)
            output = workflow.process("🔥➡️🚀")
            saved = workflow.process("💾")
            loaded = workflow.process("📥")
            event_log = workflow.process("📡")
            connector_status = workflow.process("🔌")
            workflow_ok = (
                output == "🔥➡️🚀\n✅🧵"
                and saved == "✅💾1"
                and loaded == "✅📥1"
                and connector_status == "⚪🔌0"
                and workflow.render_el_status().startswith("✅🔁")
                and "📥" in event_log
                and "📤" in event_log
                and "💾" in event_log
                and _core.CoreEngine().parse(event_log).status is _core.ValidationStatus.PASS
            )
        checks.append(DiagnosticCheck("9️⃣🔁", workflow_ok))

        return DiagnosticReport(tuple(checks))
