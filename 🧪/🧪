@dataclass(frozen=True, slots=True)
class DiagnosticCheck:
    marker: str
    passed: bool

    def render_el(self) -> str:
        return self.marker + ("✅" if self.passed else "❌")


@dataclass(frozen=True, slots=True)
class DiagnosticReport:
    checks: tuple[DiagnosticCheck, ...]

    @property
    def passed(self) -> bool:
        return all(item.passed for item in self.checks)

    def render_el(self) -> str:
        passed = sum(1 for item in self.checks if item.passed)
        total = len(self.checks)
        head = "✅🧪" if self.passed else "❌🧪"
        return head + f"{passed}/{total}" + "\n" + " ".join(item.render_el() for item in self.checks)


class DiagnosticsEngine:
    def run(self) -> DiagnosticReport:
        checks: list[DiagnosticCheck] = []

        core = _core.CoreEngine()
        surface = core.parse("🔥➡️1️⃣.\n  ✅")
        family = core.parse("👨‍👩‍👧‍👦")
        core_ok = (
            surface.status is _core.ValidationStatus.PASS
            and surface.reconstructed == "🔥➡️1️⃣.\n  ✅"
            and core.parse("abc").status is _core.ValidationStatus.FAIL
            and len(family.tokens) == 1
        )
        checks.append(DiagnosticCheck("1️⃣⚙️", core_ok))

        vocab = _vocab.VocabularyEngine()
        unknown = vocab.resolve(core.parse("🙂"))
        meaning_map = dict(zip(_vocab.CANONICAL_SYMBOLS, _meanings.PRIMARY_MEANINGS, strict=True))
        vocab_ok = (
            len(_vocab.CANONICAL_SYMBOLS) == 501
            and len(set(_vocab.CANONICAL_SYMBOLS)) == 501
            and len(_meanings.PRIMARY_MEANINGS) == 501
            and unknown.status is _core.ValidationStatus.HOLD
            and meaning_map["🔁"] == "workflow/loop/retry/sync"
            and meaning_map["🔄"] == "refresh/update"
            and meaning_map["🔂"] == "repeat once/single retry"
            and meaning_map["🧵"] == "session/context thread"
            and meaning_map["🔵"] == "current/active/in progress"
            and meaning_map["⭐"] == "best/top choice/preferred"
            and meaning_map["✅"] == "pass/verified/complete"
            and meaning_map["🪪"] == "identity/system identity"
            and meaning_map["🧬"] == "schema/DNA/inheritance"
            and meaning_map["🦙"] == "ollama"
        )
        checks.append(DiagnosticCheck("2️⃣📚", vocab_ok))

        resolved = vocab.resolve(core.parse("🔥➡️🚀"))
        interpreted = _intel.IntelligenceEngine().interpret(resolved)
        intel_ok = bool(interpreted.lines) and interpreted.lines[0].el_relationships == ("🔥➡️🚀",)
        checks.append(DiagnosticCheck("3️⃣🧠", intel_ok))

        validation = _valid.ValidationEngine().validate(interpreted, "🔥➡️🚀")
        checks.append(DiagnosticCheck("4️⃣🧾", validation.releasable and validation.safe_output() == "🔥➡️🚀"))

        session = _session.SessionEngine()
        turn = session.ingest("🔥➡️🚀")
        checks.append(DiagnosticCheck("5️⃣🧵", turn.safe_output() == "🔥➡️🚀" and session.render_el_status() == "✅🧵"))

        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "🗃️"
            persistence = _persist.PersistenceEngine(path)
            persistence.save(session)
            restored = persistence.load()
            persist_ok = len(restored.turns) == 1 and restored.latest is not None and restored.latest.source == "🔥➡️🚀"
        checks.append(DiagnosticCheck("6️⃣💾", persist_ok))

        probe = DiagnosticReport((DiagnosticCheck("🧪", True),))
        checks.append(DiagnosticCheck("7️⃣🧪", probe.passed and probe.render_el() == "✅🧪1/1\n🧪✅"))

        events = _event.EventEngine()
        events.emit("📥", "🔵")
        events.emit("📤", "✅")
        event_text = events.render_el()
        event_ok = event_text == "1:📥🔵\n2:📤✅" and core.parse(event_text).status is _core.ValidationStatus.PASS
        checks.append(DiagnosticCheck("🔟📡", event_ok))

        security = _security.SecurityEngine()
        security_ok = security.authorize("✦").authorized and security.authorize("🪪").authorized and not security.authorize("abc").authorized
        checks.append(DiagnosticCheck("1️⃣1️⃣🔐", security_ok))

        recovery = _recovery.RecoveryEngine()
        def explode():
            raise RuntimeError("hidden developer exception")
        recovery_ok = recovery.protect("🖥️", lambda: "🔥") == "🔥" and recovery.protect("🖥️", explode) == "❌🧯" and recovery.protect("🖥️", lambda: "hidden words") == "❌🧯🔤"
        checks.append(DiagnosticCheck("1️⃣2️⃣🧯", recovery_ok))

        configuration = _config.ConfigurationEngine()
        config_default = configuration.process("🎛️")
        configuration.process("🎛️💾❌")
        configuration.process("🎛️📡❌")
        config_off = configuration.process("🎛️")
        config_ok = config_default == "🎛️ 💾✅ 📡✅ 🔤❌🔒" and config_off == "🎛️ 💾❌ 📡❌ 🔤❌🔒"
        checks.append(DiagnosticCheck("1️⃣3️⃣🎛️", config_ok))

        connectors = _connector.ConnectorEngine()
        connector_empty = connectors.render_el() == "⚪🔌0"
        connectors.register("🌐", lambda payload: "✅🔌" + payload)
        connector_ok = connector_empty and connectors.invoke("🌐", "🔥") == "✅🔌🔥" and connectors.invoke("☁️", "🔥") == "🟡🔌❓"
        checks.append(DiagnosticCheck("1️⃣4️⃣🔌", connector_ok))

        orchestration = _orchestration.OrchestrationEngine()
        orchestration_ok = orchestration.process("✦").startswith("✅✦12 ") and orchestration.stages[0] == "🖥️" and orchestration.stages[-1] == "📡"
        checks.append(DiagnosticCheck("1️⃣5️⃣✦", orchestration_ok))

        instructor = _instructor.InstructorEngine()
        record = instructor.lookup("🔄")
        instructor_ok = (
            instructor.process("🧑‍🏫") == "✅🧑‍🏫501"
            and record is not None
            and record.ordinal == 100
            and record.primary_meaning == "refresh/update"
            and instructor.translate_to_text(("🔁", "🔄", "🔂")) == ("workflow/loop/retry/sync", "refresh/update", "repeat once/single retry")
        )
        checks.append(DiagnosticCheck("1️⃣6️⃣🧑‍🏫", instructor_ok))

        animation = _animation.AnimationEngine()
        checks.append(DiagnosticCheck("1️⃣7️⃣🎞️", animation.render() == "🎞️⚪➡️🔵➡️🟢" and len(animation.frames) == 3))

        reliability = _reliability.ReliabilityEngine()
        reliable = reliability.assess(("✅⚙️", "✅📚"))
        held = reliability.assess(("✅⚙️", "🟡🔌0"))
        failed = reliability.assess(("✅⚙️", "❌🧯"))
        checks.append(DiagnosticCheck("1️⃣8️⃣🛡️", reliable.marker == "✅" and held.marker == "🟡" and failed.marker == "❌"))

        notifications = _notification.NotificationEngine()
        notifications.emit("🟡", "🧵")
        notification_ok = notifications.render_el() == "✅🔔1 🔔🟡🧵" and len(notifications.drain()) == 1 and notifications.render_el() == "⚪🔔0"
        checks.append(DiagnosticCheck("1️⃣9️⃣🔔", notification_ok))

        identity = _identity.IdentityEngine()
        identity_snapshot = identity.snapshot()
        checks.append(DiagnosticCheck("2️⃣0️⃣🪪", identity.process("🪪") == "✅🪪🤖1" and identity_snapshot.kind == "🤖" and identity_snapshot.protocol == 1))

        authentication = _auth.AuthenticationEngine()
        auth_ok = authentication.verify(identity_snapshot.kind, identity_snapshot.protocol) and not authentication.verify("👤", 1) and authentication.process("🛂") == "✅🛂🏠"
        checks.append(DiagnosticCheck("2️⃣1️⃣🛂", auth_ok))

        updater = _updater.UpdaterEngine()
        updater_ok = updater.process("🔄") == "✅🔄1" and updater.propose(2) and updater.process("🔄") == "🟡🔄1➡️2" and updater.apply() and updater.process("🔄") == "✅🔄2"
        checks.append(DiagnosticCheck("2️⃣2️⃣🔄", updater_ok))

        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "🗃️"
            workflow = _workflow.WorkflowEngine(_persist.PersistenceEngine(path))
            workflow_output = workflow.process("🔥➡️🚀")
            workflow_ok = (
                workflow_output == "🔥➡️🚀\n✅🧵"
                and workflow.process("✦").startswith("✅✦12 ")
                and workflow.process("🧑‍🏫🔥") == "🧑‍🏫🔥#1"
                and workflow.process("🎞️") == "🎞️⚪➡️🔵➡️🟢"
                and workflow.process("🔌") == "⚪🔌0"
                and workflow.process("💾") == "✅💾1"
            )
        checks.append(DiagnosticCheck("9️⃣🔁", workflow_ok))

        ui = _load("_el_ui", _ROOT / "🖥️" / "🖥️")
        ui_engine = ui.UIEngine()
        ui_ok = ui_engine.process("🪪") == "✅🪪🤖1" and ui_engine.process("abc") == "❌🔐🔤" and ui_engine.process("🛂") == "✅🛂🏠"
        checks.append(DiagnosticCheck("8️⃣🖥️", ui_ok))

        order = {check.marker[:2]: check for check in checks}
        expected = 22
        if len(checks) != expected:
            raise RuntimeError("diagnostic check count invariant violated")
        return DiagnosticReport(tuple(checks))
