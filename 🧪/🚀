#!/usr/bin/env python3
"""Real CLI launch smoke test plus Phase 1 architecture gate."""

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
bot = ROOT / "🤖"
source = "🔥➡️🚀"
result = subprocess.run(
    [sys.executable, str(bot), source],
    capture_output=True,
    text=True,
    encoding="utf-8",
)
print(result.stdout, end="")
if result.returncode != 0:
    raise SystemExit(1)
if source not in result.stdout:
    raise SystemExit(1)
if any(char.isalpha() for char in result.stdout):
    raise SystemExit(1)

architecture = ROOT / "architecture" / "verify_phase1_architecture.py"
architecture_result = subprocess.run(
    [sys.executable, str(architecture)],
    capture_output=True,
    text=True,
    encoding="utf-8",
)
print(architecture_result.stdout, end="")
if architecture_result.stderr:
    print(architecture_result.stderr, file=sys.stderr, end="")
if architecture_result.returncode != 0:
    raise SystemExit(1)

raise SystemExit(0)