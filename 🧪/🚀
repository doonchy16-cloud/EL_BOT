#!/usr/bin/env python3
"""Real CLI launch smoke test."""

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
bot = ROOT / "🤖"
source = "🔥➡️🚀"
result = subprocess.run(
    [sys.executable, str(bot), source],
    capture_output=True,
    text=True,
    encoding="utf-8",
)
print(result.stdout, end="")
if result.returncode != 0:
    raise SystemExit(1)
if source not in result.stdout:
    raise SystemExit(1)
if any(char.isalpha() for char in result.stdout):
    raise SystemExit(1)
raise SystemExit(0)
