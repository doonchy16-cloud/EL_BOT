#!/usr/bin/env python3
"""Real CLI launch smoke test plus Phase 1-3 architecture/runtime gates."""

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
bot = ROOT / "🤖"
source = "🔥➡️🚀"
result = subprocess.run(
    [sys.executable, str(bot), source],
    capture_output=True,
    text=True,
    encoding="utf-8",
)
print(result.stdout, end="")
if result.returncode != 0:
    raise SystemExit(1)
if source not in result.stdout:
    raise SystemExit(1)
if any(char.isalpha() for char in result.stdout):
    raise SystemExit(1)

for verifier in (
    ROOT / "architecture" / "verify_phase1_architecture.py",
    ROOT / "architecture" / "verify_phase2_knowledge_foundation.py",
    ROOT / "architecture" / "verify_phase3_semantic_search.py",
):
    gate = subprocess.run(
        [sys.executable, str(verifier)],
        capture_output=True,
        text=True,
        encoding="utf-8",
    )
    print(gate.stdout, end="")
    if gate.stderr:
        print(gate.stderr, file=sys.stderr, end="")
    if gate.returncode != 0:
        raise SystemExit(1)

raise SystemExit(0)
