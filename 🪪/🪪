"""Engine 20: local EL Bot system identity."""

from __future__ import annotations

from dataclasses import dataclass
from json import loads
from pathlib import Path


_ROOT = Path(__file__).resolve().parent
_CONFIG = loads((_ROOT / "🎛️").read_text(encoding="utf-8"))

APP_NAME = str(_CONFIG["name"])
APP_USER_MODEL_ID = str(_CONFIG["app_id"])
APP_ICON_ASSET = str(_CONFIG["icon_asset"])
APP_PROTOCOL = int(_CONFIG["protocol"])


@dataclass(frozen=True, slots=True)
class IdentitySnapshot:
    kind: str = "🤖"
    protocol: int = APP_PROTOCOL
    app_name: str = APP_NAME
    app_user_model_id: str = APP_USER_MODEL_ID
    icon_asset: str = APP_ICON_ASSET

    def render_el(self) -> str:
        return "✅🪪" + self.kind + str(self.protocol)


class IdentityEngine:
    """Identify only this local bot protocol; never infer a human identity."""

    def __init__(self) -> None:
        self._snapshot = IdentitySnapshot()

    def snapshot(self) -> IdentitySnapshot:
        return self._snapshot

    def process(self, text: str) -> str:
        if text == "🪪":
            return self._snapshot.render_el()
        return "🟡🪪❓"

    def render_el_status(self) -> str:
        return self._snapshot.render_el()
