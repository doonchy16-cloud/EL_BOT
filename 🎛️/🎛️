"""Engine 13: deterministic emoji-native runtime configuration.

Developer internals may use ordinary programming language. User-facing output
from this engine is Emoji Language only.
"""

from __future__ import annotations

from dataclasses import dataclass


@dataclass(frozen=True, slots=True)
class ConfigurationSnapshot:
    autosave: bool
    events: bool

    def render_el(self) -> str:
        return (
            "🎛️ "
            + "💾" + ("✅" if self.autosave else "❌")
            + " "
            + "📡" + ("✅" if self.events else "❌")
            + " 🔤❌🔒"
        )


class ConfigurationEngine:
    """Own safe runtime toggles while keeping the EL no-letter rule locked."""

    def __init__(self) -> None:
        self._autosave = True
        self._events = True

    def snapshot(self) -> ConfigurationSnapshot:
        return ConfigurationSnapshot(self._autosave, self._events)

    def enabled(self, key: str) -> bool:
        if key == "💾":
            return self._autosave
        if key == "📡":
            return self._events
        return False

    def process(self, text: str) -> str:
        if text == "🎛️":
            return self.snapshot().render_el()
        if text == "🎛️💾":
            return "🎛️💾" + ("✅" if self._autosave else "❌")
        if text == "🎛️📡":
            return "🎛️📡" + ("✅" if self._events else "❌")
        if text == "🎛️💾✅":
            self._autosave = True
            return "✅🎛️💾"
        if text == "🎛️💾❌":
            self._autosave = False
            return "✅🎛️💾❌"
        if text == "🎛️📡✅":
            self._events = True
            return "✅🎛️📡"
        if text == "🎛️📡❌":
            self._events = False
            return "✅🎛️📡❌"
        return "🟡🎛️❓"

    def render_el_status(self) -> str:
        return "✅🎛️"
