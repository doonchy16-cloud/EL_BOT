"""Deterministic native-vision curriculum and pixel utilities for Forgey Insta:EL-Bot.

Positive visual truth is generated from known scene construction, never from a
provider or from the model's own output. The same utilities supply training replay,
held-out probes, PNG decoding/encoding, and packaged provider-free proof.
"""
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Iterable
import binascii
import random
import struct
import zlib

import torch
from torch import Tensor
from torch.nn import functional as F


IMAGE_SIZE = 64


@dataclass(frozen=True, slots=True)
class VisualConcept:
    key: str
    abc: str
    el: str
    family: str


@dataclass(frozen=True, slots=True)
class VisualExample:
    concept: str
    direction: str
    target: str
    seed: int


CONCEPTS = (
    VisualConcept("red-circle", "red circle", "🔴", "circle"),
    VisualConcept("blue-circle", "blue circle", "🔵", "circle"),
    VisualConcept("green-circle", "green circle", "🟢", "circle"),
    VisualConcept("yellow-circle", "yellow circle", "🟡", "circle"),
    VisualConcept("red-square", "red square", "🟥", "square"),
    VisualConcept("blue-square", "blue square", "🟦", "square"),
    VisualConcept("green-square", "green square", "🟩", "square"),
    VisualConcept("yellow-square", "yellow square", "🟨", "square"),
    VisualConcept("warning", "warning", "⚠️", "warning"),
    VisualConcept("check-mark", "check mark", "✅", "check"),
    VisualConcept("cross-mark", "cross mark", "❌", "cross"),
    VisualConcept("right-arrow", "right arrow", "➡️", "right-arrow"),
    VisualConcept("left-arrow", "left arrow", "⬅️", "left-arrow"),
)
CONCEPT_BY_KEY = {item.key: item for item in CONCEPTS}

_COLORS = {
    "red": torch.tensor((0.92, 0.10, 0.13), dtype=torch.float32),
    "blue": torch.tensor((0.12, 0.38, 0.94), dtype=torch.float32),
    "green": torch.tensor((0.12, 0.78, 0.28), dtype=torch.float32),
    "yellow": torch.tensor((0.98, 0.78, 0.06), dtype=torch.float32),
    "white": torch.tensor((0.95, 0.95, 0.95), dtype=torch.float32),
    "black": torch.tensor((0.03, 0.03, 0.04), dtype=torch.float32),
}


def concept(key: str) -> VisualConcept:
    value = CONCEPT_BY_KEY.get(str(key))
    if value is None:
        raise ValueError(f"unknown Forgey visual concept: {key}")
    return value


def _mesh(size: int = IMAGE_SIZE) -> tuple[Tensor, Tensor]:
    values = torch.arange(size, dtype=torch.float32)
    y, x = torch.meshgrid(values, values, indexing="ij")
    return x, y


def _paint(image: Tensor, mask: Tensor, color: Tensor) -> None:
    image[:, mask] = color.to(image.device).view(3, 1)


def _segment_mask(x: Tensor, y: Tensor, x1: float, y1: float, x2: float, y2: float, width: float) -> Tensor:
    vx, vy = x2 - x1, y2 - y1
    denom = max(vx * vx + vy * vy, 1e-6)
    t = ((x - x1) * vx + (y - y1) * vy) / denom
    t = t.clamp(0.0, 1.0)
    px, py = x1 + t * vx, y1 + t * vy
    return ((x - px) ** 2 + (y - py) ** 2) <= width * width


def _base(seed: int) -> tuple[Tensor, random.Random, Tensor, Tensor]:
    rng = random.Random(int(seed))
    generator = torch.Generator().manual_seed(int(seed) & 0x7FFFFFFF)
    background = 0.025 + 0.055 * torch.rand((3, 1, 1), generator=generator)
    image = background.expand(3, IMAGE_SIZE, IMAGE_SIZE).clone()
    noise = (torch.rand((3, IMAGE_SIZE, IMAGE_SIZE), generator=generator) - 0.5) * 0.018
    image = (image + noise).clamp(0.0, 1.0)
    x, y = _mesh()
    return image, rng, x, y


def _colored_shape(image: Tensor, rng: random.Random, x: Tensor, y: Tensor, item: VisualConcept) -> None:
    color_name = item.key.split("-", 1)[0]
    color = _COLORS[color_name] * rng.uniform(0.88, 1.05)
    cx = rng.uniform(27.0, 37.0)
    cy = rng.uniform(27.0, 37.0)
    radius = rng.uniform(13.0, 18.0)
    if item.family == "circle":
        mask = (x - cx) ** 2 + (y - cy) ** 2 <= radius ** 2
    else:
        mask = ((x - cx).abs() <= radius) & ((y - cy).abs() <= radius)
    _paint(image, mask, color.clamp(0.0, 1.0))


def _warning(image: Tensor, rng: random.Random, x: Tensor, y: Tensor) -> None:
    cx = rng.uniform(30.0, 34.0)
    top = rng.uniform(10.0, 14.0)
    bottom = rng.uniform(50.0, 55.0)
    half = rng.uniform(22.0, 26.0)
    t = ((y - top) / max(bottom - top, 1.0)).clamp(0.0, 1.0)
    triangle = (y >= top) & (y <= bottom) & ((x - cx).abs() <= half * t)
    _paint(image, triangle, _COLORS["yellow"])
    bar = ((x - cx).abs() <= 2.2) & (y >= top + 14.0) & (y <= bottom - 12.0)
    dot = (x - cx) ** 2 + (y - (bottom - 6.5)) ** 2 <= 2.8 ** 2
    _paint(image, bar | dot, _COLORS["black"])


def _check(image: Tensor, rng: random.Random, x: Tensor, y: Tensor) -> None:
    dx = rng.uniform(-3.0, 3.0); dy = rng.uniform(-3.0, 3.0)
    a = _segment_mask(x, y, 16 + dx, 33 + dy, 28 + dx, 45 + dy, 3.5)
    b = _segment_mask(x, y, 28 + dx, 45 + dy, 50 + dx, 19 + dy, 3.5)
    _paint(image, a | b, _COLORS["green"])


def _cross(image: Tensor, rng: random.Random, x: Tensor, y: Tensor) -> None:
    d = rng.uniform(-2.0, 2.0)
    a = _segment_mask(x, y, 18 + d, 18, 46 + d, 46, 4.0)
    b = _segment_mask(x, y, 46 + d, 18, 18 + d, 46, 4.0)
    _paint(image, a | b, _COLORS["red"])


def _arrow(image: Tensor, rng: random.Random, x: Tensor, y: Tensor, right: bool) -> None:
    cy = rng.uniform(30.0, 34.0)
    if right:
        shaft = (x >= 13.0) & (x <= 43.0) & ((y - cy).abs() <= 4.0)
        head = (x >= 38.0) & (x <= 54.0) & ((y - cy).abs() <= (x - 38.0) * 0.72 + 1.5)
    else:
        shaft = (x >= 21.0) & (x <= 51.0) & ((y - cy).abs() <= 4.0)
        head = (x >= 10.0) & (x <= 26.0) & ((y - cy).abs() <= (26.0 - x) * 0.72 + 1.5)
    _paint(image, shaft | head, _COLORS["white"])


def render_concept(key: str, seed: int) -> Tensor:
    item = concept(key)
    image, rng, x, y = _base(seed)
    if item.family in {"circle", "square"}:
        _colored_shape(image, rng, x, y, item)
    elif item.family == "warning":
        _warning(image, rng, x, y)
    elif item.family == "check":
        _check(image, rng, x, y)
    elif item.family == "cross":
        _cross(image, rng, x, y)
    elif item.family == "right-arrow":
        _arrow(image, rng, x, y, True)
    elif item.family == "left-arrow":
        _arrow(image, rng, x, y, False)
    else:
        raise RuntimeError(f"unimplemented visual family: {item.family}")
    return image.clamp(0.0, 1.0)


def training_examples(per_concept: int = 12) -> tuple[VisualExample, ...]:
    rows: list[VisualExample] = []
    for index, item in enumerate(CONCEPTS):
        for variant in range(int(per_concept)):
            seed = 1000 + index * 100 + variant
            rows.append(VisualExample(item.key, "IMAGE_TO_EL", item.el, seed))
            rows.append(VisualExample(item.key, "IMAGE_TO_ABC", item.abc, seed))
    return tuple(rows)


def probe_examples() -> tuple[VisualExample, ...]:
    keys = ("red-circle", "blue-square", "warning", "right-arrow")
    rows: list[VisualExample] = []
    for index, key in enumerate(keys):
        item = concept(key); seed = 9000 + index
        rows.append(VisualExample(key, "IMAGE_TO_EL", item.el, seed))
        rows.append(VisualExample(key, "IMAGE_TO_ABC", item.abc, seed))
    return tuple(rows)


def _collate_targets(tokenizer: Any, examples: Iterable[VisualExample], device: torch.device) -> tuple[Tensor, Tensor]:
    rows = tuple(examples)
    encoded = [tokenizer.encode_target(item.target) for item in rows]
    length = max(len(decoder) for decoder, _ in encoded)
    decoder = torch.full((len(encoded), length), tokenizer.pad_id, dtype=torch.long, device=device)
    labels = torch.full((len(encoded), length), -100, dtype=torch.long, device=device)
    for index, (dec, lab) in enumerate(encoded):
        decoder[index, :len(dec)] = torch.tensor(dec, dtype=torch.long, device=device)
        labels[index, :len(lab)] = torch.tensor(lab, dtype=torch.long, device=device)
    return decoder, labels


def evaluate_visual_probes(model: Any, tokenizer: Any, device: torch.device | str = "cpu") -> list[dict[str, Any]]:
    target_device = torch.device(device)
    rows: list[dict[str, Any]] = []
    model.eval()
    for item in probe_examples():
        image = render_concept(item.concept, item.seed).to(target_device)
        prediction, confidence = model.greedy_generate_image(
            tokenizer,
            item.direction,
            image,
            max_new_tokens=24,
            device=target_device,
            return_confidence=True,
        )
        rows.append({
            "concept": item.concept,
            "direction": item.direction,
            "seed": item.seed,
            "expected": item.target,
            "prediction": prediction,
            "exact": prediction.casefold() == item.target.casefold(),
            "confidence": float(confidence),
        })
    return rows


def train_visual_adapter(
    model: Any,
    tokenizer: Any,
    *,
    steps: int = 360,
    batch_size: int = 28,
    seed: int = 640260818,
    learning_rate: float = 0.002,
    device: torch.device | str = "cpu",
) -> dict[str, Any]:
    target_device = torch.device(device)
    examples = training_examples()
    rng = random.Random(int(seed))
    torch.manual_seed(int(seed))
    visual_parameters = tuple(model.vision_parameters())
    if not visual_parameters:
        raise RuntimeError("Forgey Insta visual adapter parameters are unavailable")

    original_requires = {id(parameter): bool(parameter.requires_grad) for parameter in model.parameters()}
    for parameter in model.parameters(): parameter.requires_grad_(False)
    for parameter in visual_parameters: parameter.requires_grad_(True)

    optimizer = torch.optim.AdamW(visual_parameters, lr=float(learning_rate), betas=(0.9, 0.98), weight_decay=0.005)
    losses: list[float] = []
    try:
        model.train()
        for step in range(int(steps)):
            selected = [examples[index] for index in rng.choices(range(len(examples)), k=int(batch_size))]
            images = torch.stack([render_concept(item.concept, item.seed) for item in selected]).to(target_device)
            directions = [item.direction for item in selected]
            decoder, labels = _collate_targets(tokenizer, selected, target_device)
            optimizer.zero_grad(set_to_none=True)
            logits = model.forward_image(images, directions, decoder)
            loss = F.cross_entropy(logits.reshape(-1, logits.size(-1)), labels.reshape(-1), ignore_index=-100)
            if not torch.isfinite(loss):
                raise RuntimeError(f"non-finite native-vision loss at step {step + 1}")
            loss.backward()
            torch.nn.utils.clip_grad_norm_(visual_parameters, max_norm=1.0)
            optimizer.step()
            losses.append(float(loss.item()))
            if step == 0 or (step + 1) % 90 == 0:
                print(f"FORGEY_VISION_TRAIN step={step + 1}/{steps} loss={losses[-1]:.6f}", flush=True)
    finally:
        for parameter in model.parameters(): parameter.requires_grad_(original_requires[id(parameter)])

    model.eval()
    probes = evaluate_visual_probes(model, tokenizer, target_device)
    window = min(30, max(5, len(losses) // 5))
    early = sum(losses[:window]) / window
    late = sum(losses[-window:]) / window
    exact = sum(1 for item in probes if item["exact"])
    return {
        "truth_source": "deterministic synthetic pixel scenes",
        "provider_generated_truth_count": 0,
        "unverified_self_output_truth_count": 0,
        "steps": int(steps),
        "batch_size": int(batch_size),
        "training_examples": len(examples),
        "concept_count": len(CONCEPTS),
        "early_loss": early,
        "late_loss": late,
        "probe_exact_count": exact,
        "probe_total": len(probes),
        "probes": probes,
    }


def _paeth(a: int, b: int, c: int) -> int:
    p = a + b - c
    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
    return a if pa <= pb and pa <= pc else b if pb <= pc else c


def decode_png(data: bytes) -> Tensor:
    raw = bytes(data)
    if not raw.startswith(b"\x89PNG\r\n\x1a\n"):
        raise ValueError("native Forgey vision currently requires PNG pixel input")
    offset = 8; width = height = color_type = bit_depth = interlace = None; compressed = bytearray()
    while offset + 12 <= len(raw):
        length = struct.unpack(">I", raw[offset:offset + 4])[0]
        kind = raw[offset + 4:offset + 8]
        payload = raw[offset + 8:offset + 8 + length]
        crc = raw[offset + 8 + length:offset + 12 + length]
        if len(payload) != length or len(crc) != 4: raise ValueError("truncated PNG")
        if struct.unpack(">I", crc)[0] != (binascii.crc32(kind + payload) & 0xFFFFFFFF): raise ValueError("PNG CRC mismatch")
        offset += 12 + length
        if kind == b"IHDR": width, height, bit_depth, color_type, _, _, interlace = struct.unpack(">IIBBBBB", payload)
        elif kind == b"IDAT": compressed.extend(payload)
        elif kind == b"IEND": break
    if not width or not height or bit_depth != 8 or interlace != 0: raise ValueError("unsupported PNG geometry/bit depth/interlace")
    channels = {0: 1, 2: 3, 4: 2, 6: 4}.get(color_type)
    if channels is None: raise ValueError(f"unsupported PNG color type: {color_type}")
    inflated = zlib.decompress(bytes(compressed)); stride = int(width) * channels
    if len(inflated) != int(height) * (stride + 1): raise ValueError("PNG decompressed size mismatch")
    rows: list[bytearray] = []; previous = bytearray(stride); cursor = 0
    for _ in range(int(height)):
        filter_type = inflated[cursor]; cursor += 1
        scan = bytearray(inflated[cursor:cursor + stride]); cursor += stride
        reconstructed = bytearray(stride)
        for index, value in enumerate(scan):
            left = reconstructed[index - channels] if index >= channels else 0
            up = previous[index]; up_left = previous[index - channels] if index >= channels else 0
            if filter_type == 0: result = value
            elif filter_type == 1: result = (value + left) & 255
            elif filter_type == 2: result = (value + up) & 255
            elif filter_type == 3: result = (value + ((left + up) // 2)) & 255
            elif filter_type == 4: result = (value + _paeth(left, up, up_left)) & 255
            else: raise ValueError(f"unsupported PNG filter: {filter_type}")
            reconstructed[index] = result
        rows.append(reconstructed); previous = reconstructed
    rgb = bytearray(int(width) * int(height) * 3); out = 0
    for row in rows:
        for xx in range(int(width)):
            base = xx * channels
            if color_type == 0:
                r = g = b = row[base]
            elif color_type == 4:
                gray, alpha = row[base], row[base + 1]; r = g = b = int((gray * alpha + 255 * (255 - alpha)) / 255)
            elif color_type == 2:
                r, g, b = row[base:base + 3]
            else:
                r0, g0, b0, alpha = row[base:base + 4]
                r = int((r0 * alpha + 255 * (255 - alpha)) / 255); g = int((g0 * alpha + 255 * (255 - alpha)) / 255); b = int((b0 * alpha + 255 * (255 - alpha)) / 255)
            rgb[out:out + 3] = bytes((r, g, b)); out += 3
    tensor = torch.frombuffer(rgb, dtype=torch.uint8).clone().reshape(int(height), int(width), 3).permute(2, 0, 1).to(torch.float32) / 255.0
    return tensor


def encode_png(image: Tensor) -> bytes:
    value = image.detach().to(dtype=torch.float32, device="cpu")
    if value.ndim != 3 or value.size(0) != 3: raise ValueError("PNG encoder expects [3,height,width]")
    value = (value.clamp(0.0, 1.0) * 255.0).round().to(torch.uint8)
    height, width = int(value.size(1)), int(value.size(2)); scan = bytearray()
    for yy in range(height):
        scan.append(0)
        for xx in range(width): scan.extend((int(value[0, yy, xx]), int(value[1, yy, xx]), int(value[2, yy, xx])))
    def chunk(kind: bytes, payload: bytes) -> bytes:
        return struct.pack(">I", len(payload)) + kind + payload + struct.pack(">I", binascii.crc32(kind + payload) & 0xFFFFFFFF)
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(scan), 9)) + chunk(b"IEND", b"")
