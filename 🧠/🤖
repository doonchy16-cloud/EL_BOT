"""Phase 6 EL Student: a from-scratch, provider-free ~1M-parameter emoji specialist.

Architecture at Unicode Emoji 17.0 / 3953 output units:
  256 hashed semantic/text features -> 256 tanh hidden units -> 3953 emoji logits
  trainable parameters = 256*256 + 256 + 256*3953 + 3953 = 1,081,713

The student contains no pretrained weights. It learns only from examples supplied by
EL Bot's Instructor/teacher coordinator. Provider access is forbidden in this module.
"""
from __future__ import annotations

from array import array
from dataclasses import dataclass
from functools import lru_cache
from hashlib import blake2b, sha256
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import json
import math
import os
import re
import struct
import sys


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("module spec unavailable")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_core = _load("_el_student_core", _ROOT / "⚙️" / "⚙️")
_lexical = _load("_el_student_lexical", _ROOT / "📚" / "📖")

INPUT_DIM = 256
HIDDEN_DIM = 256
MODEL_SCHEMA = 1
_MAGIC = b"EL1M0001"
_WORD = re.compile(r"[a-z0-9]+(?:'[a-z0-9]+)?", re.I)
_STRUCTURAL = frozenset({"➡️", "⬅️", "↔️", "➕", "🔀", "🚦", "🔗", "❓", "🟡"})


def _normalize(value: str) -> str:
    return " ".join(_WORD.findall(str(value).lower()))


def _sigmoid(value: float) -> float:
    if value >= 0:
        z = math.exp(-min(60.0, value))
        return 1.0 / (1.0 + z)
    z = math.exp(max(-60.0, value))
    return z / (1.0 + z)


def _hash64(value: str) -> int:
    return int.from_bytes(blake2b(value.encode("utf-8"), digest_size=8, person=b"ELStudent").digest(), "little")


@dataclass(frozen=True, slots=True)
class StudentPrediction:
    source: str
    candidates: tuple[str, ...]
    scores: tuple[float, ...]
    confidence: float
    margin: float
    support: int
    trained_examples: int
    parameter_count: int
    model_signature: str
    ready: bool

    @property
    def winner(self) -> str:
        return self.candidates[0] if self.candidates else ""


@dataclass(frozen=True, slots=True)
class StudentTrainResult:
    source: str
    targets: tuple[str, ...]
    trained: bool
    epochs: int
    updates: int
    examples_seen: int
    parameter_count: int


class ELStudent1M:
    """Small trainable MLP dedicated to English/semantic text -> emoji candidates."""

    def __init__(self, path: str | Path | None = None) -> None:
        default = Path(os.environ.get("EL_STUDENT_MODEL", "")).expanduser() if os.environ.get("EL_STUDENT_MODEL") else Path.home() / ".el-bot" / "student-1m-v1.bin"
        self.path = Path(path).expanduser() if path is not None else default
        emoji = _lexical.resolver().emoji
        self.symbols = tuple(emoji.units)
        self.emoji_version = str(emoji.version)
        self.class_index = {symbol: index for index, symbol in enumerate(self.symbols)}
        self.output_dim = len(self.symbols)
        self.parameter_count = INPUT_DIM * HIDDEN_DIM + HIDDEN_DIM + HIDDEN_DIM * self.output_dim + self.output_dim
        digest = sha256((self.emoji_version + "\0" + "".join(self.symbols)).encode("utf-8")).hexdigest()[:24]
        self.model_signature = f"el-student-1m:s{MODEL_SCHEMA}:i{INPUT_DIM}:h{HIDDEN_DIM}:o{self.output_dim}:{digest}"
        self.w1 = array("f")
        self.b1 = array("f")
        self.w2 = array("f")
        self.b2 = array("f")
        self.support = array("I")
        self.examples_seen = 0
        self.teacher_examples = 0
        self.user_examples = 0
        self.deterministic_examples = 0
        self.updates = 0
        self._initialize_or_load()

    @property
    def available(self) -> bool:
        return self.output_dim > 0 and bool(self.w1) and bool(self.w2)

    def _initialize_or_load(self) -> None:
        if self.path.is_file():
            try:
                self._load_file()
                return
            except Exception:
                # A changed Unicode universe or damaged model must never be silently
                # reused. Preserve it for recovery and begin a fresh untrained student.
                try:
                    backup = self.path.with_name(self.path.name + ".incompatible")
                    if backup.exists():
                        backup.unlink()
                    self.path.replace(backup)
                except OSError:
                    pass
        self._initialize_fresh()

    def _initialize_fresh(self) -> None:
        self.w1 = array("f", [0.0]) * (INPUT_DIM * HIDDEN_DIM)
        self.b1 = array("f", [0.0]) * HIDDEN_DIM
        self.w2 = array("f", [0.0]) * (self.output_dim * HIDDEN_DIM)
        self.b2 = array("f", [0.0]) * self.output_dim
        self.support = array("I", [0]) * self.output_dim
        # Only the first projection needs symmetry-breaking. Output weights start at
        # zero, so the student truly has no pretrained class knowledge.
        state = 0x6D2B79F5
        for index in range(len(self.w1)):
            state = (1664525 * state + 1013904223) & 0xFFFFFFFF
            self.w1[index] = (((state / 0xFFFFFFFF) * 2.0) - 1.0) * 0.018
        self.examples_seen = self.teacher_examples = self.user_examples = self.deterministic_examples = self.updates = 0

    def _header(self) -> dict:
        return {
            "schema": MODEL_SCHEMA,
            "signature": self.model_signature,
            "emoji_version": self.emoji_version,
            "input_dim": INPUT_DIM,
            "hidden_dim": HIDDEN_DIM,
            "output_dim": self.output_dim,
            "parameter_count": self.parameter_count,
            "examples_seen": self.examples_seen,
            "teacher_examples": self.teacher_examples,
            "user_examples": self.user_examples,
            "deterministic_examples": self.deterministic_examples,
            "updates": self.updates,
        }

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.path.with_name(self.path.name + ".tmp")
        header = json.dumps(self._header(), sort_keys=True, separators=(",", ":")).encode("utf-8")
        with temporary.open("wb") as handle:
            handle.write(_MAGIC)
            handle.write(struct.pack("<I", len(header)))
            handle.write(header)
            for values in (self.w1, self.b1, self.w2, self.b2, self.support):
                if sys.byteorder != "little":
                    values = array(values.typecode, values)
                    values.byteswap()
                handle.write(values.tobytes())
        os.replace(temporary, self.path)

    def _load_file(self) -> None:
        with self.path.open("rb") as handle:
            if handle.read(len(_MAGIC)) != _MAGIC:
                raise ValueError("invalid EL Student model magic")
            raw = handle.read(4)
            if len(raw) != 4:
                raise ValueError("truncated EL Student model")
            header_size = struct.unpack("<I", raw)[0]
            header = json.loads(handle.read(header_size).decode("utf-8"))
            if header.get("schema") != MODEL_SCHEMA or header.get("signature") != self.model_signature:
                raise ValueError("EL Student model signature mismatch")
            counts = (INPUT_DIM * HIDDEN_DIM, HIDDEN_DIM, self.output_dim * HIDDEN_DIM, self.output_dim, self.output_dim)
            arrays = []
            for typecode, count in zip(("f", "f", "f", "f", "I"), counts):
                item = array(typecode)
                size = item.itemsize * count
                payload = handle.read(size)
                if len(payload) != size:
                    raise ValueError("truncated EL Student parameters")
                item.frombytes(payload)
                if sys.byteorder != "little":
                    item.byteswap()
                arrays.append(item)
            if handle.read(1):
                raise ValueError("unexpected trailing EL Student data")
        self.w1, self.b1, self.w2, self.b2, self.support = arrays
        self.examples_seen = int(header.get("examples_seen", 0))
        self.teacher_examples = int(header.get("teacher_examples", 0))
        self.user_examples = int(header.get("user_examples", 0))
        self.deterministic_examples = int(header.get("deterministic_examples", 0))
        self.updates = int(header.get("updates", 0))

    @staticmethod
    def _feature_tokens(source: str) -> tuple[str, ...]:
        value = _normalize(source)
        if not value:
            return ()
        words = value.split()
        features: list[str] = ["bias", "whole:" + value]
        for word in words:
            marked = "^" + word + "$"
            features.append("word:" + word)
            features.append("prefix:" + word[: min(4, len(word))])
            features.append("suffix:" + word[-min(4, len(word)):])
            for width in (2, 3, 4, 5):
                if len(marked) < width:
                    continue
                for index in range(len(marked) - width + 1):
                    features.append(f"c{width}:" + marked[index:index + width])
        for width in (2, 3):
            if len(words) >= width:
                for index in range(len(words) - width + 1):
                    features.append(f"w{width}:" + " ".join(words[index:index + width]))
        return tuple(features)

    @classmethod
    def encode(cls, source: str) -> tuple[tuple[int, float], ...]:
        accum: dict[int, float] = {}
        for token in cls._feature_tokens(source):
            digest = _hash64(token)
            index = digest % INPUT_DIM
            sign = -1.0 if (digest >> 63) else 1.0
            accum[index] = accum.get(index, 0.0) + sign
        if not accum:
            return ()
        norm = math.sqrt(sum(value * value for value in accum.values())) or 1.0
        return tuple(sorted((index, value / norm) for index, value in accum.items()))

    def _hidden(self, features: tuple[tuple[int, float], ...]) -> list[float]:
        hidden = [float(value) for value in self.b1]
        for feature_index, feature_value in features:
            base = feature_index * HIDDEN_DIM
            for hidden_index in range(HIDDEN_DIM):
                hidden[hidden_index] += float(self.w1[base + hidden_index]) * feature_value
        return [math.tanh(value) for value in hidden]

    def _logit(self, class_index: int, hidden: list[float]) -> float:
        base = class_index * HIDDEN_DIM
        value = float(self.b2[class_index])
        for hidden_index, hidden_value in enumerate(hidden):
            value += float(self.w2[base + hidden_index]) * hidden_value
        return value

    def predict(self, source: str, *, top_k: int = 5) -> StudentPrediction:
        features = self.encode(source)
        if not self.available or not features or self.examples_seen <= 0:
            return StudentPrediction(source, (), (), 0.0, 0.0, 0, self.examples_seen, self.parameter_count, self.model_signature, False)
        hidden = self._hidden(features)
        ranked: list[tuple[float, int]] = []
        for class_index in range(self.output_dim):
            score = self._logit(class_index, hidden)
            if len(ranked) < max(2, top_k):
                ranked.append((score, class_index)); ranked.sort(reverse=True)
            elif score > ranked[-1][0]:
                ranked[-1] = (score, class_index); ranked.sort(reverse=True)
        ranked = ranked[:max(2, top_k)]
        if not ranked:
            return StudentPrediction(source, (), (), 0.0, 0.0, 0, self.examples_seen, self.parameter_count, self.model_signature, False)
        top_score = ranked[0][0]
        second = ranked[1][0] if len(ranked) > 1 else top_score - 1.0
        margin = top_score - second
        support = int(self.support[ranked[0][1]])
        support_factor = 0.0 if support <= 0 else 1.0 - math.exp(-(support + 0.5) / 1.5)
        confidence = max(0.0, min(1.0, _sigmoid(margin * 1.35) * support_factor))
        return StudentPrediction(
            source=source,
            candidates=tuple(self.symbols[index] for _score, index in ranked[:top_k]),
            scores=tuple(round(float(score), 6) for score, _index in ranked[:top_k]),
            confidence=round(confidence, 6),
            margin=round(margin, 6),
            support=support,
            trained_examples=self.examples_seen,
            parameter_count=self.parameter_count,
            model_signature=self.model_signature,
            ready=support > 0,
        )

    def _target_indices(self, candidate: str) -> tuple[int, ...]:
        out: list[int] = []
        for unit in _core.split_graphemes(str(candidate)):
            if unit in _STRUCTURAL:
                continue
            index = self.class_index.get(unit)
            if index is not None and index not in out:
                out.append(index)
        return tuple(out)

    def _negative_indices(self, source: str, target: int, epoch: int, count: int) -> tuple[int, ...]:
        if self.output_dim <= 1:
            return ()
        out: list[int] = []
        state = _hash64(f"neg:{source}:{target}:{epoch}") & 0xFFFFFFFFFFFFFFFF
        while len(out) < min(count, self.output_dim - 1):
            state = (6364136223846793005 * state + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
            index = state % self.output_dim
            if index != target and index not in out:
                out.append(index)
        return tuple(out)

    def _train_target(self, features: tuple[tuple[int, float], ...], source: str, target: int, *, epochs: int, learning_rate: float, weight: float) -> int:
        updates = 0
        for epoch in range(epochs):
            hidden = self._hidden(features)
            hidden_grad = [0.0] * HIDDEN_DIM
            classes = (target,) + self._negative_indices(source, target, epoch, 31)
            for class_index in classes:
                y = 1.0 if class_index == target else 0.0
                base = class_index * HIDDEN_DIM
                logit = float(self.b2[class_index])
                for hidden_index, hidden_value in enumerate(hidden):
                    logit += float(self.w2[base + hidden_index]) * hidden_value
                probability = _sigmoid(logit)
                grad = max(-1.0, min(1.0, (probability - y) * weight))
                for hidden_index, hidden_value in enumerate(hidden):
                    old = float(self.w2[base + hidden_index])
                    hidden_grad[hidden_index] += grad * old
                    self.w2[base + hidden_index] = old - learning_rate * grad * hidden_value
                self.b2[class_index] = float(self.b2[class_index]) - learning_rate * grad
                updates += 1
            for hidden_index in range(HIDDEN_DIM):
                hidden_grad[hidden_index] *= (1.0 - hidden[hidden_index] * hidden[hidden_index])
                hidden_grad[hidden_index] = max(-1.0, min(1.0, hidden_grad[hidden_index]))
            for feature_index, feature_value in features:
                base = feature_index * HIDDEN_DIM
                for hidden_index in range(HIDDEN_DIM):
                    self.w1[base + hidden_index] = float(self.w1[base + hidden_index]) - learning_rate * hidden_grad[hidden_index] * feature_value
        return updates

    def train(self, source: str, candidate: str, *, origin: str, epochs: int = 10, learning_rate: float = 0.065, weight: float = 1.0, save: bool = True) -> StudentTrainResult:
        normalized = _normalize(source)
        features = self.encode(normalized)
        targets = self._target_indices(candidate)
        if not normalized or not features or not targets:
            return StudentTrainResult(source, tuple(self.symbols[index] for index in targets), False, 0, 0, self.examples_seen, self.parameter_count)
        epochs = max(1, min(64, int(epochs)))
        learning_rate = max(0.001, min(0.25, float(learning_rate)))
        weight = max(0.1, min(2.0, float(weight)))
        update_count = 0
        for target in targets:
            update_count += self._train_target(features, normalized, target, epochs=epochs, learning_rate=learning_rate, weight=weight)
            self.support[target] = int(self.support[target]) + 1
        self.examples_seen += 1
        origin_name = str(origin or "unknown").lower()
        if origin_name == "qwen-teacher":
            self.teacher_examples += 1
        elif origin_name == "user":
            self.user_examples += 1
        elif origin_name == "deterministic":
            self.deterministic_examples += 1
        self.updates += update_count
        if save:
            self.save()
        return StudentTrainResult(source, tuple(self.symbols[index] for index in targets), True, epochs, update_count, self.examples_seen, self.parameter_count)

    def stats(self) -> dict:
        return {
            "schema": MODEL_SCHEMA,
            "model_signature": self.model_signature,
            "emoji_version": self.emoji_version,
            "input_dim": INPUT_DIM,
            "hidden_dim": HIDDEN_DIM,
            "output_dim": self.output_dim,
            "parameter_count": self.parameter_count,
            "examples_seen": self.examples_seen,
            "teacher_examples": self.teacher_examples,
            "user_examples": self.user_examples,
            "deterministic_examples": self.deterministic_examples,
            "updates": self.updates,
            "model_bytes": self.path.stat().st_size if self.path.is_file() else 0,
        }
