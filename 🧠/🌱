"""Trusted bootstrap curriculum for Forgey Insta:EL-Bot G1.

Step 2 only. No provider/teacher output is accepted here. Training truth is derived
from official Unicode emoji names, the already-validated historical semantic seed,
and explicit deterministic EL structural examples. Frozen benchmark source keys are
removed before the curriculum is returned.
"""
from __future__ import annotations

from dataclasses import dataclass
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import json
import sys
from typing import Iterable


def _load(name: str, path: Path):
    if name in sys.modules:
        return sys.modules[name]
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError(f"module spec unavailable: {path}")
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_ROOT = Path(__file__).resolve().parent.parent
_lexical = _load("_forgey_insta_curriculum_lexical", _ROOT / "📚" / "📖")
_vocab = _load("_forgey_insta_curriculum_vocab", _ROOT / "📚" / "📚")
_meanings = _load("_forgey_insta_curriculum_meanings", _ROOT / "📚" / "🧾")


