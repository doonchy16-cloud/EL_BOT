def load_frozen_benchmark(path: Path) -> tuple[dict, ...]:
    payload = json.loads(Path(path).read_text(encoding="utf-8"))
    if payload.get("frozen") is not True or payload.get("training_replay_forbidden") is not True:
        raise ValueError("Step-2 benchmark is not frozen/training-forbidden")
    examples = tuple(payload.get("examples", ()))
    if not examples:
        raise ValueError("Step-2 frozen benchmark is empty")
    return examples


def _dedupe(examples: Iterable[CurriculumExample]) -> tuple[CurriculumExample, ...]:
    chosen: dict[tuple[str, str, str], CurriculumExample] = {}
    for example in examples:
        if not example.source or not example.target:
            continue
        key = (example.direction, example.source, example.target)
        previous = chosen.get(key)
        if previous is None or example.weight > previous.weight:
            chosen[key] = example
    return tuple(chosen[key] for key in sorted(chosen))


def build_bootstrap_curriculum(benchmark_path: Path) -> tuple[tuple[CurriculumExample, ...], CurriculumReport]:
    benchmark = load_frozen_benchmark(benchmark_path)
    forbidden_keys = {(str(item["direction"]), str(item["source"])) for item in benchmark}
    resolver = _lexical.resolver()
    if not resolver.emoji.lexemes:
        raise RuntimeError("Unicode emoji knowledge is not materialized")

    rows: list[CurriculumExample] = []
    official_count = 0
    historical_count = 0

    # Official released Unicode names are the broad atomic bootstrap teacher.
    for lexeme in resolver.emoji.lexemes:
        name = str(lexeme.name).strip()
        symbol = str(lexeme.symbol)
        if not name or not symbol:
            continue
        variants = (
            CurriculumExample("ABC_TO_EL", name, symbol, "unicode-name", "unicode-emoji-test", 3),
            CurriculumExample("ABC_TO_EL", "a " + name, symbol, "unicode-name", "unicode-emoji-test", 1),
            CurriculumExample("ABC_TO_EL", "the " + name, symbol, "unicode-name", "unicode-emoji-test", 1),
            CurriculumExample("EL_TO_ABC", symbol, name, "unicode-name", "unicode-emoji-test", 3),
        )
        for example in variants:
            if example.key not in forbidden_keys:
                rows.append(example)
                official_count += 1

    # Preserve historically validated semantic meanings as bootstrap evidence, but
    # do not treat the old semantic seed size as a product vocabulary ceiling.
    symbols = tuple(getattr(_vocab, "CANONICAL_SYMBOLS"))
    meanings = tuple(getattr(_meanings, "PRIMARY_MEANINGS"))
    if len(symbols) != len(meanings):
        raise RuntimeError("historical semantic seed alignment is broken")
    for symbol, meaning in zip(symbols, meanings, strict=True):
        normalized = str(meaning).strip().lower()
        if not normalized:
            continue
        forward = CurriculumExample("ABC_TO_EL", normalized, str(symbol), "historical-semantic", "phase1-5-validated-seed", 2)
        reverse = CurriculumExample("EL_TO_ABC", str(symbol), normalized, "historical-semantic", "phase1-5-validated-seed", 2)
        if forward.key not in forbidden_keys:
            rows.append(forward)
            historical_count += 1
        if reverse.key not in forbidden_keys:
            rows.append(reverse)
            historical_count += 1

    structural_count = 0
    for example in STRUCTURAL_EXAMPLES:
        if example.key not in forbidden_keys:
            rows.append(example)
            structural_count += 1

    curriculum = _dedupe(rows)
    # Hard leak gate: no frozen benchmark source key can exist in training/replay.
    leaked = tuple(example.key for example in curriculum if example.key in forbidden_keys)
    if leaked:
        raise RuntimeError(f"frozen benchmark leaked into curriculum: {leaked[:5]}")

    report = CurriculumReport(
        example_count=len(curriculum),
        abc_to_el_count=sum(1 for item in curriculum if item.direction == "ABC_TO_EL"),
        el_to_abc_count=sum(1 for item in curriculum if item.direction == "EL_TO_ABC"),
        official_unicode_count=official_count,
        historical_semantic_count=historical_count,
        structural_count=structural_count,
        excluded_benchmark_keys=len(forbidden_keys),
    )
    return curriculum, report


def english_training_texts(examples: Iterable[CurriculumExample]) -> tuple[str, ...]:
    """English surfaces supplied to BPE training, independent of model direction."""
    values: list[str] = []
    for example in examples:
        if example.direction == "ABC_TO_EL":
            values.append(example.source)
        else:
            values.append(example.target)
    return tuple(values)
