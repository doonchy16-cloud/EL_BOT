@dataclass(frozen=True, slots=True)
class EngineResult:
    mode: int; source: str; candidates: tuple[Candidate,...]; stages: tuple[str,...]; metrics: dict[str,float|int|str]=field(default_factory=dict)
    @property
    def winner(self) -> str:
        return self.candidates[0].value if self.candidates else ("🟡❓" if self.mode==2 else "Unable to translate the available EL input.")
    def as_dict(self) -> dict:
        return {"mode":self.mode,"winner":self.winner,"candidates":[{"value":c.value,"score":round(c.score,3),"reasons":list(c.reasons),"coverage":round(c.coverage,3),"roundtrip":round(c.roundtrip,3)} for c in self.candidates],"stages":list(self.stages),"metrics":dict(self.metrics)}

