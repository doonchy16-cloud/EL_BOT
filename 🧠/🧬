@dataclass(frozen=True, slots=True)
class NumberBinding:
    number: str; unit: str; start: int; end: int
    @property
    def el(self) -> str:
        if self.unit.lower() in TEMPORAL_UNIT_SYMBOLS: return "⏱️" + self.number
        if self.unit.lower() in {"percent","%"}: return "💯" + self.number
        return "🔢" + self.number

@dataclass(frozen=True, slots=True)
class ConceptMatch:
    symbol: str; phrase: str; meaning: str; start: int; end: int; source: str; confidence: float = 1.0
@dataclass(frozen=True, slots=True)
class Relation:
    kind: str; marker: str; phrase: str; position: int
@dataclass(frozen=True, slots=True)
class SemanticClause:
    source: str; concepts: tuple[ConceptMatch,...]; numbers: tuple[NumberBinding,...]; relations: tuple[Relation,...]; negated: bool; unknown_words: tuple[str,...]=()
@dataclass(frozen=True, slots=True)
class SemanticDocument:
    source: str; clauses: tuple[SemanticClause,...]
@dataclass(frozen=True, slots=True)
class Candidate:
    value: str; score: float; reasons: tuple[str,...]=(); coverage: float=0.0; roundtrip: float=0.0
@dataclass(frozen=True, slots=True)
class EngineResult:
    mode: int; source: str; candidates: tuple[Candidate,...]; stages: tuple[str,...]; metrics: dict[str,float|int|str]=field(default_factory=dict)
    @property
    def winner(self) -> str:
        return self.candidates[0].value if self.candidates else ("🟡❓" if self.mode==2 else "Unable to translate the available EL input.")
    def as_dict(self) -> dict:
        return {"mode":self.mode,"winner":self.winner,"candidates":[{"value":c.value,"score":round(c.score,3),"reasons":list(c.reasons),"coverage":round(c.coverage,3),"roundtrip":round(c.roundtrip,3)} for c in self.candidates],"stages":list(self.stages),"metrics":dict(self.metrics)}

