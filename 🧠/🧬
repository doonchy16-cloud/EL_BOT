@lru_cache(maxsize=4096)
def normalize_text(text:str)->str:
    value=unicodedata.normalize("NFKC",str(text or "")).replace("’","'").replace("–","-").replace("—","-")
    return re.sub(r"[ \t]+"," ",value).strip()
@lru_cache(maxsize=4096)
def split_sentences(text:str)->tuple[str,...]:
    value=normalize_text(text); return tuple(p.strip() for p in SENTENCE_RE.split(value) if p.strip()) if value else ()
@lru_cache(maxsize=4096)
def find_number_bindings(text:str)->tuple[NumberBinding,...]:
    return tuple(NumberBinding(m.group("number"),(m.group("unit") or "").lower(),m.start(),m.end()) for m in NUMBER_UNIT_RE.finditer(text))

def _overlaps(a:int,b:int,spans:list[tuple[int,int]])->bool: return any(not(b<=x or a>=y) for x,y in spans)

@lru_cache(maxsize=1)
def canonical_patterns():
    rows=[]
    for phrase,symbol in ALIASES:
        rows.append((re.compile(r"(?<![a-z0-9])"+re.escape(phrase.lower())+r"(?![a-z0-9])"),phrase.lower(),symbol,"alias",1.0))
    for symbol,meaning in MEANING_BY_SYMBOL.items():
        for raw in meaning.split("/"):
            phrase=raw.strip().lower()
            if len(phrase)>=2:
                rows.append((re.compile(r"(?<![a-z0-9])"+re.escape(phrase)+r"(?![a-z0-9])"),phrase,symbol,"authority",0.92))
    rows.sort(key=lambda r:(0 if r[3]=="alias" else 1,-len(r[1]),ORDINAL_BY_SYMBOL[r[2]],r[1]))
    return tuple(rows)

@lru_cache(maxsize=4096)
def match_concepts(text:str)->tuple[ConceptMatch,...]:
    value=normalize_text(text).lower(); raw=[]
    for pattern,phrase,symbol,kind,confidence in canonical_patterns():
        for m in pattern.finditer(value): raw.append((m.start(),m.end(),phrase,symbol,kind,confidence))
    raw.sort(key=lambda r:(r[0],-(r[1]-r[0]),0 if r[4]=="alias" else 1,ORDINAL_BY_SYMBOL[r[3]]))
    accepted=[]; spans=[]
    for start,end,phrase,symbol,kind,confidence in raw:
        same_span=any(start==x and end==y for x,y in spans)
        if _overlaps(start,end,spans) and not same_span: continue
        if any(c.symbol==symbol and c.start==start and c.end==end for c in accepted): continue
        accepted.append(ConceptMatch(symbol,phrase,MEANING_BY_SYMBOL[symbol],start,end,kind,confidence)); spans.append((start,end))
    return tuple(sorted(accepted,key=lambda c:(c.start,c.end,ORDINAL_BY_SYMBOL[c.symbol])))

@lru_cache(maxsize=4096)
def detect_relations(text:str)->tuple[Relation,...]:
    value=normalize_text(text).lower(); raw=[]
    for phrases,kind,marker in RELATION_WORDS:
        for phrase in phrases:
            for m in re.finditer(r"(?<![a-z0-9])"+re.escape(phrase)+r"(?![a-z0-9])",value):
                raw.append((m.start(),m.end(),kind,marker,phrase))
    raw.sort(key=lambda row:(row[0],-(row[1]-row[0]),row[2]))
    accepted=[]; spans=[]
    for start,end,kind,marker,phrase in raw:
        if _overlaps(start,end,spans): continue
        accepted.append(Relation(kind,marker,phrase,start)); spans.append((start,end))
    return tuple(accepted)

def assign_roles(text:str, concepts:tuple[ConceptMatch,...])->tuple[SemanticRole,...]:
    if not concepts: return ()
    ordered=sorted(concepts,key=lambda c:c.start); action_positions=[c.start for c in ordered if is_action(c.symbol)]
    first_action=min(action_positions) if action_positions else None; roles=[]
    for concept in ordered:
        if is_action(concept.symbol): kind="action"
        elif concept.symbol in STATUS_PHRASES: kind="state"
        elif concept.symbol in ENTITY_PHRASES:
            kind="actor" if first_action is not None and concept.start < first_action else "object"
        else: kind="modifier"
        roles.append(SemanticRole(kind,concept.symbol,concept.phrase,concept.start))
    return tuple(roles)

def unknown_content_words(text:str,concepts:tuple[ConceptMatch,...])->tuple[str,...]:
    value=normalize_text(text).lower(); spans=[(c.start,c.end) for c in concepts]; out=[]
    relation_words={word for phrases,_,_ in RELATION_WORDS for phrase in phrases for word in phrase.split()}
    for m in WORD_RE.finditer(value):
        word=m.group(0)
        if word in STOPWORDS or word in relation_words or word.isdigit() or _overlaps(m.start(),m.end(),spans): continue
        if word not in out: out.append(word)
    return tuple(out)

@lru_cache(maxsize=2048)
def parse_abc_document(text:str)->SemanticDocument:
    clauses=[]
    for sentence in split_sentences(text):
        concepts=match_concepts(sentence); relations=detect_relations(sentence)
        clauses.append(SemanticClause(sentence,concepts,find_number_bindings(sentence),relations,any(r.kind=="negation" for r in relations),unknown_content_words(sentence,concepts),assign_roles(sentence,concepts)))
    return SemanticDocument(normalize_text(text),tuple(clauses))

def content_word_count(text:str)->int:
    relation_words={word for phrases,_,_ in RELATION_WORDS for phrase in phrases for word in phrase.split()}
    return sum(1 for m in WORD_RE.finditer(normalize_text(text).lower()) if not m.group(0).isdigit() and m.group(0) not in STOPWORDS and m.group(0) not in relation_words)

def unknown_density(document:SemanticDocument)->float:
    unknown=sum(len(c.unknown_words) for c in document.clauses); total=sum(content_word_count(c.source) for c in document.clauses)
    return unknown/max(1,total)

def unresolved_clause_count(document:SemanticDocument)->int:
    return sum(1 for c in document.clauses if c.unknown_words and not c.concepts)

def canonical_symbols(text:str)->tuple[str,...]: return tuple(g for g in _core.split_graphemes(text) if g in MEANING_BY_SYMBOL)
def valid_el(text:str)->bool:
    if not isinstance(text,str) or not text.strip() or any(ch.isalpha() for ch in text): return False
    parsed=_core.CoreEngine().parse(text,el_mode=True)
    if parsed.status is _core.ValidationStatus.FAIL: return False
    return _vocab.VocabularyEngine().resolve(parsed).status is _core.ValidationStatus.PASS

def dedupe_adjacent(items):
    out=[]
    for item in items:
        if item and (not out or out[-1]!=item): out.append(item)
    return tuple(out)
def concept_signature_from_abc(text:str)->tuple[str,...]: return tuple(c.symbol for c in match_concepts(text))
def concept_signature_from_el(text:str)->tuple[str,...]: return tuple(s for s in canonical_symbols(text) if s not in {"➡️","➕"})
def multiset_similarity(left,right)->float:
    if not left and not right:return 1.0
    if not left or not right:return 0.0
    lc=Counter(left); rc=Counter(right); keys=set(lc)|set(rc)
    over=sum(min(lc.get(k,0),rc.get(k,0)) for k in keys); total=sum(max(lc.get(k,0),rc.get(k,0)) for k in keys)
    return over/total if total else 1.0
def order_similarity(left,right)->float:
    if not left or not right:return 0.0
    positions={}
    for i,s in enumerate(right):positions.setdefault(s,[]).append(i)
    seq=[];used={}
    for s in left:
        slots=positions.get(s);offset=used.get(s,0)
        if slots and offset<len(slots):seq.append(slots[offset]);used[s]=offset+1
    if len(seq)<2:return 1.0 if seq else 0.0
    return sum(1 for a,b in zip(seq,seq[1:]) if b>=a)/(len(seq)-1)
def preferred_phrase(symbol:str)->str:
    if symbol in ENTITY_PHRASES:return ENTITY_PHRASES[symbol]
    if symbol in STATUS_PHRASES:return STATUS_PHRASES[symbol]
    if symbol in ACTION_PHRASES:return ACTION_PHRASES[symbol]
    return MEANING_BY_SYMBOL.get(symbol,"unknown concept").split("/",1)[0].strip()
def is_action(symbol:str)->bool:return symbol in ACTION_PHRASES
def is_status(symbol:str)->bool:return symbol in STATUS_PHRASES
def is_relation(symbol:str)->bool:return symbol in {"➡️","⬅️","↔️","➕","🔀","🚦"}
def sentence_case(text:str)->str:
    value=re.sub(r"\s+"," ",text).strip(" ,;")
    if not value:return ""
    value=value[0].upper()+value[1:]
    return value if value[-1] in ".!?" else value+"."
def score_candidate(source_signature,candidate_signature,base:float=0.0,order_weight:float=22.0):
    coverage=multiset_similarity(source_signature,candidate_signature); order=order_similarity(source_signature,candidate_signature)
    return base+76.0*coverage+order_weight*order,coverage,order
def apply_roundtrip(candidate:Candidate,similarity:float)->Candidate:
    penalty=0.0 if similarity>=0.72 else (18.0 if similarity>=0.45 else 42.0)
    return replace(candidate,score=candidate.score+55.0*similarity-penalty,roundtrip=similarity,reasons=candidate.reasons+("round-trip",f"round-trip:{similarity:.3f}"))
def sort_candidates(candidates):
    unique={}
    for c in candidates:
        if c.value not in unique or c.score>unique[c.value].score:unique[c.value]=c
    return tuple(sorted(unique.values(),key=lambda c:(-c.score,-c.coverage,-c.roundtrip,len(c.value),c.value))[:8])