@dataclass(frozen=True, slots=True)
class NumberBinding:
    number: str; unit: str; start: int; end: int
    @property
    def el(self) -> str:
        if self.unit.lower() in TEMPORAL_UNIT_SYMBOLS: return "⏱️" + self.number
        if self.unit.lower() in {"percent","%"}: return "💯" + self.number
        return "🔢" + self.number

@dataclass(frozen=True, slots=True)
class ConceptMatch:
    symbol: str; phrase: str; meaning: str; start: int; end: int; source: str; confidence: float = 1.0
@dataclass(frozen=True, slots=True)
class Relation:
    kind: str; marker: str; phrase: str; position: int
@dataclass(frozen=True, slots=True)
class SemanticRole:
